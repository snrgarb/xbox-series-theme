<Project DefaultTargets="Build">
  <!--
    The Dashboard theme, packed on its own: Build writes artifacts/XboxSeries_Dashboard_<Version>.pthm, its manifest
    stamped with the theme's own $(Version) below. Release builds pack into artifacts/Release/ instead.
    Not a .NET project, so nothing imports Directory.Build.props for it. The extension builds it for the .pthm it embeds.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />
  <PropertyGroup>
    <!-- The theme's own version; it shares Major.Minor with the extension's (build/components.sh). -->
    <Version>0.4.1</Version>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <ThemeId>XboxSeries_Dashboard</ThemeId>
    <!-- Staged outside the theme's folder, which tests read every XAML file under. -->
    <ThemeStageDir>$(ArtifactsDir)obj\XboxSeries.Dashboard\$(Configuration)\</ThemeStageDir>
    <PackageDir>$(ArtifactsDir)</PackageDir>
    <PackageDir Condition="'$(Configuration)' == 'Release'">$(ArtifactsDir)Release\</PackageDir>
    <ThemePackagePath>$(PackageDir)$(ThemeId)_$(Version).pthm</ThemePackagePath>
  </PropertyGroup>

  <!-- Returns the .pthm, so the extension can embed it. -->
  <Target Name="Build" Returns="$(ThemePackagePath)">
    <ItemGroup>
      <DashboardFile Include="$(MSBuildThisFileDirectory)**\*" Exclude="$(MSBuildThisFileDirectory)theme.yaml;$(MSBuildThisFileFullPath)" />
      <!-- A library source icon's soft shadow, pre-rendered, shared with the extension's Home tiles. -->
      <SharedImage Include="$(RepoRoot)shared\Images\source-*-shadow.png" />
    </ItemGroup>
    <PropertyGroup>
      <ThemeManifest>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)theme.yaml').Replace('{{ThemeId}}', '$(ThemeId)').Replace('{{Version}}', '$(Version)'))</ThemeManifest>
    </PropertyGroup>

    <RemoveDir Directories="$(ThemeStageDir)" />
    <Copy SourceFiles="@(DashboardFile)" DestinationFiles="@(DashboardFile->'$(ThemeStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(SharedImage)" DestinationFolder="$(ThemeStageDir)Images\" />
    <WriteLinesToFile File="$(ThemeStageDir)theme.yaml" Lines="$([MSBuild]::Escape($(ThemeManifest)))" Overwrite="true" />
    <MakeDir Directories="$(PackageDir)" />
    <ZipDirectory SourceDirectory="$(ThemeStageDir)" DestinationFile="$(ThemePackagePath)" Overwrite="true" />

    <Message Importance="high" Text="Dashboard $(Version): $(ThemePackagePath)" />
  </Target>

  <!-- dotnet build restores first; the theme has nothing to restore. -->
  <Target Name="Restore" />
  <Target Name="Clean">
    <RemoveDir Directories="$(ThemeStageDir)" />
  </Target>
</Project>
