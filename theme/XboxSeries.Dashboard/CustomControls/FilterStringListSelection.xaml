<!--
    One filter's list of values, opened from Playnite's filter panel: the panel's full-height dark grey panel at the
    left, Back with the console's back chevron and the filter's name, Clear, then a row for each value.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type FilterStringListSelection}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FilterStringListSelection}">
                    <DockPanel Width="{DynamicResource FilterPanelWidth}"
                               Background="{DynamicResource XboxPanelBrush}"
                               x:Name="PART_MenuHost">
                        <ButtonEx DockPanel.Dock="Top" Margin="12,18,12,6" Padding="20,0,20,0" MinHeight="50"
                                  x:Name="PART_ButtonBack">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" Style="{DynamicResource XboxMenuIcon}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                </StackPanel>
                            </Button.Content>
                        </ButtonEx>

                        <ButtonEx Content="{DynamicResource LOCClearLabel}" DockPanel.Dock="Top"
                                  Margin="12,5,12,5" Padding="20,0,20,0" MinHeight="50"
                                  x:Name="PART_ButtonClear" />

                        <ItemsControlEx x:Name="PART_ItemsHost"
                                        DockPanel.Dock="Top" Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
