        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="100" Height="100">
                            <Path x:Name="Tail" Stroke="{DynamicResource GlyphLightBrush}" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,4" IsClosed="False" IsFilled="False">
                                            <ArcSegment Point="50,4" Size="46,46" SweepDirection="Clockwise" IsLargeArc="False" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path x:Name="Head" Stroke="White" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
