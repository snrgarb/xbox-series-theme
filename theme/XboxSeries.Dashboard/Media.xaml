                                        <PathFigure StartPoint="50,4" IsClosed="False" IsFilled="False">
                                            <ArcSegment Point="54.808,4.252" Size="46,46" SweepDirection="Clockwise" IsLargeArc="False" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
