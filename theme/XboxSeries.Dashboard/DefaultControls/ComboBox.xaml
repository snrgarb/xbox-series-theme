<!--
    Every dropdown in Playnite's Fullscreen windows, as the extension's Guide's Audio Output and Input and its Settings'
    Now Playing source (SettingsControl.xaml's DropBox and DropOption): a box naming the choice, a long one cut short, a
    chevron at its end. Focused, it lightens and the accent ring stands 4 off it carrying the console's green glow as a
    blurred band. Open, focus down in its list, it stays lit, its own edge the accent, and the chevron points up; its list
    opens under it, at least as wide, the chosen one ticked, the focused one lit and ringed. Loaded after Default's
    ComboBox.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="18,0,50,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="4" BorderThickness="2" BorderBrush="#80FFFFFF"
                                Background="{TemplateBinding Background}" />
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <TextBlock FontFamily="{DynamicResource XboxFont}" FontSize="{DynamicResource FontSize}"
                                   Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        </TextBlock>
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{DynamicResource XboxIconFont}" FontSize="16"
                                   Foreground="{DynamicResource XboxTextBrush}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0" />

                        <!--
                            The list, held 24 in from the popup's edges so the focused choice's glow has room in it, the
                            popup moved back by as much, so the list sits 8 under the box and level with it.
                        -->
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               HorizontalOffset="-24" VerticalOffset="-16" Focusable="False" AllowsTransparency="True">
                            <Grid Margin="24" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Border CornerRadius="4" Background="#FF2E2E2E" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Padding="10">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>

                        <Border x:Name="OpenEdge" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource GlyphLightBrush}"
                                Visibility="Hidden">
                            <!-- The band centred on this thinner edge: half its 2 and 8 more out. -->
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlow}" Margin="-6.5" />
                            </Border>
                        </Border>
                        <!-- 4 of gap and 4 of ring out from the box. -->
                        <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="12"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="OpenEdge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice in a dropdown's list, as the extension's DropOption: the chosen one ticked; focused, lit and ringed. -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Padding" Value="52,0,16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource XboxIconFont}" FontSize="20"
                                   Foreground="{DynamicResource XboxTextBrush}" Visibility="Hidden"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0" />
                        <TextBlock FontFamily="{DynamicResource XboxFont}" FontSize="{DynamicResource FontSize}"
                                   Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter />
                        </TextBlock>
                        <!-- 2 of gap and 4 of ring out from the choice, inside the list's 10. -->
                        <Border x:Name="FocusRing" Margin="-6" BorderThickness="4" CornerRadius="10"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default's was based on Default's dropdown as it loaded, so it is made again on this one. -->
    <Style TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBox}}" />
</ResourceDictionary>
