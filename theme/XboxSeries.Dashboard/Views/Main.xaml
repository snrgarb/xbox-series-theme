    <Geometry x:Key="XboxActionCenterSolid">F1M4.81,1.62L21.19,1.62C21.61,1.63 22.02,1.71 22.4,1.89 22.79,2.06 23.12,2.29 23.42,2.58 23.71,2.88 23.94,3.21 24.11,3.6 24.29,3.98 24.37,4.39 24.38,4.81L24.38,17.94C24.37,18.38 24.29,18.79 24.11,19.18 23.93,19.56 23.69,19.9 23.4,20.19 23.1,20.47 22.76,20.7 22.36,20.87 21.97,21.04 21.56,21.12 21.12,21.12L17.75,21.12 13.61,25.73C13.45,25.91 13.25,26 13,26 12.75,26 12.55,25.91 12.39,25.73L8.25,21.12 4.81,21.12C4.39,21.12 3.98,21.04 3.6,20.86 3.21,20.69 2.88,20.46 2.58,20.17 2.29,19.87 2.06,19.54 1.89,19.15 1.71,18.77 1.62,18.36 1.62,17.94L1.62,4.81C1.62,4.39 1.71,3.98 1.89,3.6 2.06,3.21 2.29,2.88 2.58,2.58 2.88,2.29 3.21,2.06 3.6,1.89 3.98,1.71 4.39,1.63 4.81,1.62z</Geometry>
    <Style x:Key="XboxSearchIcon" TargetType="TextBlock" BasedOn="{StaticResource XboxIcon}">
        <Setter Property="Text" Value="&#xE721;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A round top-bar icon: a glowing ring and its label (from Tag) appear under it when focused, without moving its
        neighbours, and the icon grows by a fifth inside the ring, as on the console, without changing its layout size.
    -->
    <Style x:Key="XboxTopBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="10,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- A round Border, not an Ellipse, so the ring can carry the glow band, centred on its 3 px stroke. -->
                        <Border x:Name="Ring" Background="#33FFFFFF" BorderThickness="3" CornerRadius="999"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlowRound}" Margin="-7" />
                            </Border>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <TextBlock x:Name="Label" Style="{StaticResource XboxText}" FontSize="18"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextAlignment="Center" VerticalAlignment="Top"
                                   Margin="-150,70,-150,-40" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--
                            The icon grows a little on focus, unless the extension's Reduce motion is on (Settings >
                            Theme settings > Personalisation); without the extension the binding falls back to off.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=XboxSeries, Path=StartUp.ReduceMotion, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The top bar's profile: the user's picture and name. With the extension, a button that opens the Guide on Profile &
        system, ringed like the round icons when focused, showing the profile signed in (its Tag, the extension's
        Status State, read as Tag.Profile) by its picture and gamertag, taking turns with its real name when it has one; theme-only, or before anyone has signed in, the person glyph and the
        Windows user's name, and never focused theme-only. A picture that won't load leaves the glyph showing. Under the
        gamertag, made smaller for it, the achievement Score as on the console: a white G disc and the Score with thousands
        separators, from Tag.Achievements; with no totals (no PlayniteAchievements, no achievements, or theme-only) there is
        no Score and the gamertag keeps its full size.
    -->
    <Style x:Key="XboxTopBarProfile" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="{DynamicResource GlyphBrush}" />
                            <TextBlock Text="&#xE77B;" Style="{StaticResource XboxIcon}" />
                            <Image Source="{Binding Tag.Profile.Picture, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}"
                                   Width="56" Height="56" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" />
                                </Image.Clip>
                            </Image>
                            <!-- A round Border, not an Ellipse, so the ring can carry the glow band, centred on its 3 px stroke. -->
                            <!-- 4 px off the picture, as Home's tiles' ring. -->
                            <Border x:Name="Ring" Margin="-7" BorderThickness="3" CornerRadius="999"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                <Border Style="{DynamicResource XboxFocusGlowCache}">
                                    <Control Style="{DynamicResource XboxFocusGlowRound}" Margin="-7" />
                                </Border>
                            </Border>
                        </Grid>
                        <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                            <!-- The gamertag and the Score under it show and fade together, taking turns with the real name. -->
                            <StackPanel x:Name="GamertagAndScore" VerticalAlignment="Center">
                                <TextBlock x:Name="Gamertag" Text="{Binding Tag.Profile.Gamertag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Static sys:Environment.UserName}}"
                                           Style="{StaticResource XboxText}" FontSize="19" />
                                <StackPanel x:Name="Score" Orientation="Horizontal">
                                    <Grid Width="19" Height="19" VerticalAlignment="Center">
                                        <Ellipse Fill="White" />
                                        <TextBlock Text="G" FontFamily="{DynamicResource XboxFont}" FontWeight="Bold" FontSize="13" Foreground="Black"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Tag.Achievements.Score, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}, FallbackValue={x:Null}}"
                                               Style="{StaticResource XboxText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="RealName" Text="{Binding Tag.Profile.RealName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}"
                                       Style="{StaticResource XboxText}" VerticalAlignment="Center" Opacity="0" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--
                            No totals, or theme-only where the binding fails to its null fallback: no Score, and the
                            gamertag back to the name's full size.
                        -->
                        <DataTrigger Binding="{Binding Tag.Achievements, RelativeSource={RelativeSource Self}, FallbackValue={x:Null}}" Value="{x:Null}">
                            <Setter TargetName="Score" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Gamertag" Property="FontSize" Value="22" />
                        </DataTrigger>

                        <!--
                            With a real name, the gamertag (with the Score under it) and the real name take turns in the
                            name's place, as on the console, each for 7.2 s, a 0.3 s crossfade to the other. Only while
                            the profile shows, so the swap doesn't keep WPF drawing behind another page, at 30 frames a
                            second, enough for a fade; and not with the extension's Reduce motion on, when the gamertag
                            stays.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tag.Profile.HasRealName, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True" />
                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=XboxSeries, Path=StartUp.ReduceMotion, FallbackValue=False}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="NameSwap">
                                    <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GamertagAndScore" Storyboard.TargetProperty="Opacity" Duration="0:0:15">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:7.2" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:7.5" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:14.7" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:15" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RealName" Storyboard.TargetProperty="Opacity" Duration="0:0:15">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:7.2" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:7.5" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:14.7" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:15" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="NameSwap" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Theme-only layout: collapsed when the extension is installed, which injects its own elements in its place. -->
    <Style x:Key="XboxThemeOnly" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Home only: hidden while the extension's My games & apps, Settings or Search page is up. -->
    <Style x:Key="XboxHomeOnly" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Settings}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Search}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Playnite's main list: Home's tiles theme-only. With the extension it is hidden but stays in the tree, because the
        Game hub shows its selected game, and it comes back as My games & apps' grid, beside the page's nav.
    -->
    <Style x:Key="XboxMainList" TargetType="Grid">
        <Setter Property="Grid.Row" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.ShowsGameGrid, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="3" />
                <!--
                    Games: beside the nav, under the page's header, its tiles flush with Play history's rows (x 524 to 174
                    from the right, as the page is as wide as the screen's aspect ratio makes it): the list from 516.5, the
                    tiles' 7.5 gap each side, and the Grid's 80 more each side is the list's margin. The extension keeps the
                    list five square cells wide and 3.5 of them tall, the panel putting a quarter cell above the first row.
                -->
                <Setter Property="Margin" Value="436.5,-74,86.5,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
            <!--
                Full library: under its filter preset tabs (y 190 to 246) and the extension's Sort and Filter row below them
                (y 262 to 322), from 4 under that row (y 326, so 126 into this row), clipping the list there, as its tiles
                would otherwise draw over the row as they scroll up. The extension lifts the list by the quarter cell the
                panel leaves above the first row, so that row's tiles start 24 under the clip; scrolled tiles fade out
                over the top of that padding, short of the first row's focus ring: XboxFullLibraryFade, over the list.
            -->
            <DataTrigger Binding="{Binding Content.State.ShowsFullLibrary, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Margin" Value="436.5,126,86.5,0" />
                <Setter Property="ClipToBounds" Value="True" />
            </DataTrigger>
            <!-- Never over Settings or Search. -->
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Settings}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Search}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <!-- Y (filter by name), LB/RB (filter presets), RS (filters) and Back (menu) are bound to this by Playnite. -->
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                Hero. Theme-only: the selected game's background art (per the user's background settings) over the
                                default background. With the extension, from XboxSeries_Hero: the focused Recent-row game's art, and the
                                green swirl while no Recent-row tile has focus.
                                Playnite binds the parts' own Visibility, so they are hidden through a wrapper.
                            -->
                            <Grid Grid.RowSpan="2" Style="{StaticResource XboxThemeOnly}">
                                <FadeImage x:Name="PART_ImageBackground"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" />
                            </Grid>
                            <ContentControl x:Name="XboxSeries_Hero" Grid.RowSpan="2" Focusable="False" IsTabStop="False"
                                            Style="{StaticResource XboxHomeOnly}" />
                            <Rectangle Grid.RowSpan="2" Fill="{DynamicResource XboxHeroScrimBrush}" IsHitTestVisible="False" />

                            <!-- With the extension, My games & apps: its nav, header and Play history, over the whole page. -->
                            <ContentControl x:Name="XboxSeries_MyGames" Grid.RowSpan="2" Focusable="False" IsTabStop="False" />

                            <!-- With the extension, Settings: its rail and the category showing, over the whole page. -->
                            <ContentControl x:Name="XboxSeries_Settings" Grid.RowSpan="2" Focusable="False" IsTabStop="False" />

                            <!--
                                Playnite's progress over My games & apps, Settings and Search, which hide the top bar and its
                                own (PART_ElemProgressIndicator): a copy where it sits, bound to what Playnite drives that part
                                from, so Download metadata and the update after a download show on whichever page is up.
                            -->
                            <StackPanel x:Name="XboxPageProgress" Grid.RowSpan="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Height="60" Margin="0,84,105,0"
                                        IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ProgressActive}" Value="True" />
                                                    <Condition Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_MyGames}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ProgressActive}" Value="True" />
                                                    <Condition Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Settings}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ProgressActive}" Value="True" />
                                                    <Condition Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Search}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding ProgressStatus}" Style="{StaticResource XboxText}" FontSize="16"
                                           Foreground="{DynamicResource XboxTextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                Height="26" Width="26" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- With the extension, Search: its box, the console keyboard and the results, over the whole page. -->
                            <ContentControl x:Name="XboxSeries_Search" Grid.RowSpan="2" Focusable="False" IsTabStop="False" />

                            <!--
                                Full library's tabs: the user's own filter presets, as Playnite cycles them with LB/RB and lights the
                                active one (CustomControls/FilterPresetSelector.xaml). Hidden, not collapsed, away from Full
                                library: Playnite fills the tabs only into an applied template, and WPF applies none to a
                                collapsed element.
                            -->
                            <Grid Grid.RowSpan="2" Margin="520,190,170,0" Height="56" VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.State.ShowsFullLibrary, ElementName=XboxSeries_MyGames}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- Top bar: profile on the left, pages in the middle, status on the right. -->
                            <!-- With the extension, Left and Right move between its buttons only, as the console's. -->
                            <!--
                                With the extension, Home is one page that scrolls, and the top bar goes up off the screen with
                                it as focus goes into the Groups: the extension's scroll for it, through the Recent row. Without
                                it the binding finds nothing, and the bar stays where it is.
                            -->
                            <Grid x:Name="XboxTopBar" Grid.Row="0" Margin="105,84,105,0" Height="60" VerticalAlignment="Top"
                                  Style="{StaticResource XboxHomeOnly}"
                                  RenderTransform="{Binding Content.TopBarScroll, ElementName=XboxSeries_RecentRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- With the extension, the profile signed in, and the Guide on Profile & system. -->
                                    <ButtonEx Style="{StaticResource XboxTopBarProfile}"
                                              Command="{Binding Content.OpenProfileCommand, ElementName=XboxSeries_Status}"
                                              Tag="{Binding Content.State, ElementName=XboxSeries_Status}" />

                                    <!-- Install notice: theme-only users, never clickable. -->
                                    <Border Margin="28,0,0,0" Padding="14,6" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource XboxChipBrush}"
                                            BorderBrush="#33FFFFFF" BorderThickness="1"
                                            IsHitTestVisible="False" Focusable="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Install the extension for the full Home"
                                                       Style="{StaticResource XboxText}" FontSize="16" />
                                            <TextBlock Text="Xbox Series extension: github.com/snrgarb/xbox-series-theme"
                                                       Style="{StaticResource XboxText}" FontSize="14"
                                                       Foreground="{DynamicResource XboxTextDimBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- My games & apps exists only with the extension, which opens it on Games. -->
                                    <ButtonEx Tag="My games &amp; apps"
                                              Command="{Binding Content.OpenGamesCommand, ElementName=XboxSeries_MyGames}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxTopBarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <Grid>
                                            <TextBlock Text="&#xE8F1;" Style="{StaticResource XboxOutlineIcon}" />
                                            <Path Data="{StaticResource XboxLibrarySolid}" Style="{StaticResource XboxFilledIcon}" />
                                        </Grid>
                                    </ButtonEx>
                                    <!--
                                        Search, in one place either way. Theme-only, Playnite's name filter of the main list, as Y;
                                        Playnite drives the part's own properties, so it is hidden through a wrapper. With the
                                        extension, its Search page, which gives this button focus back, by its name, as it closes.
                                    -->
                                    <Grid Style="{StaticResource XboxThemeOnly}">
                                        <ButtonEx x:Name="PART_ButtonSearch" Tag="Filter by name" Style="{StaticResource XboxTopBarButton}">
                                            <TextBlock Style="{StaticResource XboxSearchIcon}" />
                                        </ButtonEx>
                                    </Grid>
                                    <ButtonEx x:Name="XboxTopBarSearch" Tag="Search"
                                              Command="{Binding Content.OpenSearchCommand, ElementName=XboxSeries_Search}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxTopBarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <TextBlock Style="{StaticResource XboxSearchIcon}" />
                                    </ButtonEx>
                                    <!--
                                        Settings, in one place either way. Theme-only, Playnite's menu, which holds its settings;
                                        Playnite drives the part's own properties, so it is hidden through a wrapper. With the
                                        extension, its Settings page, whose rail reaches Playnite's settings and menu.
                                    -->
                                    <Grid Style="{StaticResource XboxThemeOnly}">
                                        <ButtonEx x:Name="PART_ButtonMainMenu" Tag="Settings" Style="{StaticResource XboxTopBarButton}">
                                            <TextBlock Style="{StaticResource XboxSettingsIcon}" />
                                        </ButtonEx>
                                    </Grid>
                                    <ButtonEx x:Name="XboxTopBarSettings" Tag="Settings"
                                              Command="{Binding Content.OpenSettingsCommand, ElementName=XboxSeries_Settings}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxTopBarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <TextBlock Style="{StaticResource XboxSettingsIcon}" />
                                    </ButtonEx>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock x:Name="PART_TextProgressTooltip" Style="{StaticResource XboxText}" FontSize="16"
                                                   Foreground="{DynamicResource XboxTextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                        Height="26" Width="26" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ButtonEx x:Name="PART_ButtonProgramUpdate" Tag="Update" Style="{StaticResource XboxTopBarButton}">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource XboxIcon}" Foreground="{DynamicResource GlyphLightBrush}" />
                                    </ButtonEx>

                                    <!--
                                        The status area. Theme-only, Playnite's own: the PC's battery and the clock. With the
                                        extension, its own, as on the console and in the Guide: the controller's battery and the clock.
                                    -->
                                    <ContentControl x:Name="XboxSeries_Status" Focusable="False" IsTabStop="False"
                                                    VerticalAlignment="Center" Margin="10,0,10,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource XboxThemeOnly}">
                                        <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="28"
                                                        VerticalAlignment="Center" Margin="10,0,6,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock x:Name="PART_TextBatteryPercentage" Style="{StaticResource XboxText}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                                        <TextBlock x:Name="PART_TextClock" Style="{StaticResource XboxText}" FontFamily="{DynamicResource XboxFontSemibold}"
                                                   VerticalAlignment="Center" Margin="10,0,10,0" />
                                    </StackPanel>

                                    <ButtonEx x:Name="PART_ButtonNotifications" Tag="Notifications" Style="{StaticResource XboxTopBarButton}">
                                        <Grid>
                                            <TextBlock Text="&#xE91C;" Style="{StaticResource XboxOutlineIcon}" />
                                            <Path Data="{StaticResource XboxActionCenterSolid}" Style="{StaticResource XboxFilledIcon}" />
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource GlyphLightBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </ButtonEx>
                                </StackPanel>
                            </Grid>

                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters"
                                         DockPanel.Dock="Left" Focusable="False" />

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   DockPanel.Dock="Left" Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                                DockPanel.Dock="Left" Focusable="False" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="560" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <!-- What the main list is showing: the active filter preset, or the name filter from Y. -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="105,0,105,8"
                                                Style="{StaticResource XboxThemeOnly}">
                                        <TextBlock Text="{Binding ActiveFilterPreset.Name}" Style="{StaticResource XboxText}"
                                                   FontFamily="{DynamicResource XboxHeaderFontSemibold}" Margin="0,0,24,0" />
                                        <StackPanel x:Name="PART_ElemSearchActive" Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" Style="{StaticResource XboxIcon}" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}" Style="{StaticResource XboxText}" />
                                        </StackPanel>
                                        <TextBlock x:Name="PART_ElemExtraFilterActive" Text="{DynamicResource LOCGameListExtraFiltered}"
                                                   Style="{StaticResource XboxText}" Foreground="{DynamicResource XboxTextDimBrush}"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>

                                    <!-- Playnite's main list as Xbox tiles: Home theme-only, My games & apps' grid with the extension. -->
                                    <Grid Style="{StaticResource XboxMainList}">
                                        <ListBoxEx x:Name="PART_ListGameItems" Margin="80,0,80,0" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                   Background="Transparent" BorderThickness="0"
                                                   KeyboardNavigation.DirectionalNavigation="Once" />

                                        <TextBlock Text="{DynamicResource LOCNoGamesFound}"
                                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxText}">
                                                    <Setter Property="FontSize" Value="32" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!--
                                            Full library: scrolled tiles fade out at the list's clipped top (XboxMainList). Painted
                                            over the list in My games & apps' flat page colour (its PageBrush, #FF1F1F1F), solid at
                                            the clip and clear 12 under it, within the 24 above the first row's tiles, rather than an
                                            OpacityMask on the list, which draws the whole list into a picture of its own, at the 4K
                                            screen's size, every frame it changes. Over the list's own width only, so it doesn't
                                            cover the nav's divider in its margin.
                                        -->
                                        <Rectangle x:Name="XboxFullLibraryFade" Margin="80,0,80,0" Height="12" VerticalAlignment="Top"
                                                   IsHitTestVisible="False">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FF1F1F1F" Offset="0" />
                                                    <GradientStop Color="#001F1F1F" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Content.State.ShowsFullLibrary, ElementName=XboxSeries_MyGames}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>

                                    <!--
                                        With the extension, Home is one page that scrolls, injected: the Recent row and the wide tiles, where
                                        the theme-only list sits, and in the same slot the Groups, laid out to follow them on down the page.
                                        The extension scrolls them, and the top bar, as focus moves. Empty, and so harmless, without it.
                                    -->
                                    <ContentControl x:Name="XboxSeries_RecentRow" Grid.Row="1" Focusable="False" IsTabStop="False"
                                                    Style="{StaticResource XboxHomeOnly}" />
                                    <ContentControl x:Name="XboxSeries_Groups" Grid.Row="1" Focusable="False" IsTabStop="False"
                                                    Style="{StaticResource XboxHomeOnly}" />
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <!--
                            With the extension, the hint bar: More options at the bottom right while what has focus has a menu,
                            over the whole page and the Game hub alike, under the tile menu's dim. Empty without it.
                        -->
                        <ContentControl x:Name="XboxSeries_Hints" Focusable="False" IsTabStop="False" />

                        <!-- With the extension, the tile menu: over the whole page, dimming it, centred. -->
                        <ContentControl x:Name="XboxSeries_TileMenu" Focusable="False" IsTabStop="False" />

                        <GameStatus x:Name="PART_ElemGameStatus"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <!--
                            With the extension, text entry: the Console keyboard docked at the foot, under a caption and its field,
                            over everything else here, the pages, the top bar, the Game hub, the hint bar and the tile menu, dimming
                            them. Last, so nothing draws over it. Empty without it.
                        -->
                        <ContentControl x:Name="XboxSeries_TextEntry" Focusable="False" IsTabStop="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
