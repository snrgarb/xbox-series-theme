<!--
    Home: the Dashboard's landing page, modelled on the Xbox Home screen.
    Works with the theme alone: the top bar, the hero and Playnite's main list styled as Xbox tiles
    (DerivedStyles/ListGameItem*.xaml). With the extension, its hero, Recent row and Groups replace the theme-only
    hero and list, and its tile menu floats over them, injected as custom elements (ContentControls named XboxSeries_<element>). The extension's
    own elements are never referenced by type; the switch is gated by {PluginStatus} on the extension's add-on id.
    The extension's My games & apps page (XboxSeries_MyGames) replaces Home while its State.IsShown is true, with Playnite's
    main list beside its nav while State.ShowsGameGrid is, and the user's filter presets as tabs while State.ShowsFullLibrary
    is; all are read by path, so they are inert without it. Its Settings page (XboxSeries_Settings) replaces Home the same
    way while its State.IsShown is true, and the top bar's Settings button opens it; theme-only, that button is Playnite's
    own, which opens Playnite's main menu. Its Search page (XboxSeries_Search) replaces Home the same way again, and the top
    bar's Search button opens it; theme-only, that button is Playnite's name filter of the main list. The three pages are
    never up together. Its text entry (XboxSeries_TextEntry), the Console keyboard under a caption and its field, comes up
    over all of it, dimming it, wherever the extension asks for text; it is last in the main host so nothing covers it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="XboxText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="XboxIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The Settings icon: the gear, solid while its button has focus, as the console fills a focused icon. Segoe Fluent
        Icons and MDL2 Assets both have the solid gear.
    -->
    <Style x:Key="XboxSettingsIcon" TargetType="TextBlock" BasedOn="{StaticResource XboxIcon}">
        <Setter Property="Text" Value="&#xE713;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Text" Value="&#xF8B0;" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Top-bar glyphs with no solid counterpart in either font. Library and ActionCenter are filled by a shape of their
        own, the glyph's outline at 26 without its holes, shown over the glyph while the button has focus; Search, whose
        filled lens would read as a disc, is drawn bold instead.
    -->
    <Style x:Key="XboxOutlineIcon" TargetType="TextBlock" BasedOn="{StaticResource XboxIcon}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Visibility" Value="Hidden" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="XboxFilledIcon" TargetType="Path">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="Fill" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Hidden" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
