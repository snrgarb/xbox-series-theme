<!-- Loaded after Playnite's Default Constants.xaml: keys it shares override Default's; Xbox* keys are the Dashboard's own. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Xbox accent green -->
    <Color x:Key="GlyphColor">#FF107C10</Color>
    <Color x:Key="GlyphLightColor">#FF2CA243</Color>
    <!-- The brushes too: Default's resolve its own GlyphColor, so overriding the colours alone leaves them orange. -->
    <SolidColorBrush x:Key="GlyphBrush" Color="#FF107C10" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="#FF2CA243" />
    <!--
        The faint green glow the console gives whatever has focus, inside the Border that draws the focus shape (a ring,
        slab or bar), under an XboxFocusGlowCache, so it shows and hides with it. It was a band 11 wide, -7.5 out from a
        4 px ring's inside so centred on the ring, at half opacity and blurred by 17: matched to the console's
        recording, drawn 30% tighter. A blur is redrawn on the CPU, at the 4K screen's size, in every glow's cache when
        Windows sleeps and WPF loses the GPU, hidden glows included, and Playnite froze for minutes on the wake; so the
        blur is drawn instead, with no effect at all. Ten rings, each 12 round at its middle as the band was, nested
        widest first, each faint, so the green builds up in steps of a tenth of the blurred band's peak, each ring's
        edges where the blur crossed halfway between steps; a ring's edge never meets another's, which would leave a
        seam. Inside each corner the blur gathered from both sides, so a soft spot of green makes it up there. Each is
        faint by its brush's opacity, not its own: an element's opacity is drawn apart and laid on, which on the CPU
        took three times as long. So the brushes are the accent's colour, GlyphLightColor, as GlyphLightBrush's
        opacity can't be set; the spot fades to the same green, transparent. Against the blurred band, drawn at the 4K
        screen's 2 pixels to a 1080p one, no pixel is more than 7/255 off, and on the CPU it draws ten times faster.
    -->
    <Style x:Key="XboxFocusGlow" TargetType="Control">
        <Setter Property="Margin" Value="-7.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Grid.Resources>
                            <RadialGradientBrush x:Key="Corner" Opacity="0.075">
                                <GradientStop Color="{StaticResource GlyphLightColor}" Offset="0" />
                                <GradientStop Color="#002CA243" Offset="1" />
                            </RadialGradientBrush>
                        </Grid.Resources>
                        <Border Margin="-10" BorderThickness="31" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.034" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-7.25" BorderThickness="25.5" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.035" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-5.5" BorderThickness="22" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.036" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-4" BorderThickness="19" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.038" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-2.75" BorderThickness="16.5" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.039" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-1.75" BorderThickness="14.5" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.041" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-0.75" BorderThickness="12.5" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.042" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="0.5" BorderThickness="10" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.044" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="1.75" BorderThickness="7.5" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.046" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="3.5" BorderThickness="4" CornerRadius="12">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.048" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5.5,5.5,0,0"
                                Background="{StaticResource Corner}" />
                        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5.5,5.5,0"
                                Background="{StaticResource Corner}" />
                        <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5.5,0,0,5.5"
                                Background="{StaticResource Corner}" />
                        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5.5,5.5"
                                Background="{StaticResource Corner}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        The same glow for a ring drawn right round, at CornerRadius 999 like the ring. Its rings round off as the band
        did, each to its own size; as the band, it is a circle on a square and an ellipse on anything wider. On a
        circle no pixel is more than 5/255 off the blurred band; at an ellipse's points, which the blur gathered into
        from every side, up to 18/255 dimmer.
    -->
    <Style x:Key="XboxFocusGlowRound" TargetType="Control">
        <Setter Property="Margin" Value="-7.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Border Margin="-10" BorderThickness="31" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.034" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-7.25" BorderThickness="25.5" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.035" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-5.5" BorderThickness="22" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.036" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-4" BorderThickness="19" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.038" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-2.75" BorderThickness="16.5" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.039" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-1.75" BorderThickness="14.5" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.041" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="-0.75" BorderThickness="12.5" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.042" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="0.5" BorderThickness="10" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.044" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="1.75" BorderThickness="7.5" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.046" />
                            </Border.BorderBrush>
                        </Border>
                        <Border Margin="3.5" BorderThickness="4" CornerRadius="999">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource GlyphLightColor}" Opacity="0.048" />
                            </Border.BorderBrush>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        The glow's parent, which draws its rings once into a picture, at the 4K screen's 2 pixels to a 1080p one, that is
        then only laid on the screen, as a tile grows on focus or anything round it moves; without it every ring would
        be drawn again each frame. With no blur in it, the picture costs next to nothing to draw again on the CPU when
        the GPU is lost. Whatever shows and hides the glow (the ring, or this parent where there's no ring) does it with
        Hidden, never Collapsed: Hidden only draws it at opacity 0, which the screen skips without throwing the picture
        away, where Collapsed takes it out of layout and draws it again as it comes back. Hidden keeps its place in
        layout, which is nothing here, as the glow and its ring stand out of their element by negative margins; Opacity
        0 would draw the same but leave it to be pointed at.
    -->
    <Style x:Key="XboxFocusGlowCache" TargetType="Border">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="CacheMode">
            <Setter.Value>
                <BitmapCache RenderAtScale="2" SnapsToDevicePixels="True" />
            </Setter.Value>
        </Setter>
    </Style>
    <!--
        A game's art on a tile, as the theme's game tiles show it (My games & apps' grid, the Game hub's cover card):
        filling the tile, cropped to its shape, with no bands, as on the console, in the tile's rounded shape
        (XboxTileArtCornerRadius, which a tile with other corners sets over this one). Content is the art Playnite
        loaded into the tile's PART_ImageCover, its cover, cropped from the top rather than the middle, so a 2:3 cover's
        logo, most often at its top, stays on a square tile. With the extension, the game's Xbox art of the tile's shape
        is drawn over it, in this same style, when it has some (XboxSeries_BoxArt, XboxSeries_Poster). The tile's dark
        grey shows until the art arrives.
    -->
    <CornerRadius x:Key="XboxTileArtCornerRadius">6</CornerRadius>
    <Style x:Key="XboxTileArt" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="{DynamicResource XboxTileArtCornerRadius}" Background="#FF1A1A1A" />
                        <Border CornerRadius="{DynamicResource XboxTileArtCornerRadius}" RenderOptions.BitmapScalingMode="Fant">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Top" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Xbox green (brand #107C10), the Toast's banner, as the console's notifications wear it. The brand's Xbox light
        green, #FF9BF00B, is the alternative to try on the TV against the reference photos.
    -->
    <SolidColorBrush x:Key="XboxGreenBrush" Color="#FF107C10" />

    <!-- Microsoft's UI font and icon font, as on the console. Fluent Icons ships with Windows 11, MDL2 with Windows 10.
         Headers (page titles, headings, nav labels) are in Bahnschrift, which ships with Windows 10 and 11; body text in Segoe UI. -->
    <FontFamily x:Key="XboxFont">Segoe UI</FontFamily>
    <FontFamily x:Key="XboxFontSemibold">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="XboxHeaderFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="XboxHeaderFontSemibold">Bahnschrift SemiBold</FontFamily>
    <FontFamily x:Key="XboxIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="XboxTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="XboxTextDimBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="XboxChipBrush" Color="#CC1A1A1A" />

    <!-- Playnite's (misspelled) main background, also behind Game details: the console's dark background with a green glow. -->
    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.1,1" Center="0.1,1" RadiusX="1.1" RadiusY="1.3">
        <GradientStop Color="#FF0B4A0B" Offset="0" />
        <GradientStop Color="#FF041A04" Offset="0.55" />
        <GradientStop Color="#FF000000" Offset="1" />
    </RadialGradientBrush>

    <!-- Darkens the hero under the top bar and the tiles so they stay readable over any art. -->
    <LinearGradientBrush x:Key="XboxHeroScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#99000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.22" />
        <GradientStop Color="#00000000" Offset="0.4" />
        <GradientStop Color="#D9000000" Offset="1" />
    </LinearGradientBrush>

    <!--
        Playnite's windows: its keyboard, message boxes, item selections, game menu and the rest, drawn as the extension
        draws the console's menus and prompts (MenuPanel.xaml): the screen dimmed as under the tile menu, a dark grey panel
        with softly rounded corners, white text in Segoe UI and the green focus ring with its glow. Their layouts are
        Playnite's; the Views and DefaultControls files restyle what Playnite lets a theme.
    -->
    <!-- The dim Playnite lays over its main window while one of its windows is up: the tile menu's. -->
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
    <!-- The extension's menu panel grey, behind every menu and prompt of Playnite's and its filter panels. -->
    <SolidColorBrush x:Key="XboxPanelBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF2B2B2B" />
    <!-- Default's navy, the panel of Playnite's update, add-on update, random game, licence and crash windows. -->
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="#FF2B2B2B" />
    <!-- A focused or pointed-at row is filled a little lighter, as the extension's menus fill theirs. -->
    <SolidColorBrush x:Key="XboxRowLitBrush" Color="#26FFFFFF" />
    <!--
        The focused row of the console's menus (the game menu's, and those of game clients, software tools and
        extensions' commands): an opaque lighter grey across the panel's full width, inside the green ring.
    -->
    <SolidColorBrush x:Key="XboxRowFocusBrush" Color="#FF404040" />
    <!-- A button standing on its own, as a message box's or a prompt's: the console's grey tile. -->
    <SolidColorBrush x:Key="XboxTileBrush" Color="#FF3B3B3B" />
    <!-- Every text in Playnite's windows is set in this, directly or through its buttons' templates. -->
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
    </Style>

    <!-- A row's icon in Playnite's menus, as the extension's menus draw theirs: a white line glyph in a 24 wide column. -->
    <Style x:Key="XboxMenuIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Margin" Value="0,0,20,0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
    </Style>
    <!-- A menu's or a prompt's title, top left of its panel, in the header font's regular weight. -->
    <Style x:Key="XboxPanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
