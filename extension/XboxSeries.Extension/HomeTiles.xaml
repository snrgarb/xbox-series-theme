<ResourceDictionary x:Class="XboxSeries.Extension.HomeTiles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XboxSeries.Extension"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Home's game tiles, shared by the Recent row and the Groups so that every tile on Home looks the same. -->
    <local:DecodedImageConverter x:Key="Image" />
    <local:TileStatusConverter x:Key="StatusOf" />

    <!-- The size HomeTileArt lays a cover out at: a focused square tile's. A Group's tall cards set their own. -->
    <sys:Double x:Key="HomeTileCoverWidth">245</sys:Double>
    <sys:Double x:Key="HomeTileCoverHeight">245</sys:Double>

    <!--
        Library source icons, as vector paths so they stay sharp however the row is scaled. Path data from
        Simple Icons (CC0, simpleicons.org; Xbox from v9.21.0, the last release to carry it), on a 24x24 box.
    -->
    <Geometry x:Key="SourceSteam">M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z</Geometry>
    <Geometry x:Key="SourceXbox">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>
    <!--
        Each icon's soft shadow, as a DropShadowEffect (radius 6, 0.8 black, no offset) draws it under the icon at 20, made
        once into a picture 36 square (the icon 8 in from each side), 4 pixels to a unit. The Dashboard's library tiles
        show the same pictures, both using shared/Images/source-*-shadow.png.
    -->
    <BitmapImage x:Key="SourceSteamShadow" UriSource="/XboxSeries.Extension;component/source-steam-shadow.png" po:Freeze="True" />
    <BitmapImage x:Key="SourceXboxShadow" UriSource="/XboxSeries.Extension;component/source-xbox-shadow.png" po:Freeze="True" />

    <!-- A Home tile: square, growing in place, ringed in the accent and titled (from Tag) when focused. -->
    <Style x:Key="HomeTile" TargetType="Button">
        <Setter Property="Width" Value="153" />
        <Setter Property="Height" Value="153" />
        <Setter Property="Margin" Value="0,0,30,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="FocusedOn">
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.05" Duration="0:0:0.15" />
                        </Storyboard>
                        <Storyboard x:Key="FocusedOff">
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid>
                        <!-- Rounded corners, as on the console: the art and title are clipped to them. -->
                        <Grid Background="#FF1A1A1A" local:RoundedClip.Radius="6">

                            <ContentPresenter />

                            <!--
                                A game being installed, as on the console: its state, Queued or Installing..., as the caption at
                                the tile's foot. Focused, the title band shows it under the title instead.
                            -->
                            <Border x:Name="StatusBand" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="#E6000000"
                                    Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusOf}, ConverterParameter=Visibility}">
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusOf}}"
                                           Margin="8" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White" />
                            </Border>

                            <!--
                                A solid black band behind the title, as on the console, so it reads over any art. It fills the
                                tile's bottom edge, rounded by the tile's own clip.
                            -->
                            <Border x:Name="TitleBand" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                                    Background="#E6000000">
                                <StackPanel Margin="8">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"
                                               FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White" />
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusOf}}"
                                               Visibility="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StatusOf}, ConverterParameter=Visibility}"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--
                            Outside the clip, standing 4 px off the tile as on the console, its corners following the tile's
                            (6 + 4 + 4). It leaves the next tile 22 px away, clear of it. It carries the console's green glow
                            as a blurred band centred on it, on the ring rather than the growing cover, so the glow traces only
                            the ring.
                        -->
                        <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="14" Margin="-8"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="StatusBand" Property="Opacity" Value="0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusedOn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusedOff}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A game tile's face: its cover (or title, with no cover), library source and Running badge. Content is a HomeTile. -->
    <DataTemplate x:Key="HomeTileArt">
        <Grid>
            <!--
                The cover is laid out once at a focused tile's size, 245, and scaled to the tile, so as the tile grows and
                shrinks the graphics card scales the cover it has rather than the cover being laid out and drawn again
                every frame. It is laid out at the tile's own shape, so this shows the same as the cover filling the tile
                itself: square here, and a Group's tall card sets its own size (HomeTileCoverWidth and Height) over these.
            -->
            <Viewbox Stretch="UniformToFill">
                <Image Width="{DynamicResource HomeTileCoverWidth}" Height="{DynamicResource HomeTileCoverHeight}"
                       Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=300}"
                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
            </Viewbox>
            <TextBlock Text="{Binding Title}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center"
                       TextAlignment="Center" FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White">
                <TextBlock.Style>
                    <!-- Only for games with no cover. -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- The game's library source, bottom left like the console's badges; the title replaces it on focus. -->
            <!--
                Its shadow is a picture made once, under it, 8 out round it, not an effect: an effect on every tile is
                worked out again on the CPU, at the 4K screen's size, whenever WPF loses the graphics card (#95).
                The badge is drawn once into a picture, at the 4K screen's 2 pixels to a 1080p one, which the tile then
                moves as it grows and shrinks. The icon never changes size, so the picture stays good. Shown, hidden and
                faded by the badge.
            -->
            <Border x:Name="SourceBadge" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <Border.CacheMode>
                    <BitmapCache RenderAtScale="2" SnapsToDevicePixels="True" />
                </Border.CacheMode>
                <Grid>
                    <Image x:Name="SourceShadow" Width="36" Height="36" Margin="-8" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Path x:Name="SourceIcon" Width="20" Height="20" Stretch="Uniform" Fill="White" />
                </Grid>
            </Border>
            <!--
                The running game's badge, after the console's Quick Resume one: a play mark on dark grey, with CONTINUE
                beside it while the tile has focus.
            -->
            <Border x:Name="Running" Background="#E62B2B2B" CornerRadius="3" Height="24"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="PlayMark" Background="#F0181818" Width="24" CornerRadius="3">
                        <Path Data="M0,0 L9,5.5 L0,11 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Continue" Text="CONTINUE" Margin="7,0,8,0" Visibility="Collapsed" VerticalAlignment="Center" FontFamily="{DynamicResource XboxFontSemibold}"
                               FontWeight="Bold" FontSize="12" Foreground="White" />
                </StackPanel>
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceSteam}" />
                <Setter TargetName="SourceShadow" Property="Source" Value="{StaticResource SourceSteamShadow}" />
                <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceXbox}" />
                <Setter TargetName="SourceShadow" Property="Source" Value="{StaticResource SourceXboxShadow}" />
                <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter TargetName="SourceBadge" Property="Opacity" Value="0" />
                <Setter TargetName="Continue" Property="Visibility" Value="Visible" />
                <Setter TargetName="PlayMark" Property="CornerRadius" Value="3,0,0,3" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Running" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        A collage of up to 4 games' covers, 2 by 2, for the tiles that open a list of games: Play history and See all.
        Items are HomeTiles. With none, it shows the icon glyph in Tag instead.
    -->
    <Style x:Key="TileCollage" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="2" Columns="2" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=150}"
                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" Margin="3" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Grid>
                        <ItemsPresenter Margin="4" />
                        <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource XboxIconFont}"
                                   FontSize="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
