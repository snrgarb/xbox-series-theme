<controls:PluginUserControl x:Class="XboxSeries.Extension.GroupsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Focusable="False">
    <!--
        Home's Groups: the rest of Home's page, under the Recent row and the wide tiles. One row per Group, its name over
        up to 6 tall game cards and a See all card, as the console's Home rows: Home's tiles, drawn and ringed and titled
        on focus the same, but portrait and never growing. Only the Recent row's tiles grow. The page's scroll
        (HomePage.Scroll, on this control) moves them with the Recent row as focus moves.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>

            <!--
                A Group's card: the console's 285 x 435 portrait shape, sized so that 6 cards and See all, 28 px apart,
                span the Recent row's 1526 px exactly (7 x 194 + 6 x 28), lined up with its left and right edges. The
                cover is laid out at the card's own size (over HomeTiles' square one), as the card never grows.
            -->
            <sys:Double x:Key="HomeTileCoverWidth">194</sys:Double>
            <sys:Double x:Key="HomeTileCoverHeight">296</sys:Double>
            <Style x:Key="GroupCard" TargetType="Button" BasedOn="{StaticResource HomeTile}">
                <Setter Property="Width" Value="{StaticResource HomeTileCoverWidth}" />
                <Setter Property="Height" Value="{StaticResource HomeTileCoverHeight}" />
                <Setter Property="Margin" Value="0,0,28,0" />
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!--
        In the Recent row's slot, stacked as it is and with the same negative bottom margin, so that WPF never clips the
        Groups to the slot as they run on down the page past the screen's foot.
    -->
    <StackPanel Margin="0,0,0,-400">
        <!--
            At the Recent row's fixed 1080p width and scaled the same way, by the width alone, so the two line up at the
            same size, from the same 53 down the slot.
        -->
        <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="105,53,115,0">
            <StackPanel Width="1526">
                <!--
                    Room for the Recent row (245) and the wide tiles (214) over the Groups (RecentRowControl.xaml), so the
                    first Group starts 40 under the wide tiles, as each Group starts 40 under the one before. Empty and
                    without a background, so the rows under it take the pointer.
                -->
                <Border x:Name="AboveGroups" Height="459" />

                <!--
                    On a Canvas, which never cuts its content to its own size: the Groups run on down the page past the
                    screen's foot, and come up into view as it scrolls.
                -->
                <Canvas x:Name="View" Height="0" Margin="0,40,0,0">
                    <ItemsControl x:Name="Rows" ItemsSource="{Binding Groups}" Focusable="False" Width="1526">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,40">
                                    <!-- Bahnschrift SemiLight 36 px on a 16:9 screen, as the console's (HomeTiles.xaml), 16 over the cards. -->
                                    <TextBlock Text="{Binding Name}" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource XboxHeaderFont}" FontWeight="350" FontSize="{DynamicResource HomeGroupHeaderSize}"
                                               Foreground="White" />
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GroupCard}" Tag="{Binding Title}"
                                                            Content="{Binding}" ContentTemplate="{StaticResource HomeTileArt}"
                                                            Click="OnTileClick" GotKeyboardFocus="OnTileFocused"
                                                            LostKeyboardFocus="OnTileLeft" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!--
                                            See all: the whole Group, on My games & apps' Full library with its preset's tab
                                            selected. A card as tall as the games', drawn like Play history's tile: a collage
                                            of the Group's next games after its 6, or the library icon when they all fit.
                                        -->
                                        <Button Style="{StaticResource GroupCard}" Tag="See all" Margin="0"
                                                Click="OnSeeAllClick" KeyDown="OnSeeAllKeyDown">
                                            <ItemsControl Style="{StaticResource TileCollage}" ItemsSource="{Binding SeeAll}" Tag="&#xE8F1;" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </StackPanel>
        </Viewbox>
    </StackPanel>
</controls:PluginUserControl>
