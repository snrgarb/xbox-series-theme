        <!--
            Discord, only while in a call, to the battery's left as the console shows its voice chat: its mark, dimmed, lit green
            while the user speaks, and badged at its bottom right with a struck mic when muted or struck headphones when
            deafened. Out of a call it's collapsed and takes no room.
        -->
        <DataTemplate x:Key="DiscordTemplate">
            <Grid x:Name="Discord" Width="30" Height="24" VerticalAlignment="Center" Visibility="Collapsed">
                <Path x:Name="Mark" Data="{StaticResource DiscordLogo}" Fill="#B3FFFFFF" Width="24" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Left" VerticalAlignment="Center" />
                <Grid x:Name="Badge" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                    <Ellipse Fill="#FF1A1A1A" Stroke="White" StrokeThickness="1" />
                    <!-- Segoe Fluent Icons / MDL2 Assets' microphone or headphones, struck through. -->
                    <TextBlock x:Name="BadgeGlyph" Text="&#xE720;" FontFamily="{DynamicResource XboxIconFont}" FontSize="8"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Line X1="3.5" Y1="3.5" X2="10.5" Y2="10.5" Stroke="White" StrokeThickness="1.25" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInDiscordCall}" Value="True">
                    <Setter TargetName="Discord" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDiscordSpeaking}" Value="True">
                    <Setter TargetName="Mark" Property="Fill" Value="{DynamicResource GlyphLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiscordBadge}" Value="Muted">
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DiscordBadge}" Value="Deafened">
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BadgeGlyph" Property="Text" Value="&#xE7F6;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Home's top bar: Discord in a call, the battery, then the clock, in a row. -->
        <DataTemplate x:Key="RowTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl x:Name="Discord" Content="{Binding}" ContentTemplate="{StaticResource DiscordTemplate}"
                                Focusable="False" Margin="0,0,16,0" VerticalAlignment="Center" />
                <ContentControl x:Name="Battery" Content="{Binding}" ContentTemplate="{StaticResource BatteryTemplate}"
                                Focusable="False" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource XboxHeaderFontSemibold}" FontSize="22" Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Battery.Connection}" Value="None">
                    <Setter TargetName="Battery" Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInDiscordCall}" Value="False">
                    <Setter TargetName="Discord" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            The Guide: Discord in a call and the battery on a line of their own, over the clock large, all to the
            right, as on the console.
        -->
        <DataTemplate x:Key="StackedTemplate">
            <StackPanel HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Height="28" HorizontalAlignment="Right" Margin="0,0,4,0">
                    <ContentControl x:Name="Discord" Content="{Binding}" ContentTemplate="{StaticResource DiscordTemplate}"
                                    Focusable="False" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BatteryTemplate}" Focusable="False"
                                    VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource XboxHeaderFontSemibold}" FontSize="56"
                           Foreground="White" HorizontalAlignment="Right" Margin="0,-2,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInDiscordCall}" Value="False">
                    <Setter TargetName="Discord" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ContentControl Content="{Binding}" Focusable="False">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource RowTemplate}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Stacked, RelativeSource={RelativeSource AncestorType=local:StatusArea}}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource StackedTemplate}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
