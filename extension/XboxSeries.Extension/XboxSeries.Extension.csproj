<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Generic extension: the only project that references the Playnite SDK. It wires real adapters to the core. -->
  <PropertyGroup>
    <!-- The extension's own version; it shares Major.Minor with the theme's (build/components.sh). -->
    <Version>0.2.0</Version>
    <RootNamespace>XboxSeries.Extension</RootNamespace>
    <UseWPF>true</UseWPF>
    <PluginGuid>eb759ff1-325b-4c34-9a64-d9704f72612b</PluginGuid>
    <ExtensionId>XboxSeries_$(PluginGuid)</ExtensionId>
    <DashboardDir>$(RepoRoot)theme\XboxSeries.Dashboard\</DashboardDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Playnite provides Playnite.SDK.dll at runtime, so it is never copied into the package. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <!-- Windows.Gaming.Input, for pad 1's battery over Bluetooth, which XInput doesn't report. Windows provides it at runtime. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework assemblies for Discord: the token endpoint's HttpClient, and DPAPI for the secrets. -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XboxSeries.Core\XboxSeries.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The names of the two events Start-up sets, shared with the Boot shell. -->
    <Compile Include="$(RepoRoot)shared\BootShellEvents.cs" Link="Linked\BootShellEvents.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="extension.yaml" />
    <!-- The QR code of Discord's developer portal, on Settings' Discord, pre-rendered: its address never changes. -->
    <Resource Include="DiscordPortalQr.png" />
    <!-- A library source icon's soft shadow, pre-rendered, shared with the Dashboard's library tiles (SourceBadge). -->
    <Resource Include="$(RepoRoot)shared\Images\source-*-shadow.png" Link="%(Filename)%(Extension)" />
    <AssemblyMetadata Include="PluginGuid" Value="$(PluginGuid)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <!-- The Debug menu's pane, for Debug builds alone. -->
    <Page Remove="DebugPane.xaml" />
    <Compile Remove="DebugPane.xaml.cs" />
  </ItemGroup>
  <!--
    The Windows SDK contracts bring .NET Standard facades into the build, which the XAML compiler needs. They aren't
    copied out: .NET Framework 4.7.2 and later, which Playnite runs on, have them built in.
  -->
  <Target Name="KeepNETStandardFacadesOutOfThePackage" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(FullPath)').Contains('Microsoft.NET.Build.Extensions'))" />
    </ItemGroup>
  </Target>
  <!-- The core's Newtonsoft.Json is the 10.0.3 that Playnite loads itself, so it isn't copied out either. -->
  <Target Name="KeepNewtonsoftOutOfThePackage" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Newtonsoft.Json'" />
    </ItemGroup>
  </Target>
  <Import Project="$(RepoRoot)build\Bundle.targets" />
</Project>
