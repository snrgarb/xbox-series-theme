<ResourceDictionary x:Class="XboxSeries.Extension.AppTiles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XboxSeries.Extension">
    <!-- An App's tile face, shared by My games & apps' Apps and Search's Apps row so that every App looks the same. -->
    <local:DecodedImageConverter x:Key="Image" />

    <!--
        An App, after the console's app tiles and titled as Home's game tiles: its art fills its tile, which rounds its
        corners off, and while the tile is focused a black band fades in over the art's foot holding its name in white.
        A Microsoft Store app's icon is its package's tile art, so it fills the art edge to edge over the accent, as the
        console's do. Any other App's icon sits inset on white, a soft shadow behind it. With no icon, or one that can't be
        read, a generic app glyph in its place, as large: dark grey on white, white on the accent.
        The icon is decoded at twice the widest a tile gets, for the 4K screen's 2 pixels to a 1080p one, and no larger.
    -->
    <DataTemplate x:Key="AppTileArt">
        <Grid>
            <Grid x:Name="Art" Background="White">
                <!--
                    The shadow is an ImageShadow, the icon's own shape made once into a picture, not an effect, which is
                    worked out again on the CPU, at the 4K screen's size, whenever WPF loses the graphics card (#95). The
                    two are drawn once into a picture, at the 4K screen's 2 pixels to a 1080p one, rather than again every
                    frame the tile is redrawn.
                -->
                <Border x:Name="Shadowed" Margin="18">
                    <Border.CacheMode>
                        <BitmapCache RenderAtScale="2" SnapsToDevicePixels="True" />
                    </Border.CacheMode>
                    <Grid>
                        <local:ImageShadow x:Name="IconShadow" Source="{Binding Source, ElementName=Icon}"
                                           BlurRadius="18" ShadowDepth="3" ShadowOpacity="0.3" />
                        <Image x:Name="Icon"
                               Source="{Binding Icon, Converter={StaticResource Image}, ConverterParameter=480}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                    </Grid>
                </Border>
                <Viewbox x:Name="NoIcon" Margin="18" Visibility="Collapsed">
                    <TextBlock x:Name="NoIconGlyph" Text="&#xECAA;" FontFamily="{DynamicResource XboxIconFont}" Foreground="#FF333333" />
                </Viewbox>
            </Grid>

            <!-- As Home's game tiles: the name on up to two lines over a near-black band, so it reads over any art. -->
            <Border x:Name="TitleBand" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" Background="#E6000000">
                <TextBlock Text="{Binding Name}" Margin="8" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"
                           FontFamily="{DynamicResource XboxFont}" FontSize="26" Foreground="White" />
            </Border>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsStoreApp}" Value="True">
                <Setter TargetName="Art" Property="Background" Value="{DynamicResource GlyphBrush}" />
                <Setter TargetName="Shadowed" Property="Margin" Value="0" />
                <Setter TargetName="Shadowed" Property="CacheMode" Value="{x:Null}" />
                <Setter TargetName="IconShadow" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NoIconGlyph" Property="Foreground" Value="White" />
            </DataTrigger>
            <!-- The band fades in and out with the tile's focus, at Home's game tiles' pace. -->
            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.05" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                <Setter TargetName="Shadowed" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
