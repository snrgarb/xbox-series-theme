<!--
    Every slider in Playnite's Fullscreen windows (its settings' blur, darkening, sizes and volumes), as the console's: a
    thin white track, the accent up to a round white knob. Focused, the slider's box lightens and the accent ring stands 2
    off it carrying the console's green glow as a blurred band. Left and Right move it, as Playnite's own. Loaded after
    Default's Slider.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="XboxSliderTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="XboxSliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse Width="22" Height="22" Fill="{DynamicResource XboxTextBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Border Height="4" CornerRadius="2" Background="#66FFFFFF" VerticalAlignment="Center" />
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{DynamicResource GlyphLightBrush}"
                                    Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="22" Height="22" Style="{StaticResource XboxSliderThumb}" />
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="ButtonDecrease" Style="{StaticResource XboxSliderTrackButton}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource XboxSliderTrackButton}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <!-- 2 of gap and 4 of ring out from the box. -->
                        <Border x:Name="FocusRing" Margin="-6" BorderThickness="4" CornerRadius="10"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Control Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default's was based on Default's slider as it loaded, so it is made again on this one. -->
    <Style TargetType="SliderEx" BasedOn="{StaticResource {x:Type Slider}}" />
</ResourceDictionary>
