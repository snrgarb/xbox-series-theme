<!--
    Every toggle button in Playnite's Fullscreen windows, as the extension's buttons in Settings: a dark block, filled with
    the accent while on. Focused, it lightens and the accent ring stands 4 off it carrying the console's green glow as a
    blurred band. Loaded after Default's ToggleButton.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="Background" Value="#FF333333" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="24,10,24,10" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <TextBlock FontFamily="{DynamicResource XboxFont}" FontSize="{DynamicResource FontSize}"
                                   Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Margin="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </TextBlock>
                        <!-- 4 of gap and 4 of ring out from the block, as Home's tiles. -->
                        <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="10"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Border Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#FF404040" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#FF4A4A4A" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default's was based on Default's toggle button as it loaded, so it is made again on this one. -->
    <Style TargetType="ToggleButtonEx" BasedOn="{StaticResource {x:Type ToggleButton}}" />
</ResourceDictionary>
