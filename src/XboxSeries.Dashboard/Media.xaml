                                    <PathGeometry>
                                        <PathFigure StartPoint="50,0.867" IsClosed="False" IsFilled="False">
                                            <ArcSegment Point="55.136,1.136" Size="49.134,49.134" SweepDirection="Clockwise" IsLargeArc="False" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Canvas>
