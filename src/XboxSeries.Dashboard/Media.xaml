        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="100" Height="100">
                            <Path x:Name="Tail" Stroke="{DynamicResource GlyphLightBrush}" StrokeThickness="1.733"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="50,0.867" IsClosed="False" IsFilled="False">
                                            <ArcSegment Point="50,0.867" Size="49.134,49.134" SweepDirection="Clockwise" IsLargeArc="False" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path x:Name="Head" Stroke="White" StrokeThickness="1.733"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
