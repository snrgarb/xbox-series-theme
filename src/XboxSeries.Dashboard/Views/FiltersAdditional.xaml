<!--
    The filter panel's further filters, opened from its last row: the filter panel's full-height dark grey panel at the
    left, Back to Filters first, with the console's back chevron, then Playnite's rows of filters.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type FiltersAdditional}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type FiltersAdditional}">
                    <DockPanel Background="{DynamicResource XboxPanelBrush}"
                               Width="{DynamicResource FilterPanelWidth}"
                               x:Name="PART_MenuHost">
                        <ButtonEx DockPanel.Dock="Top" Margin="12,18,12,6" Padding="20,0,20,0" MinHeight="50"
                                  x:Name="PART_ButtonBack">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE76B;" Style="{StaticResource XboxMenuIcon}" />
                                    <TextBlock Text="{DynamicResource LOCFilters}" VerticalAlignment="Center"
                                               Style="{DynamicResource TextBlockBaseStyle}" />
                                </StackPanel>
                            </Button.Content>
                        </ButtonEx>
                        <ItemsControlEx x:Name="PART_ItemsHost"
                                        DockPanel.Dock="Top" Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
