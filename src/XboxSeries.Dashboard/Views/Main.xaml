<!--
    Home: the Dashboard's landing page, modelled on the Xbox Home screen.
    Works with the theme alone: the top bar, the hero and Playnite's main list styled as Xbox tiles
    (DerivedStyles/ListGameItem*.xaml). With the extension, its hero, Recent row and Groups replace the theme-only
    hero and list, and its tile menu floats over them, injected as custom elements (ContentControls named XboxSeries_<element>). The extension's
    own elements are never referenced by type; the switch is gated by {PluginStatus} on the extension's add-on id.
    The extension's My games & apps page (XboxSeries_MyGames) replaces Home while its State.IsShown is true, with Playnite's
    main list beside its nav while State.ShowsGameGrid is, and the user's filter presets as tabs while State.ShowsFullLibrary
    is; all are read by path, so they are inert without it. Its Settings page (XboxSeries_Settings) replaces Home the same
    way while its State.IsShown is true, and the top bar's Settings button opens it; theme-only, that button is Playnite's
    own, which opens Playnite's main menu.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <Style x:Key="XboxText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="XboxIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        The Settings icon: the gear, solid while its button has focus, as the console fills a focused icon. Segoe Fluent
        Icons and MDL2 Assets both have the solid gear; the theme's other top-bar glyphs (Library, Search, Download,
        ActionCenter) have no solid counterpart in either font, so they keep their outline.
    -->
    <Style x:Key="XboxSettingsIcon" TargetType="TextBlock" BasedOn="{StaticResource XboxIcon}">
        <Setter Property="Text" Value="&#xE713;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Text" Value="&#xF8B0;" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        A round top-bar icon: a glowing ring and its label (from Tag) appear under it when focused, without moving its
        neighbours, and the icon grows by a fifth inside the ring, as on the console, without changing its layout size.
    -->
    <Style x:Key="XboxTopBarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Margin" Value="10,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <!-- A round Border, not an Ellipse, so the ring can carry the glow band, centred on its 3 px stroke. -->
                        <Border x:Name="Ring" Background="#33FFFFFF" BorderThickness="3" CornerRadius="999"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed">
                            <Border Style="{DynamicResource XboxFocusGlow}" CornerRadius="999" Margin="-9.5" />
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                        <TextBlock x:Name="Label" Style="{StaticResource XboxText}" FontSize="18"
                                   Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextAlignment="Center" VerticalAlignment="Top"
                                   Margin="-150,70,-150,-40" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.2" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="IconScale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The top bar's profile: the user's picture and name. With the extension, a button that opens the Guide on Profile &
        system, ringed like the round icons when focused, showing the profile signed in (its Tag, the extension's
        State.Profile) by its picture and gamertag, taking turns with its real name when it has one; theme-only, or before anyone has signed in, the person glyph and the
        Windows user's name, and never focused theme-only. A picture that won't load leaves the glyph showing.
    -->
    <Style x:Key="XboxTopBarProfile" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="{DynamicResource GlyphBrush}" />
                            <TextBlock Text="&#xE77B;" Style="{StaticResource XboxIcon}" />
                            <Image Source="{Binding Tag.Picture, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}"
                                   Width="56" Height="56" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" />
                                </Image.Clip>
                            </Image>
                            <!-- A round Border, not an Ellipse, so the ring can carry the glow band, centred on its 3 px stroke. -->
                            <Border x:Name="Ring" Margin="-4" BorderThickness="3" CornerRadius="999"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed">
                                <Border Style="{DynamicResource XboxFocusGlow}" CornerRadius="999" Margin="-9.5" />
                            </Border>
                        </Grid>
                        <Grid VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock x:Name="Gamertag" Text="{Binding Tag.Gamertag, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Static sys:Environment.UserName}}"
                                       Style="{StaticResource XboxText}" />
                            <TextBlock x:Name="RealName" Text="{Binding Tag.RealName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue={x:Null}}"
                                       Style="{StaticResource XboxText}" Opacity="0" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--
                            With a real name, the gamertag and the real name take turns in the name's place, as on the
                            console, crossfading on the Toast's text cycle: each for 2.2 s, a 0.3 s crossfade to the other.
                        -->
                        <DataTrigger Binding="{Binding Tag.HasRealName, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="NameSwap">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Gamertag" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RealName" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1" />
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="1" />
                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="NameSwap" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="IsHitTestVisible" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Theme-only layout: collapsed when the extension is installed, which injects its own elements in its place. -->
    <Style x:Key="XboxThemeOnly" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Home only: hidden while the extension's My games & apps or Settings page is up. -->
    <Style x:Key="XboxHomeOnly" TargetType="FrameworkElement">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Settings}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Playnite's main list: Home's tiles theme-only. With the extension it is hidden but stays in the tree, because the
        Game hub shows its selected game, and it comes back as My games & apps' grid, beside the page's nav.
    -->
    <Style x:Key="XboxMainList" TargetType="Grid">
        <Setter Property="Grid.Row" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Content.State.ShowsGameGrid, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Grid.RowSpan" Value="3" />
                <!--
                    Games: beside the nav, under the page's header, its tiles flush with Play history's rows (x 524 to 174
                    from the right, as the page is as wide as the screen's aspect ratio makes it): the list from 516, the
                    tiles' 8 gap each side, and the Grid's 80 more each side is the list's margin. The extension keeps the
                    list five square cells wide and 3.5 of them tall, the panel putting a quarter cell above the first row.
                -->
                <Setter Property="Margin" Value="436,-74,86,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </DataTrigger>
            <!--
                Full library: under its filter preset tabs, from their bottom (y 246, so 46 into this row), as the list clips
                its tiles to its own top as they scroll up and would otherwise draw over the tabs. Scrolled tiles fade out
                over the quarter cell the panel leaves above the first row (0.25 of the list's 3.5 cells), short of the
                first row's focus ring, so they don't butt against the tabs.
            -->
            <DataTrigger Binding="{Binding Content.State.ShowsFullLibrary, ElementName=XboxSeries_MyGames}" Value="True">
                <Setter Property="Margin" Value="436,46,86,0" />
                <Setter Property="OpacityMask">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0.01" />
                            <GradientStop Color="Black" Offset="0.06" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <!-- Never over Settings. -->
            <DataTrigger Binding="{Binding Content.State.IsShown, ElementName=XboxSeries_Settings}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <!-- Y (filter by name), LB/RB (filter presets), RS (filters) and Back (menu) are bound to this by Playnite. -->
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource MainBackgourndBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                Hero. Theme-only: the selected game's background art (per the user's background settings) over the
                                default background. With the extension, from XboxSeries_Hero: the focused Recent-row game's art, and the
                                green swirl while no Recent-row tile has focus.
                                Playnite binds the parts' own Visibility, so they are hidden through a wrapper.
                            -->
                            <Grid Grid.RowSpan="2" Style="{StaticResource XboxThemeOnly}">
                                <FadeImage x:Name="PART_ImageBackground"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" />
                            </Grid>
                            <ContentControl x:Name="XboxSeries_Hero" Grid.RowSpan="2" Focusable="False" IsTabStop="False"
                                            Style="{StaticResource XboxHomeOnly}" />
                            <Rectangle Grid.RowSpan="2" Fill="{DynamicResource XboxHeroScrimBrush}" IsHitTestVisible="False" />

                            <!-- With the extension, My games & apps: its nav, header and Play history, over the whole page. -->
                            <ContentControl x:Name="XboxSeries_MyGames" Grid.RowSpan="2" Focusable="False" IsTabStop="False" />

                            <!-- With the extension, Settings: its rail and the category showing, over the whole page. -->
                            <ContentControl x:Name="XboxSeries_Settings" Grid.RowSpan="2" Focusable="False" IsTabStop="False" />

                            <!--
                                Full library's tabs: the user's own filter presets, as Playnite cycles them with LB/RB and lights the
                                active one (CustomControls/FilterPresetSelector.xaml). Hidden, not collapsed, away from Full
                                library: Playnite fills the tabs only into an applied template, and WPF applies none to a
                                collapsed element.
                            -->
                            <Grid Grid.RowSpan="2" Margin="520,190,170,0" Height="56" VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Hidden" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Content.State.ShowsFullLibrary, ElementName=XboxSeries_MyGames}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" HorizontalAlignment="Left" />
                            </Grid>

                            <!-- Top bar: profile on the left, pages in the middle, status on the right. -->
                            <!-- With the extension, Left and Right move between its buttons only, as the console's. -->
                            <Grid x:Name="XboxTopBar" Grid.Row="0" Margin="105,84,105,0" Height="60" VerticalAlignment="Top"
                                  Style="{StaticResource XboxHomeOnly}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- With the extension, the profile signed in, and the Guide on Profile & system. -->
                                    <ButtonEx Style="{StaticResource XboxTopBarProfile}"
                                              Command="{Binding Content.OpenProfileCommand, ElementName=XboxSeries_Status}"
                                              Tag="{Binding Content.State.Profile, ElementName=XboxSeries_Status}" />

                                    <!-- Install notice: theme-only users, never clickable. -->
                                    <Border Margin="28,0,0,0" Padding="14,6" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{DynamicResource XboxChipBrush}"
                                            BorderBrush="#33FFFFFF" BorderThickness="1"
                                            IsHitTestVisible="False" Focusable="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="Install the extension for the full Home"
                                                       Style="{StaticResource XboxText}" FontSize="16" />
                                            <TextBlock Text="Xbox Series extension: github.com/snrgarb/xbox-series-theme"
                                                       Style="{StaticResource XboxText}" FontSize="14"
                                                       Foreground="{DynamicResource XboxTextDimBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- My games & apps exists only with the extension, which opens it on Games. -->
                                    <ButtonEx Tag="My games &amp; apps"
                                              Command="{Binding Content.OpenGamesCommand, ElementName=XboxSeries_MyGames}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxTopBarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <TextBlock Text="&#xE8F1;" Style="{StaticResource XboxIcon}" />
                                    </ButtonEx>
                                    <!-- Playnite's name filter of the main list, as Y. Search proper is the extension's page. -->
                                    <ButtonEx x:Name="PART_ButtonSearch" Tag="Filter by name" Style="{StaticResource XboxTopBarButton}">
                                        <TextBlock Text="&#xE721;" Style="{StaticResource XboxIcon}" />
                                    </ButtonEx>
                                    <!--
                                        Settings, in one place either way. Theme-only, Playnite's menu, which holds its settings;
                                        Playnite drives the part's own properties, so it is hidden through a wrapper. With the
                                        extension, its Settings page, whose rail reaches Playnite's settings and menu.
                                    -->
                                    <Grid Style="{StaticResource XboxThemeOnly}">
                                        <ButtonEx x:Name="PART_ButtonMainMenu" Tag="Settings" Style="{StaticResource XboxTopBarButton}">
                                            <TextBlock Style="{StaticResource XboxSettingsIcon}" />
                                        </ButtonEx>
                                    </Grid>
                                    <ButtonEx x:Name="XboxTopBarSettings" Tag="Settings"
                                              Command="{Binding Content.OpenSettingsCommand, ElementName=XboxSeries_Settings}">
                                        <ButtonEx.Style>
                                            <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxTopBarButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ButtonEx.Style>
                                        <TextBlock Style="{StaticResource XboxSettingsIcon}" />
                                    </ButtonEx>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock x:Name="PART_TextProgressTooltip" Style="{StaticResource XboxText}" FontSize="16"
                                                   Foreground="{DynamicResource XboxTextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False"
                                                        Height="26" Width="26" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ButtonEx x:Name="PART_ButtonProgramUpdate" Tag="Update" Style="{StaticResource XboxTopBarButton}">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource XboxIcon}" Foreground="{DynamicResource GlyphLightBrush}" />
                                    </ButtonEx>

                                    <!--
                                        The status area. Theme-only, Playnite's own: the PC's battery and the clock. With the
                                        extension, its own, as on the console and in the Guide: the controller's battery and the clock.
                                    -->
                                    <ContentControl x:Name="XboxSeries_Status" Focusable="False" IsTabStop="False"
                                                    VerticalAlignment="Center" Margin="10,0,10,0" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{StaticResource XboxThemeOnly}">
                                        <ContentControl x:Name="PART_ElemBatteryStatus" Focusable="False" FontSize="28"
                                                        VerticalAlignment="Center" Margin="10,0,6,0">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Critical">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusCritical}" />
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Low">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusLow}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="Medium">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusMedium}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.Charge}" Value="High">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusHigh}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PowerStatus.IsCharging}" Value="True">
                                                            <Setter Property="Content" Value="{DynamicResource BatteryStatusCharging}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock x:Name="PART_TextBatteryPercentage" Style="{StaticResource XboxText}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />

                                        <TextBlock x:Name="PART_TextClock" Style="{StaticResource XboxText}" FontFamily="{DynamicResource XboxFontSemibold}"
                                                   VerticalAlignment="Center" Margin="10,0,10,0" />
                                    </StackPanel>

                                    <ButtonEx x:Name="PART_ButtonNotifications" Tag="Notifications" Style="{StaticResource XboxTopBarButton}">
                                        <Grid>
                                            <TextBlock Text="&#xE91C;" Style="{StaticResource XboxIcon}" />
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource GlyphLightBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </ButtonEx>
                                </StackPanel>
                            </Grid>

                            <DockPanel Grid.Row="1">
                                <Filters x:Name="PART_ElemFilters"
                                         DockPanel.Dock="Left" Focusable="False" />

                                <FiltersAdditional x:Name="PART_ElemFiltersAdditional"
                                                   DockPanel.Dock="Left" Focusable="False" />

                                <ContentControl x:Name="PART_ContentFilterItems"
                                                DockPanel.Dock="Left" Focusable="False" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="560" />
                                        <RowDefinition Height="40" />
                                    </Grid.RowDefinitions>

                                    <!-- What the main list is showing: the active filter preset, or the name filter from Y. -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="105,0,105,8"
                                                Style="{StaticResource XboxThemeOnly}">
                                        <TextBlock Text="{Binding ActiveFilterPreset.Name}" Style="{StaticResource XboxText}"
                                                   FontFamily="{DynamicResource XboxFontSemibold}" Margin="0,0,24,0" />
                                        <StackPanel x:Name="PART_ElemSearchActive" Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" Style="{StaticResource XboxIcon}" FontSize="18" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}" Style="{StaticResource XboxText}" />
                                        </StackPanel>
                                        <TextBlock x:Name="PART_ElemExtraFilterActive" Text="{DynamicResource LOCGameListExtraFiltered}"
                                                   Style="{StaticResource XboxText}" Foreground="{DynamicResource XboxTextDimBrush}"
                                                   Margin="24,0,0,0" />
                                    </StackPanel>

                                    <!-- Playnite's main list as Xbox tiles: Home theme-only, My games & apps' grid with the extension. -->
                                    <Grid Style="{StaticResource XboxMainList}">
                                        <ListBoxEx x:Name="PART_ListGameItems" Margin="80,0,80,0" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                   Background="Transparent" BorderThickness="0"
                                                   KeyboardNavigation.DirectionalNavigation="Once" />

                                        <TextBlock Text="{DynamicResource LOCNoGamesFound}"
                                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxText}">
                                                    <Setter Property="FontSize" Value="32" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!--
                                        With the extension, Home has two screens, injected: the Recent row, where the theme-only list sits, and the
                                        Groups below it, over the whole page under the top bar. Only one shows at a time; the extension flies one
                                        out and the other in as focus moves between them. Empty, and so harmless, without it.
                                    -->
                                    <ContentControl x:Name="XboxSeries_RecentRow" Grid.Row="1" Focusable="False" IsTabStop="False"
                                                    Style="{StaticResource XboxHomeOnly}" />
                                    <ContentControl x:Name="XboxSeries_Groups" Grid.RowSpan="3" Focusable="False" IsTabStop="False"
                                                    Style="{StaticResource XboxHomeOnly}" />
                                </Grid>
                            </DockPanel>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                        <!-- With the extension, the tile menu: over the whole page, dimming it, centred. -->
                        <ContentControl x:Name="XboxSeries_TileMenu" Focusable="False" IsTabStop="False" />

                        <GameStatus x:Name="PART_ElemGameStatus"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
