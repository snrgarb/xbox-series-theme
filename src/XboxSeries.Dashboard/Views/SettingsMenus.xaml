<!--
    Playnite settings: Playnite's own Fullscreen Settings window, restyled as the console's Settings and as the extension's
    Settings page draws it (SettingsControl.xaml), whose rail reaches it: one flat background, the left rail and a divider,
    and the category showing beside it. Loaded after Default's SettingsMenus.xaml, so only the keys below are changed.

    Playnite's window is a fixed grid in a Viewbox (Windows/SettingsWindow.xaml), 1080 tall and as wide as the screen's
    aspect (WindowTools sets it to the viewport's width, W): columns 2*, 3*, 400 and 100, so its menu is at x W-500 to
    W-100 and the category at x 0.4(W-500) to W-500, y 150 to 930, both only Borders taking these styles, their columns
    and rows set on them. So each Border is spanned to the grid's right edge, given room to its left by a negative margin,
    and sized from the grid's width, right-aligned: the menu's over the whole window, wearing the page's colour and the
    divider, its rail the first 441; the category's from 77 past the divider. The header template, the rail's first
    child, carries what Playnite has no place for, laid out from the rail's top left by a Canvas that takes no room: the
    empty-state header (gear, title, profile) beside the rail while no category is open, and theme-only, the install notice.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        The menu: from its column to the grid's right edge, the room to its left up to 5000 wide, and the grid's width,
        so it covers the window: the page's flat colour, with the 2 wide divider at x 441. Its rail, Playnite's StackPanel,
        is held to the first 441 by an implicit style only it takes (the header template's panels have styles of their own).
    -->
    <Style x:Key="SettingsMenuBorder" TargetType="Border">
        <Style.Resources>
            <Style TargetType="StackPanel">
                <Setter Property="Width" Value="441" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Style.Resources>
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="-5000,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" />
        <Setter Property="Background">
            <Setter.Value>
                <!-- In the Border's own space, from its left edge: the page, the divider from 441 to 443, then the page. -->
                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="1000,0">
                    <GradientStop Color="#FF1F1F1F" Offset="0" />
                    <GradientStop Color="#FF1F1F1F" Offset="0.441" />
                    <GradientStop Color="#FF303030" Offset="0.441" />
                    <GradientStop Color="#FF303030" Offset="0.443" />
                    <GradientStop Color="#FF1F1F1F" Offset="0.443" />
                    <GradientStop Color="#FF1F1F1F" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The category showing: from its column to the grid's right edge, 150 short of it, and from x 500, so its options
        (inside Playnite's own 20) start 77 right of the divider and end 170 from the edge, as the extension's; from y 170
        to 1040, its first level with the rail's first item.
    -->
    <Style x:Key="SettingsSectionBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Setter Property="Grid.RowSpan" Value="2" />
        <Setter Property="Margin" Value="-5000,20,150,40" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource MathConverter}, ConverterParameter=x-650}" />
    </Style>

    <!--
        A rail item, as the extension's Settings rail: edge to edge across the rail, the name 75 in. Focused, it fills with
        the accent and carries the console's green glow as a blurred band; the fill is a Border of its own behind the name,
        carrying the band, so the glow traces only it. Its template is its own, so the Dashboard's buttons elsewhere don't
        reach it. While a category is open Playnite disables the whole rail; it keeps its look, unlit.
    -->
    <Style x:Key="SettingsMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid Background="Transparent">
                        <Border x:Name="Back">
                            <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                <Border Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                        <ContentPresenter Margin="75,0,43,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#FF262626" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail's names, as the extension's Settings rail: headers, semilight. -->
    <Style x:Key="XboxSettingsRailText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="350" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="XboxSettingsText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- A row of the empty-state header: a style of its own, so the rail's implicit one doesn't hold it to 441. -->
    <Style x:Key="XboxSettingsRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!--
        The rail's head: Settings' name, as the extension's rail has it (78 down, the items starting at 190). Laid out from
        the rail's top left by a Canvas taking no room: beside the rail while no category is open, the empty-state header
        where a category's name sits on the extension's page, the gear, the title and the profile; and theme-only, the
        line naming the extension, at the foot of the page.
    -->
    <DataTemplate x:Key="SettingsMenuHeaderTemplate">
        <Grid>
            <TextBlock Text="{DynamicResource LOCSettingsLabel}" Style="{StaticResource XboxSettingsRailText}"
                       FontSize="30" FontWeight="Normal" Height="54" Margin="75,78,0,58" VerticalAlignment="Top" />
            <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel x:Name="XboxSettingsEmptyHeader" Canvas.Left="520" Canvas.Top="72">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsSubMenuOpened, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Style="{StaticResource XboxSettingsRow}" Height="118">
                        <TextBlock Text="&#xE713;" FontFamily="{DynamicResource XboxIconFont}" FontSize="40"
                                   Foreground="{DynamicResource XboxTextBrush}" VerticalAlignment="Top" Margin="0,6,22,0" />
                        <!-- Semilight, as the extension's category headings. -->
                        <TextBlock Text="{DynamicResource LOCSettingsLabel}" Style="{StaticResource XboxSettingsText}"
                                   FontFamily="{DynamicResource XboxHeaderFont}" FontSize="42" FontWeight="350" VerticalAlignment="Top" />
                    </StackPanel>
                    <!-- The profile: theme-only there is none but the Windows user, as Home's top bar shows it. -->
                    <StackPanel Style="{StaticResource XboxSettingsRow}">
                        <Grid Width="56" Height="56">
                            <Ellipse Fill="{DynamicResource GlyphBrush}" />
                            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource XboxIconFont}" FontSize="24"
                                       Foreground="{DynamicResource XboxTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{x:Static sys:Environment.UserName}" Style="{StaticResource XboxSettingsText}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Choose a category to change Playnite's own options."
                               Style="{StaticResource XboxSettingsText}" Foreground="{DynamicResource XboxTextDimBrush}"
                               Margin="0,40,0,0" />
                </StackPanel>

                <!-- Install notice: theme-only users, never focusable. -->
                <TextBlock x:Name="XboxInstallNotice" Canvas.Left="520" Canvas.Top="1012"
                           Text="Get the Xbox Series extension for the full Settings: github.com/snrgarb/xbox-series-theme"
                           FontFamily="{DynamicResource XboxFont}" FontSize="16"
                           Foreground="{DynamicResource XboxTextDimBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Canvas>
        </Grid>
    </DataTemplate>

    <Thickness x:Key="SettingsSectionItemSpacing">0,4,0,4</Thickness>

    <!--
        An option's name, beside its dropdown or slider, as the toggles' names: 20 in, where a focused row's fill starts.
    -->
    <Style x:Key="SettingsSectionText" TargetType="TextBlock" BasedOn="{StaticResource XboxSettingsText}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="20,0,0,0" />
    </Style>

    <!-- A dropdown's or slider's row as tall as a toggle's, so the rows keep one pitch. -->
    <Style x:Key="SettingsSectionSlider" TargetType="SliderEx" BasedOn="{StaticResource {x:Type SliderEx}}">
        <Setter Property="Width" Value="360" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,4,20,4" />
    </Style>

    <Style x:Key="SettingsSectionCombobox" TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBoxEx}}">
        <Setter Property="MinWidth" Value="360" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Margin" Value="0,4,20,4" />
    </Style>

    <!--
        A toggle option, a row as the console's: its name, then at its end On or Off and the switch, a pill that fills with
        the accent and moves its knob to the right when on. Focused, the row lightens and the accent ring stands 2 off it
        carrying the console's green glow as a blurred band.
    -->
    <Style x:Key="SettingsSectionCheckbox" TargetType="CheckBoxEx">
        <Setter Property="Margin" Value="{DynamicResource SettingsSectionItemSpacing}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource XboxSettingsText}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center">
                                <ContentPresenter RecognizesAccessKey="True" />
                            </TextBlock>
                            <TextBlock x:Name="State" Grid.Column="1" Text="Off" Style="{StaticResource XboxSettingsText}"
                                       Foreground="{DynamicResource XboxTextDimBrush}" VerticalAlignment="Center" Margin="20,0,14,0" />
                            <Grid Grid.Column="2" Width="50" Height="26" VerticalAlignment="Center">
                                <Border x:Name="Pill" CornerRadius="13" BorderThickness="2" BorderBrush="{DynamicResource XboxTextBrush}" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource XboxTextBrush}"
                                         HorizontalAlignment="Left" Margin="7,0" />
                            </Grid>
                        </Grid>
                        <!-- 2 of gap and 4 of ring out from the row. -->
                        <Border x:Name="FocusRing" Margin="-6" BorderThickness="4" CornerRadius="10"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Border Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Text" Value="On" />
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail's six categories, Playnite's own and fixed: their names alone, as the extension's rail. -->
    <DataTemplate x:Key="SettingsMenuGeneralButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSectionGeneral}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsMenuVisualsButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSectionVisuals}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsMenuAudioButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSectionAudio}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsMenuLayoutButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSectionLayout}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsMenuMenusButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSectionMenus}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsMenuInputButtonTemplate">
        <TextBlock Text="{DynamicResource LOCSettingsFSSection}" Style="{StaticResource XboxSettingsRailText}" />
    </DataTemplate>
</ResourceDictionary>
