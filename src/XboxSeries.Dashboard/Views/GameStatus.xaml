<!--
    Playnite's game status view, "<Game> is starting…" then "<Game> is running…", shown while a game launches and runs,
    drawn as the Launch screen it follows: the game's art over the whole view, chosen as Home's hero and the Launch screen
    choose it (the extension's HeroLayer), so the Launch screen's fade-out reveals the same picture. Background art as it
    is; without it, the cover blurred and darkened; black for neither. Over it, Home's hero scrim and a shade behind the
    centred column, then the cover and the status in white in the header font. No Close: without PART_PanelActionButtons
    Playnite adds none, and B (or Escape) leaves the view to Home as Close did, through the view host, which takes focus.
    Playnite injects no custom elements into this template, and the extension's hero, at Main's level, would follow the
    selected game rather than the launching one, so the art is plain XAML on the view's Game.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:input="clr-namespace:Playnite.Input;assembly=Playnite">

    <!-- Unused, as there is no Close; kept so every key Default's file defines is the Dashboard's. -->
    <Style x:Key="ButtonGameStatusAction" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Background" Value="{DynamicResource XboxTileBrush}" />
    </Style>

    <Style TargetType="{x:Type GameStatus}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameStatus}">
                    <Grid Background="Black"
                          x:Name="PART_ViewHost"
                          Focusable="True" FocusVisualStyle="{x:Null}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Close's command, as Playnite's own Close ran it: the view hides and focus goes back to Home. -->
                        <Grid.InputBindings>
                            <input:GameControllerInputBinding Button="B" Command="{MainViewModel CloseGameStatusCommand, DirectValue=True}" />
                            <KeyBinding Key="Escape" Command="{MainViewModel CloseGameStatusCommand, DirectValue=True}" />
                        </Grid.InputBindings>

                        <!--
                            The art, as HeroLayer draws it. Playnite's converter resolves the database's relative paths.
                            The cover, small and portrait, is blurred (radius 60, overhanging by 120 so the blur's soft
                            edges fall outside) and darkened; the triggers below give it its picture only when there is
                            no background art, so under background art it is neither decoded nor blurred. Background
                            art gets no effect: it is full size.
                        -->
                        <Grid x:Name="XboxGameStatusArt" Grid.RowSpan="4" Grid.ColumnSpan="3"
                              ClipToBounds="True" IsHitTestVisible="False">
                            <Grid x:Name="XboxGameStatusCoverArt" Visibility="Collapsed">
                                <Image x:Name="XboxGameStatusCover" Stretch="UniformToFill" Margin="-120"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <BlurEffect Radius="60" RenderingBias="Performance" />
                                    </Image.Effect>
                                </Image>
                                <Rectangle Fill="#99000000" />
                            </Grid>
                            <Image x:Name="XboxGameStatusBackground" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding Game.BackgroundImage, Converter={StaticResource ImageStringToImageConverter}}" />
                        </Grid>

                        <!-- Home's hero scrim, then a soft shade behind the centred cover and status for bright art. -->
                        <Rectangle Grid.RowSpan="4" Grid.ColumnSpan="3" IsHitTestVisible="False"
                                   Fill="{DynamicResource XboxHeroScrimBrush}" />
                        <Rectangle Grid.RowSpan="4" Grid.ColumnSpan="3" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.45" RadiusY="0.6">
                                    <GradientStop Color="#B3000000" Offset="0" />
                                    <GradientStop Color="#80000000" Offset="0.55" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <Image Name="PART_ImageCover" RenderOptions.BitmapScalingMode="Fant"
                               Height="360" HorizontalAlignment="Center"
                               Grid.Row="1" Grid.Column="1" />

                        <TextBlock Name="PART_TextStatus" TextAlignment="Center"
                                   Style="{DynamicResource XboxPanelTitle}"
                                   HorizontalAlignment="Center" Margin="0,28,0,28"
                                   Grid.Row="2" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- No background art (as the hero chooses): the cover, blurred and darkened; with no cover either, black. -->
                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="{x:Null}">
                            <Setter TargetName="XboxGameStatusCoverArt" Property="Visibility" Value="Visible" />
                            <Setter TargetName="XboxGameStatusCover" Property="Source"
                                    Value="{Binding Game.CoverImage, Converter={StaticResource ImageStringToImageConverter}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Game.BackgroundImage}" Value="">
                            <Setter TargetName="XboxGameStatusCoverArt" Property="Visibility" Value="Visible" />
                            <Setter TargetName="XboxGameStatusCover" Property="Source"
                                    Value="{Binding Game.CoverImage, Converter={StaticResource ImageStringToImageConverter}}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
