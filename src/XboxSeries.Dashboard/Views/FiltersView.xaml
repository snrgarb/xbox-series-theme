<!--
    Playnite's filter panel, which its filter button opens without the extension (with it, Search and the Full library's
    own Sort and Filter take its place): a full-height dark grey panel at the left, as the console's Guide stands, its
    rows drawn as the extension's menus draw theirs (MenuPanel.xaml), the focused one filled a little lighter and ringed
    in green. A filter in use reads in the accent green. Its rows scroll, so each stands 5 off its neighbours and the
    list's ends, keeping its ring whole.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A row opening a list of its own: its label, and the console's chevron at its right. -->
    <Style x:Key="FilterPanelNagivationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="20,0,16,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <Border x:Name="Lit" Background="{DynamicResource XboxRowLitBrush}" CornerRadius="4" Visibility="Hidden" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource XboxMenuIcon}" Margin="12,0,0,0"
                                       Foreground="{TemplateBinding Foreground}" DockPanel.Dock="Right" />
                            <TextBlock Style="{DynamicResource TextBlockBaseStyle}" DockPanel.Dock="Left"
                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <ContentPresenter />
                            </TextBlock>
                        </DockPanel>
                        <Border x:Name="FocusRing" Margin="-5" BorderThickness="4" CornerRadius="9"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden" IsHitTestVisible="False">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Border Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Playnite tags the row of a filter in use. -->
                        <Trigger Property="Tag" Value="{StaticResource True}">
                            <Setter Property="Foreground" Value="{DynamicResource GlyphLightBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilterItemtSelectionStyle" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
        <Setter Property="Margin" Value="12,5,12,5" />
    </Style>

    <Style x:Key="FilterPanelCheckBoxEx" TargetType="CheckBoxEx" BasedOn="{StaticResource {x:Type CheckBoxEx}}">
        <Setter Property="Margin" Value="12,5,12,5" />
    </Style>

    <Style x:Key="FilterPanelButtonEx" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="50" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{StaticResource True}">
                <Setter Property="Foreground" Value="{DynamicResource GlyphLightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FilterPanelComboBoxEx" TargetType="ComboBoxEx" BasedOn="{StaticResource {x:Type ComboBoxEx}}">
        <Setter Property="Margin" Value="12,5,12,5" />
    </Style>

    <!-- A section's name over its rows, dimmed, as the console heads its lists. -->
    <Style x:Key="FilterPanelText" TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextDimBrush}" />
        <Setter Property="Margin" Value="32,20,32,4" />
    </Style>

    <Style x:Key="FilterPanelFilterPresetActionButton" TargetType="ButtonEx" BasedOn="{StaticResource {x:Type ButtonEx}}">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="FilterPanelAddPresetTemplate">
        <TextBlock Text="&#xE710;" Style="{StaticResource XboxMenuIcon}" Margin="0" />
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRenamePresetTemplate">
        <TextBlock Text="&#xE70F;" Style="{StaticResource XboxMenuIcon}" Margin="0" />
    </DataTemplate>

    <DataTemplate x:Key="FilterPanelRemovePresetTemplate">
        <TextBlock Text="&#xE74D;" Style="{StaticResource XboxMenuIcon}" Margin="0" />
    </DataTemplate>

    <Style TargetType="{x:Type Filters}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Filters}">
                    <Border Background="{DynamicResource XboxPanelBrush}" MinWidth="{DynamicResource FilterPanelWidth}" Padding="0,12,0,12">
                        <ItemsControlEx x:Name="PART_ItemsHost" Focusable="False"
                                        KeyboardNavigation.DirectionalNavigation="Once">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControlEx>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
