<!--
    Playnite's lists to pick one or several items from: drawn as the extension's menus (MenuPanel.xaml), a dark grey
    panel centred over the dimmed screen, its title top left in the header font, then full-width rows, the focused one
    filled a little lighter and ringed in green. Its rows scroll, so each stands 5 off its neighbours and the list's ends,
    keeping its ring whole. The pad's Start and Y, which the footer shows, are not focusable, as on Default.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ItemSelectionButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ItemSelectionCheckBox" BasedOn="{StaticResource {x:Type CheckBoxEx}}" TargetType="CheckBoxEx">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Style="{DynamicResource TextBlockBaseStyle}" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ItemSelectionBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0,22,0,12" />
    </Style>

    <!-- The pad's prompts under the list, dimmed, as the console's hints. -->
    <Style x:Key="ItemSelectionFooterBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="30,12,30,0" />
    </Style>

    <Style x:Key="ItemSelectionFooterButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0,4,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextDimBrush}" />
    </Style>

    <Style x:Key="ItemSelectionHeaderText" BasedOn="{StaticResource XboxPanelTitle}" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="30,0,30,12" />
    </Style>
</ResourceDictionary>
