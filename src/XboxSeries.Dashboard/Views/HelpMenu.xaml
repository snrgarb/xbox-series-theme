<!--
    Playnite's help menu, from its main menu: drawn as the main menu, a full-height dark grey panel at the right, its
    rows a white line icon and a label, the focused one filled a little lighter and ringed in green.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HelpMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,0,0,12" />
    </Style>

    <Style x:Key="HelpMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="12,2,12,2" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="HelpMenuHeaderTemplate">
        <TextBlock Text="{DynamicResource LOCMenuHelpTitle}" Style="{DynamicResource XboxPanelTitle}" Margin="30,48,30,24" />
    </DataTemplate>

    <DataTemplate x:Key="HelpMenuRestartPlayniteButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{DynamicResource LOCCrashRestartPlaynite}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HelpMenuSafeModeButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE83D;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{DynamicResource LOCCrashRestartSafe}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HelpMenuFeedbackButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED15;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{DynamicResource LOCMenuIssues}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
