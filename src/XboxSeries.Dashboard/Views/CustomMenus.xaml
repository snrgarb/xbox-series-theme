<!--
    Playnite's menus of game clients, software tools and extensions' commands, from its main menu: drawn as the
    extension's menus (MenuPanel.xaml), a dark grey panel centred over the dimmed screen, full-width rows of an icon and
    a label, the focused one filled a little lighter and ringed in green. The icons are each client's, tool's or
    command's own. Its rows scroll, so each stands 5 off its neighbours and the list's ends, keeping its ring whole.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GameClientMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{Binding Icon}" Width="24" Height="24" Focusable="False"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameClientsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="450" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>

    <Style x:Key="SoftwareToolMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon, Converter={StaticResource ImageStringToImageConverter}}" Width="24" Height="24"
                               Focusable="False" RenderOptions.BitmapScalingMode="Fant"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SoftwareToolsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="450" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>

    <!-- A command with commands under it shows the console's chevron at its right. -->
    <Style x:Key="ExtensionMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <Setter Property="Margin" Value="12,5,12,5" />
        <Setter Property="Padding" Value="20,0,20,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <ContentControl Content="{Binding Icon}" Width="24" Height="24" Focusable="False"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,20,0"
                                        DockPanel.Dock="Left" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource XboxMenuIcon}" Margin="20,0,0,0" DockPanel.Dock="Right"
                                   Visibility="{Binding Children, Converter={StaticResource NullToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExtensionsBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="450" />
        <Setter Property="Padding" Value="0,12,0,12" />
    </Style>
</ResourceDictionary>
