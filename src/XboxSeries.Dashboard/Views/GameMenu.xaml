<!--
    Playnite's game menu, which Manage game opens, drawn as the console's tile menu: a 450 wide dark grey panel centred
    over the dimmed screen, the game's name its one-line title, then rows 72 apart of a white line icon and a label.
    The focused row is filled a lighter grey across the panel's full width and ringed in green, the ring standing 8 past
    the panel on either side with its glow about it.

    Playnite's window holds the rows in a ScrollViewer, whose content presenter clips to itself. So the panel's own
    ScrollViewer reaches 28 past it on either side and 20 above and below, and the rows are inset back by the same less
    the ring's overhang: nothing a row draws on focus is clipped. A row scrolled 20 into the band above or below shows
    nothing there at rest, as its icon and label sit in its middle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="GameMenuButton" BasedOn="{StaticResource {x:Type ButtonEx}}" TargetType="ButtonEx">
        <!-- 20 in from the scroll area's sides, which stand 28 past the panel's: the row and its ring 8 past it. -->
        <Setter Property="Margin" Value="20,0,20,0" />
        <!-- The icon's 24 column centred 44 in from the panel's edge, 52 from the row's. -->
        <Setter Property="Padding" Value="40,0,0,0" />
        <Setter Property="Height" Value="72" />
        <!-- Playnite sizes the panel to its rows: 450, the row less its overhang either side. -->
        <Setter Property="MinWidth" Value="466" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid Background="Transparent">
                        <!-- The panel's full width: the ring's 4 and a 4 gap in from the row's edges. -->
                        <Border x:Name="Fill" Margin="8,8,8,8" CornerRadius="2" Background="#FF404040" Visibility="Hidden" />
                        <Border x:Name="Lit" Margin="8,8,8,8" CornerRadius="2" Background="{DynamicResource XboxRowLitBrush}" Visibility="Hidden" />
                        <TextBlock Style="{DynamicResource TextBlockBaseStyle}" FontSize="22"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Margin="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </TextBlock>
                        <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="7"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden" IsHitTestVisible="False">
                            <Border Style="{DynamicResource XboxFocusGlowCache}">
                                <Border Style="{DynamicResource XboxFocusGlow}" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <!-- The rows' icons, as Constants.xaml's but further off the label: the label 88 in from the panel's edge. -->
            <Style x:Key="XboxMenuIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="Margin" Value="0,0,34,0" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="GameMenuBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource XboxPanelBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Style.Resources>
            <!-- The rows' scroll area, wider and taller than the panel so the focus ring and its glow stand past it. -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Margin" Value="-28,-20,-28,-20" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!--
                The rows' list: 7 whole rows at most, all that fit in Playnite's 648 high middle of the screen under the
                title, so a longer list scrolls by whole rows and none is cut where the scroll area passes the panel.
                Its panel gives back the scroll area's top and bottom.
            -->
            <Style TargetType="ItemsControlEx">
                <Setter Property="MaxHeight" Value="504" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="0,20,0,20" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>

    <!-- The game's name, the menu's title, on one line, trimmed to the panel. -->
    <Style x:Key="GameMenuHeaderText" BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock">
        <!-- XboxPanelTitle's look: a StaticResource can't reach it in Constants.xaml (see DashboardBoundaryTests). -->
        <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
        <Setter Property="FontSize" Value="33" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="394" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="28,36,28,24" />
    </Style>

    <DataTemplate x:Key="GameMenuHeaderTemplate">
        <TextBlock Text="{Binding Name}" Style="{DynamicResource GameMenuHeaderText}" />
    </DataTemplate>

    <DataTemplate x:Key="GameMenuPlayButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE768;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuInstallButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuFavoriesButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE734;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuVisibilityButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xED1A;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuHdrButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE793;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuRemoveButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE738;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuUninstallButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74D;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuCustomActionButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuCompletionStatusTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuSetFieldsTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE70F;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="GameMenuExtensionsTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEA86;" Style="{DynamicResource XboxMenuIcon}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
