<!--
    The Game hub: the Dashboard's page for one game, modelled on the Xbox game hub. It replaces Playnite's Game details
    view and is complete with the theme alone: blurred art behind a header, a row of cards and the actions under them.
    Like the console, the hub has two pages that share the header and actions: Game hub (cover, stats, About and Info)
    and Game details (cover, trailer, the full description, Info). The last action, or A on the About or Info card,
    switches between them; only the cards change.
    The data context is the selected game (Playnite's GamesCollectionViewEntry). Playnite binds the PART_ elements and
    the hub's keys itself: B closes, LB/RB move to the previous or next game, and focus starts on the first visible
    focusable element, which is the main action. Menu is bound here, to Playnite's game menu.
    Achievements come from PlayniteAchievements through {PluginSettings}, and the trailer from Extra Metadata Loader's
    video player; without either, the achievements row stays hidden and the trailer card shows the background art.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:input="clr-namespace:Playnite.Input;assembly=Playnite"
                    mc:Ignorable="d">

    <!--
        Simple Icons (CC0, simpleicons.org; Xbox from v9.21.0, the last release to carry it), on a 24x24 box.
        The same marks as Home's tiles.
    -->
    <Geometry x:Key="XboxHubSourceSteam">M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z</Geometry>
    <Geometry x:Key="XboxHubSourceXbox">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>

    <Style x:Key="XboxHubText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="XboxHubDimText" TargetType="TextBlock" BasedOn="{StaticResource XboxHubText}">
        <Setter Property="Foreground" Value="{DynamicResource XboxTextDimBrush}" />
    </Style>

    <Style x:Key="XboxHubCardTitle" TargetType="TextBlock" BasedOn="{StaticResource XboxHubText}">
        <Setter Property="FontFamily" Value="{DynamicResource XboxFontSemibold}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- One label/value line of a card. -->
    <Style x:Key="XboxHubRowLabel" TargetType="TextBlock" BasedOn="{StaticResource XboxHubText}">
        <Setter Property="FontSize" Value="22" />
    </Style>
    <Style x:Key="XboxHubRowValue" TargetType="TextBlock" BasedOn="{StaticResource XboxHubText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Margin" Value="0,2,16,18" />
    </Style>

    <!-- The "•" before a header item: Collapsed unless an earlier item shows (set per item with DataTriggers). -->
    <Style x:Key="XboxHubDot" TargetType="TextBlock" BasedOn="{StaticResource XboxHubDimText}">
        <Setter Property="Text" Value="•" />
        <Setter Property="Margin" Value="8,0,8,0" />
    </Style>

    <!-- The green ring, with its glow, that the console draws around whatever has focus; the same as Home's tiles. -->
    <Style x:Key="XboxHubFocusRing" TargetType="Border">
        <Setter Property="BorderThickness" Value="4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlyphLightBrush}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" Opacity="0.9" BlurRadius="24"
                                  Color="{DynamicResource GlyphColor}" RenderingBias="Quality" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An action: a flat translucent slab that fills green and takes the ring when focused. -->
    <ControlTemplate x:Key="XboxHubActionTemplate" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Slab" Background="{TemplateBinding Background}" CornerRadius="4" />
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Border x:Name="Ring" Style="{StaticResource XboxHubFocusRing}" />
            <!-- What an icon-only action does, shown above it while it has focus. -->
            <Border x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-150,-48,-150,0"
                    Padding="10,4" CornerRadius="3" Background="{DynamicResource XboxChipBrush}"
                    BorderBrush="#80FFFFFF" BorderThickness="1" Visibility="Collapsed">
                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource XboxHubText}" FontSize="17" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Slab" Property="Background" Value="{DynamicResource GlyphLightBrush}" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Label" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="XboxHubAction" TargetType="ButtonBase">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource XboxFontSemibold}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Height" Value="80" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Template" Value="{StaticResource XboxHubActionTemplate}" />
    </Style>

    <!-- The main action, Play or Install: wide, and in capitals as on the console. -->
    <Style x:Key="XboxHubDefaultAction" TargetType="ButtonEx" BasedOn="{StaticResource XboxHubAction}">
        <Setter Property="Width" Value="380" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource StringToUpperCaseConverter}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An icon-only action; its Tag names it above the button while it has focus. -->
    <Style x:Key="XboxHubIconAction" TargetType="ButtonEx" BasedOn="{StaticResource XboxHubAction}">
        <Setter Property="Width" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!--
        A card: a translucent panel that takes the ring while it, or anything in it, has focus. Cards that hold their
        own focusable content (About's scroller) set Focusable to False so the D-pad stops once.
    -->
    <ControlTemplate x:Key="XboxHubCardTemplate" TargetType="ContentControl">
        <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
            <ContentPresenter Margin="{TemplateBinding Padding}" />
            <Border x:Name="Ring" Style="{StaticResource XboxHubFocusRing}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="XboxHubCard" TargetType="ContentControl">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="#4D2A2A2A" />
        <Setter Property="Height" Value="500" />
        <Setter Property="Padding" Value="26,22" />
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Template" Value="{StaticResource XboxHubCardTemplate}" />
    </Style>

    <Style x:Key="XboxHubProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#33FFFFFF" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{DynamicResource GlyphLightBrush}" CornerRadius="3"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The game's features as pills, as the console shows its capabilities. -->
    <DataTemplate x:Key="XboxHubFeatureChips">
        <!-- Two rows at most; the rest are cut, never half a pill. -->
        <ItemsControl ItemsSource="{Binding Features}" Focusable="False" MaxHeight="80" ClipToBounds="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#40FFFFFF" CornerRadius="16" Padding="14,4" Margin="0,8,8,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource XboxHubText}" FontSize="18" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <!-- Info's lines, two to a line; shared by both pages' Info cards. -->
    <DataTemplate x:Key="XboxHubInfo">
        <StackPanel>
            <TextBlock Text="Info" Style="{StaticResource XboxHubCardTitle}" />
            <UniformGrid Columns="2">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Genres.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Genres" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding Genres, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Developers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Developer" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding Developers, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Series.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Series" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding Series, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CriticScore}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Critic score" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding CriticScore}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CommunityScore}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Community score" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding CommunityScore}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UserScore}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Your score" Style="{StaticResource XboxHubRowLabel}" />
                    <TextBlock Text="{Binding UserScore}" Style="{StaticResource XboxHubRowValue}" />
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </DataTemplate>

    <!-- The Info card, on both pages; hidden when the game has none of its lines. -->
    <Style x:Key="XboxHubInfoCard" TargetType="ContentControl" BasedOn="{StaticResource XboxHubCard}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Genres.Count}" Value="0" />
                    <Condition Binding="{Binding Developers.Count}" Value="0" />
                    <Condition Binding="{Binding Series.Count}" Value="0" />
                    <Condition Binding="{Binding CriticScore}" Value="{x:Null}" />
                    <Condition Binding="{Binding CommunityScore}" Value="{x:Null}" />
                    <Condition Binding="{Binding UserScore}" Value="{x:Null}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid x:Name="PART_ViewHost"
                          Background="{DynamicResource MainBackgourndBrush}"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">
                        <!-- Playnite adds B, LB and RB to these; Menu opens its game menu, as Manage does. -->
                        <Grid.InputBindings>
                            <input:GameControllerInputBinding Button="Start" Command="{MainViewModel OpenGameMenuCommand, DirectValue=True}" />
                        </Grid.InputBindings>

                        <!--
                            Background: the game's own background art, blurred and dimmed; without one, its cover, blurred and
                            dimmed; without either, the plain dashboard background behind them.
                        -->
                        <Grid ClipToBounds="True" IsHitTestVisible="False">
                            <Image Source="{Binding CoverImageObject}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="LowQuality" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <!-- Grown so the blur's soft edges fall off screen. -->
                                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                                </Image.RenderTransform>
                                <Image.Effect>
                                    <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                                </Image.Effect>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding BackgroundImage, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True" />
                                                    <Condition Binding="{Binding CoverImage, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Playnite sets the part's source, so it is hidden through a wrapper when the game has no art of its own. -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackgroundImage, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill"
                                           IsBlurEnabled="True" BlurAmount="30" />
                            </Grid>

                            <Rectangle>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <!-- Dimmed overall, and more so at the left and bottom where the text and cards sit. -->
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#CC000000" Offset="0" />
                                                    <GradientStop Color="#66000000" Offset="0.55" />
                                                    <GradientStop Color="#99000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding BackgroundImage, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True" />
                                                    <Condition Binding="{Binding CoverImage, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Grid>

                        <Grid Margin="80,96,80,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Actions. Playnite gives the main action its label and command (Play, Install, or a prompt to stop
                                monitoring while the game runs). While the game runs the hub shows Running instead, which does
                                nothing. Running comes first so that it, not the hidden part, takes focus when the hub opens.
                            -->
                            <StackPanel x:Name="Actions" Grid.Row="3" Orientation="Horizontal" Margin="0,32,0,0">
                                <ButtonEx x:Name="RunningAction" Content="Running">
                                    <ButtonEx.Style>
                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxHubDefaultAction}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                </ButtonEx>
                                <ButtonEx x:Name="PART_ButtonContext">
                                    <ButtonEx.Style>
                                        <Style TargetType="ButtonEx" BasedOn="{StaticResource XboxHubDefaultAction}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ButtonEx.Style>
                                </ButtonEx>
                                <ButtonEx x:Name="PART_ButtonOptions" Style="{StaticResource XboxHubIconAction}"
                                          Tag="Manage" Content="&#xE713;" />
                                <!-- Turns between the two pages; it names the page it turns to. -->
                                <ToggleButtonEx x:Name="PageToggle" Style="{StaticResource XboxHubAction}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{DynamicResource XboxIconFont}" FontSize="24"
                                                   VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE946;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PageToggle}" Value="True">
                                                            <Setter Property="Text" Value="&#xE80F;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="GAME DETAILS" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked, ElementName=PageToggle}" Value="True">
                                                            <Setter Property="Text" Value="GAME HUB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ToggleButtonEx>
                            </StackPanel>

                            <!-- Header: title, then Publisher • Release year • Install size • Platform • Source beside it. -->
                            <DockPanel Grid.Row="0">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource XboxHubText}" MaxWidth="1100"
                                           FontFamily="{DynamicResource XboxFontSemibold}" FontSize="52" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,11">
                                    <TextBlock x:Name="HeaderPublisher"
                                               Text="{Binding Publishers, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource XboxHubDimText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Publishers.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel x:Name="HeaderYear" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReleaseYear}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxHubDot}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderPublisher}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ReleaseYear}" Style="{StaticResource XboxHubDimText}" />
                                    </StackPanel>

                                    <!-- Installed games only. -->
                                    <StackPanel x:Name="HeaderInstallSize" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InstallSize}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InstallSize}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxHubDot}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderPublisher}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderYear}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding InstallSize, Converter={StaticResource NullableUlongBytesSizeToStringConverter}}"
                                                   Style="{StaticResource XboxHubDimText}" />
                                    </StackPanel>

                                    <StackPanel x:Name="HeaderPlatform" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Platforms.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxHubDot}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderPublisher}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderYear}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderInstallSize}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Platforms, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}"
                                                   Style="{StaticResource XboxHubDimText}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceId}" Value="{x:Static sys:Guid.Empty}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource XboxHubDot}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderPublisher}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderYear}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderInstallSize}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Visibility, ElementName=HeaderPlatform}" Value="Visible">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Source.Name}" Style="{StaticResource XboxHubDimText}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <!-- Then the features on a line, as the console lists a game's capabilities, and the age rating. -->
                            <DockPanel Margin="0,6,0,0" Grid.Row="1" MinHeight="48">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Features, Converter={StaticResource ListToStringConverter}, ConverterParameter=' • '}"
                                           Style="{StaticResource XboxHubDimText}" FontSize="19" MaxWidth="1000"
                                           TextWrapping="Wrap" MaxHeight="54" VerticalAlignment="Center" Margin="0,0,28,0" />
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Padding="10,3"
                                        BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AgeRatings.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AgeRatings, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}"
                                               Style="{StaticResource XboxHubText}" FontSize="16" />
                                </Border>
                            </DockPanel>

                            <!--
                                Cards. The cover leads both pages; the rest swap with the page. Any card with nothing to show
                                is hidden. A row can be wider than the screen, so it runs to the screen's edges and, while a
                                card near its end has focus, lines its end up with the right margin instead.
                                CardStripFrame lets the row keep its full width (a Grid would squeeze it to the screen's) and
                                is never narrower than the screen, so a row that fits never moves.
                            -->
                            <Grid x:Name="Cards" Grid.Row="2" Margin="-80,32,-80,0">
                                <StackPanel x:Name="CardStripFrame" Orientation="Horizontal" HorizontalAlignment="Left"
                                            MinWidth="{Binding ActualWidth, ElementName=Cards}">
                                <!-- 64, not 80, on the right: the last card brings its own 16 of spacing. -->
                                <StackPanel Orientation="Horizontal" Margin="80,0,64,0">

                                    <!-- Cover, with the game's source (or platform) as a badge. -->
                                    <ContentControl Style="{StaticResource XboxHubCard}" Width="375" Padding="0">
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="PART_ImageCover" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="Fant" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                                                    Padding="8,4" CornerRadius="3" Background="{DynamicResource XboxChipBrush}">
                                                <Grid>
                                                    <Path x:Name="BadgeIcon" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource XboxTextBrush}"
                                                          Visibility="Collapsed" />
                                                    <TextBlock x:Name="BadgeText" Style="{StaticResource XboxHubText}" FontSize="14"
                                                               MaxWidth="180" Text="{Binding Source.Name}" />
                                                </Grid>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SourceId}" Value="{x:Static sys:Guid.Empty}" />
                                                                    <Condition Binding="{Binding Platforms.Count}" Value="0" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>
                                    </ContentControl>

                                    <!-- Game hub. -->
                                    <StackPanel x:Name="HubCards" Orientation="Horizontal">
                                        <!-- Your game stats. -->
                                        <ContentControl Width="416">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource XboxHubCard}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Visibility, ElementName=StatsPlaytime}" Value="Collapsed" />
                                                                <Condition Binding="{Binding Visibility, ElementName=StatsPlayCount}" Value="Collapsed" />
                                                                <Condition Binding="{Binding Visibility, ElementName=StatsLastPlayed}" Value="Collapsed" />
                                                                <Condition Binding="{Binding Visibility, ElementName=StatsCompletion}" Value="Collapsed" />
                                                                <Condition Binding="{Binding Visibility, ElementName=StatsAchievements}" Value="Collapsed" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <StackPanel>
                                                <TextBlock Text="Your game stats" Style="{StaticResource XboxHubCardTitle}" />
                                                <StackPanel x:Name="StatsPlaytime">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Playtime}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Time played" Style="{StaticResource XboxHubRowLabel}" />
                                                    <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}"
                                                               Style="{StaticResource XboxHubRowValue}" />
                                                </StackPanel>
                                                <StackPanel x:Name="StatsPlayCount">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PlayCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Times played" Style="{StaticResource XboxHubRowLabel}" />
                                                    <TextBlock Text="{Binding PlayCount}" Style="{StaticResource XboxHubRowValue}" />
                                                </StackPanel>
                                                <StackPanel x:Name="StatsLastPlayed">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LastActivity}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Last played" Style="{StaticResource XboxHubRowLabel}" />
                                                    <TextBlock Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}"
                                                               Style="{StaticResource XboxHubRowValue}" />
                                                </StackPanel>
                                                <StackPanel x:Name="StatsCompletion">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CompletionStatusId}" Value="{x:Static sys:Guid.Empty}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Completion" Style="{StaticResource XboxHubRowLabel}" />
                                                    <TextBlock Text="{Binding CompletionStatus.Name}" Style="{StaticResource XboxHubRowValue}" />
                                                </StackPanel>

                                                <!-- Only when PlayniteAchievements has data for this game; without the add-on the
                                                     binding fails and it stays hidden. -->
                                                <StackPanel x:Name="StatsAchievements">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasAchievements}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Achievements" Style="{StaticResource XboxHubRowLabel}" />
                                                    <DockPanel Margin="0,2,0,10">
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource XboxHubDimText}"
                                                                   Text="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, StringFormat='{}{0:0}%'}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked}"
                                                                       Style="{StaticResource XboxHubText}" FontSize="22" />
                                                            <TextBlock Text=" / " Style="{StaticResource XboxHubText}" FontSize="22" />
                                                            <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total}"
                                                                       Style="{StaticResource XboxHubText}" FontSize="22" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource XboxHubProgressBar}"
                                                                 Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </ContentControl>

                                        <!--
                                            About: the start of the description; A turns to Game details, which has all of it.
                                            Bound to the page toggle, so pressing it flips the toggle too.
                                        -->
                                        <ToggleButtonEx Width="480" IsChecked="{Binding IsChecked, ElementName=PageToggle, Mode=TwoWay}">
                                            <ToggleButtonEx.Style>
                                                <Style TargetType="ToggleButtonEx" BasedOn="{StaticResource XboxHubCard}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButtonEx.Style>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="About" Style="{StaticResource XboxHubCardTitle}" />
                                                <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource XboxHubFeatureChips}" />
                                                <!-- Shown only: disabled so it takes no focus of its own. -->
                                                <HtmlTextView HtmlText="{Binding Description}" IsEnabled="False" IsHitTestVisible="False" Margin="0,0,0,12"
                                                              ClipToBounds="True"
                                                              HtmlFontSize="19"
                                                              HtmlFontFamily="{DynamicResource XboxFont}"
                                                              HtmlForeground="#E6FFFFFF"
                                                              LinkForeground="{DynamicResource GlyphLightColor}" />
                                            </DockPanel>
                                        </ToggleButtonEx>

                                        <!-- Info; A, like About's, turns to Game details. -->
                                        <ToggleButtonEx x:Name="HubInfo" Width="436" IsChecked="{Binding IsChecked, ElementName=PageToggle, Mode=TwoWay}"
                                                        Content="{Binding}" ContentTemplate="{StaticResource XboxHubInfo}"
                                                        Style="{StaticResource XboxHubInfoCard}" />
                                    </StackPanel>

                                    <!-- Game details. -->
                                    <StackPanel x:Name="DetailsCards" Orientation="Horizontal" Visibility="Collapsed">
                                        <!--
                                            Trailer: Extra Metadata Loader's player, muted, over the game's background art, or its
                                            cover when it has no art. Without the add-on, or a video, only the art shows.
                                        -->
                                        <ContentControl Style="{StaticResource XboxHubCard}" Width="889" Padding="0">
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding CoverImageObject}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                                <Image Source="{Binding DisplayBackgroundImageObject, IsAsync=True}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="Fant" />
                                                <ContentControl x:Name="ExtraMetadataLoader_VideoLoaderControl_NoControls_NoSound" Focusable="False" />
                                            </Grid>
                                        </ContentControl>

                                        <!-- Description: the whole of it, scrolled with the D-pad, and the features under it. -->
                                        <ContentControl x:Name="DetailsDescription" Width="480" Focusable="False">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl" BasedOn="{StaticResource XboxHubCard}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Description, Converter={StaticResource StringNullOrEmptyToBoolConverter}, ConverterParameter=Inverted}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Top" Text="Description" Style="{StaticResource XboxHubCardTitle}" />
                                                <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding}" ContentTemplate="{StaticResource XboxHubFeatureChips}" />
                                                <ScrollViewerEx x:Name="PART_ScrollHtmlDescription" CustomScrollAmount="42" Margin="0,0,0,12"
                                                                Focusable="True" FocusVisualStyle="{x:Null}"
                                                                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                                    <HtmlTextView x:Name="PART_HtmlDescription"
                                                                  HtmlFontSize="19"
                                                                  HtmlFontFamily="{DynamicResource XboxFont}"
                                                                  HtmlForeground="#E6FFFFFF"
                                                                  LinkForeground="{DynamicResource GlyphLightColor}"
                                                                  FocusVisualStyle="{x:Null}" />
                                                </ScrollViewerEx>
                                            </DockPanel>
                                        </ContentControl>

                                        <ContentControl x:Name="DetailsInfo" Width="436" Content="{Binding}"
                                                        ContentTemplate="{StaticResource XboxHubInfo}"
                                                        Style="{StaticResource XboxHubInfoCard}" />
                                    </StackPanel>
                                </StackPanel>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The badge: the source's mark where there is one, else its name, else the platform's. -->
                        <DataTrigger Binding="{Binding Source.Name}" Value="Steam">
                            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource XboxHubSourceSteam}" />
                            <Setter TargetName="BadgeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source.Name}" Value="Xbox">
                            <Setter TargetName="BadgeIcon" Property="Data" Value="{StaticResource XboxHubSourceXbox}" />
                            <Setter TargetName="BadgeIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BadgeText" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SourceId}" Value="{x:Static sys:Guid.Empty}">
                            <Setter TargetName="BadgeText" Property="Text"
                                    Value="{Binding Platforms, Converter={StaticResource ListToStringConverter}, ConverterParameter=', '}" />
                        </DataTrigger>

                        <!--
                            Play and Running swap as the game starts and stops; focus follows, so it isn't left on the hidden
                            one. Each focus hand-off below is set on its own element so that one never masks another.
                        -->
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="Actions" Property="FocusManager.FocusedElement" Value="{Binding ElementName=RunningAction}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="False">
                            <Setter TargetName="Actions" Property="FocusManager.FocusedElement" Value="{Binding ElementName=PART_ButtonContext}" />
                        </DataTrigger>

                        <!-- The pages. -->
                        <Trigger SourceName="PageToggle" Property="IsChecked" Value="True">
                            <Setter TargetName="HubCards" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="DetailsCards" Property="Visibility" Value="Visible" />
                            <!-- A on About or Info hides the card it was pressed on; focus goes to the page toggle,
                                 not nowhere. -->
                            <Setter TargetName="Cards" Property="FocusManager.FocusedElement" Value="{Binding ElementName=PageToggle}" />
                        </Trigger>

                        <!-- Cards near a row's end: line the row's end up with the right margin, so they show whole. -->
                        <Trigger SourceName="HubInfo" Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CardStripFrame" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger SourceName="DetailsDescription" Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CardStripFrame" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger SourceName="DetailsInfo" Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="CardStripFrame" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
