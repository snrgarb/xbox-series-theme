    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <Grid Background="#FF1A1A1A">
                        <Image x:Name="PART_ImageCover"
                               RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Stretch="{Settings CoverArtStretch}" />
                        <Border Background="#AA000000" x:Name="BorderDarken" Visibility="Collapsed" />

                        <Path x:Name="SourceIcon" Width="20" Height="20" Margin="10" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="White" Visibility="Collapsed">
                            <Path.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.8" Color="Black" />
                            </Path.Effect>
                        </Path>

                        <Border x:Name="StateBadge" Background="#E62B2B2B" CornerRadius="3" Width="24" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                            <Grid>
                                <Path x:Name="PlayMark" Data="M0,0 L9,5.5 L0,11 Z" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="DownloadMark" Text="&#xE896;" FontFamily="{DynamicResource XboxIconFont}" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Source.Name}" Value="Steam">
                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource XboxSourceSteam}" />
                            <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source.Name}" Value="Xbox">
                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource XboxSourceXbox}" />
                            <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="SourceIcon" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DownloadMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DownloadMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
