    <Geometry x:Key="XboxSourceXbox">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>

    <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameListItem}">
                    <!--
                        Rounded corners, as Home's tiles: Playnite loads the cover into its Image, which is hidden, and the
                        tile paints it as a rounded border's fill, cheaper than clipping the tile to a rounded shape.
                    -->
                    <Grid>
                        <Image x:Name="PART_ImageCover" Visibility="Hidden"
                               RenderOptions.BitmapScalingMode="Fant" StretchDirection="Both"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Stretch="{Settings CoverArtStretch}" />
                        <Border CornerRadius="6" Background="#FF1A1A1A" />
                        <Border CornerRadius="6" RenderOptions.BitmapScalingMode="Fant">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Source, ElementName=PART_ImageCover}"
                                            Stretch="{Binding Stretch, ElementName=PART_ImageCover}" />
                            </Border.Background>
                        </Border>
                        <Border Background="#AA000000" CornerRadius="6" x:Name="BorderDarken" Visibility="Collapsed" />

                        <!--
                            As Home's: its shadow drawn once into a picture, at the 4K screen's 2 pixels to a 1080p one, which
                            the list then moves as it scrolls, rather than the shadow being drawn again for every tile every frame.
                            The picture is the badge's, the icon's parent: WPF caches an element under its own effect, so a cache
                            on the icon itself would hold it unshadowed. Shown, hidden and faded by the badge, above the picture.
                        -->
                        <Border x:Name="SourceBadge" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <Border.CacheMode>
                                <BitmapCache RenderAtScale="2" SnapsToDevicePixels="True" />
                            </Border.CacheMode>
                            <Path x:Name="SourceIcon" Width="20" Height="20" Stretch="Uniform" Fill="White">
                                <Path.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.8" Color="Black" />
                                </Path.Effect>
                            </Path>
                        </Border>

                        <!-- Hidden on focus, where ListGameItemStyle's title band puts it under the title instead. -->
                        <Border x:Name="InstallingBand" VerticalAlignment="Bottom" CornerRadius="0,0,6,6" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="Installing..." Margin="12,28,12,10" TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource XboxFont}" FontSize="20"
                                       Foreground="{DynamicResource XboxTextBrush}" />
                        </Border>

                        <Border x:Name="StateBadge" Background="#E62B2B2B" CornerRadius="3" Width="24" Height="24"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                            <Grid>
                                <Path x:Name="PlayMark" Data="M0,0 L9,5.5 L0,11 Z" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="DownloadMark" Text="&#xE896;" FontFamily="{DynamicResource XboxIconFont}" FontSize="14"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInstalled}" Value="False" />
                                <Condition Binding="{Settings Fullscreen.DarkenUninstalledGamesGrid}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="BorderDarken" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Source.Name}" Value="Steam">
                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource XboxSourceSteam}" />
                            <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source.Name}" Value="Xbox">
                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource XboxSourceXbox}" />
                            <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="SourceBadge" Property="Opacity" Value="0" />
                            <Setter TargetName="InstallingBand" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                            <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DownloadMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- After the not-installed trigger, so an installing game's download mark gives way to the caption. -->
                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                            <Setter TargetName="InstallingBand" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SourceBadge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="StateBadge" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="StateBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="DownloadMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PlayMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
