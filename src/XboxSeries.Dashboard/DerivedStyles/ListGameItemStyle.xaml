<!--
    The container of every tile in Playnite's main list: an Xbox tile that rings in the accent and shows its title when
    focused, and grows on Home. With the extension the list is only My games & apps' grid, where a tile grows no further
    than its gap, as on the console.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <Style x:Key="ListGameItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="GrowOn">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                                             To="1.12" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                                             To="1.12" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                        <Storyboard x:Key="GrowOff">
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.15" />
                        </Storyboard>
                        <Storyboard x:Key="FocusedOn">
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.05" Duration="0:0:0.15" />
                        </Storyboard>
                        <Storyboard x:Key="FocusedOff">
                            <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <!--
                        A fixed gap, as on the console, rather than Playnite's item spacing, so My games & apps' grid can line
                        up: 15 between tiles, near the console's grid, as Apps' are; a focused tile's ring, 8 out, clears the next.
                    -->
                    <Grid Margin="7.5"
                          RenderTransformOrigin="0.5,0.5"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <ContentPresenter />

                        <Border x:Name="TitleBand" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False" CornerRadius="0,0,6,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E6000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="12,36,12,10">
                                <TextBlock Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="56"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="20"
                                           Foreground="{DynamicResource XboxTextBrush}" />
                                <!-- As the console's focused tile: the title over Installing..., which the tile shows unfocused. -->
                                <TextBlock x:Name="InstallingCaption" Text="Installing..." TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="20"
                                           Foreground="{DynamicResource XboxTextBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- As Home's Recent row: standing 4 px off the tile, its corners following the tile's (6 + 4 + 4). -->
                        <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="14" Margin="-8"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed">
                            <Border Style="{DynamicResource XboxFocusGlow}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                            <Setter TargetName="InstallingCaption" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            <Setter Property="Panel.ZIndex" Value="90" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusedOn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource FocusedOff}" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{PluginStatus Plugin=XboxSeries_eb759ff1-325b-4c34-9a64-d9704f72612b, Status=Installed}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource GrowOn}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource GrowOff}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
