<Window x:Class="XboxSeries.Extension.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxSeries.Extension"
        xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
        Title="Xbox Series Start-up"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Start-up sequence: opaque, Topmost and full-screen over Playnite as it starts in Fullscreen, and again on
        waking from sleep. It follows the core's StartupState and holds no logic. The boot video plays full screen on
        black; then Who's playing today? and Signing you in, drawn after the console's (docs/reference/startup), over its
        green swirl (SwirlBackground). Who's playing today? has the profiles in a row, centred, each a large round picture
        with its gamertag under it, the focused one bigger in a green ring a little way out from it, its real name under
        its gamertag, the two swapping places on a loop. Signing you in has the chosen profile's picture alone in the
        centre in its ring, its gamertag and "Signing you in" under it, and a light running round the ring. A picture that
        is missing or won't load shows the person glyph on green.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The image converter, as Image. -->
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
            <local:SameProfileConverter x:Key="IsFocused" />

            <local:HasTextConverter x:Key="HasText" />

            <!--
                Signing you in's light, once round the ring each 1.2 s: begun while Who's playing today? or Signing you in
                shows and stopped once the window hides, so it never keeps WPF rendering behind Playnite.
            -->
            <Storyboard x:Key="Spin">
                <DoubleAnimation Storyboard.TargetName="SigningSpin" Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
            </Storyboard>

            <Style x:Key="StartupText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!--
                A profile's picture, 380 round: the person glyph on the console's green, under the picture itself, which
                covers it once it loads; null, missing or unreadable, it stays empty and the glyph shows.
            -->
            <DataTemplate x:Key="ProfilePicture" DataType="{x:Type core:Profile}">
                <Grid Width="380" Height="380">
                    <Ellipse Fill="{DynamicResource XboxGreenBrush}" />
                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource XboxIconFont}" FontSize="170" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Picture, Converter={StaticResource Image}, ConverterParameter=380}"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- The green swirl, behind Who's playing today? and Signing you in, filling the screen whatever its aspect. -->
        <Grid x:Name="SwirlLayer" Opacity="0" Visibility="Hidden">
            <local:SwirlBackground />

            <!-- The title and the profiles: laid out 1080 tall at the screen's aspect, as the Overlay is, and scaled to the screen. -->
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Root" Height="1080" Width="1920">
                    <TextBlock Text="Who's playing today?" Style="{StaticResource StartupText}" FontSize="60"
                               VerticalAlignment="Top" Margin="0,150,0,0" />

                    <!--
                        Who's playing today?: the profiles in a row, centred, their pictures centred on the screen's middle.
                        Each is 380 round, drawn at 300 unless focused, when it grows to its full size in its green ring,
                        5 out from the picture, and its real name shows under its gamertag. A row wider than the screen
                        scrolls to keep the focused profile on it.
                    -->
                    <ScrollViewer x:Name="ProfileScroller" VerticalAlignment="Top" Margin="0,340,0,0"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" IsHitTestVisible="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="{x:Static core:StartupPhase.WhosPlaying}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl x:Name="ProfileRow" ItemsSource="{Binding Profiles}" HorizontalAlignment="Center"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:Profile}">
                                    <StackPanel Width="420" Background="Transparent" MouseLeftButtonUp="OnProfileClick">
                                        <Grid Width="420" Height="420">
                                            <Grid x:Name="Circle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="Grow" ScaleX="0.79" ScaleY="0.79" />
                                                </Grid.RenderTransform>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProfilePicture}" />
                                                <Ellipse x:Name="Ring" Margin="-12" StrokeThickness="7"
                                                         Stroke="{DynamicResource GlyphLightBrush}" Opacity="0" />
                                            </Grid>
                                        </Grid>
                                        <!--
                                            The name, in two lines: the gamertag, and under it the real name, shown only while
                                            focused. Focused with a real name, the two swap places on a loop as the console's do,
                                            crossfading as the Toast's line and its prompt do: each line keeps its place's size
                                            and colour, and only its text changes. Each place holds both, one seen at a time.
                                        -->
                                        <Grid Margin="10,6,10,0">
                                            <TextBlock x:Name="UpperGamertag" Text="{Binding Gamertag}" Style="{StaticResource StartupText}" FontSize="30" />
                                            <TextBlock x:Name="UpperRealName" Text="{Binding RealName}" Style="{StaticResource StartupText}" FontSize="30"
                                                       Opacity="0" />
                                        </Grid>
                                        <Grid x:Name="Lower" Margin="10,6,10,0" Opacity="0">
                                            <TextBlock x:Name="LowerRealName" Text="{Binding RealName}" Style="{StaticResource StartupText}"
                                                       FontSize="24" Foreground="#D9FFFFFF" />
                                            <TextBlock x:Name="LowerGamertag" Text="{Binding Gamertag}" Style="{StaticResource StartupText}"
                                                       FontSize="24" Foreground="#D9FFFFFF" Opacity="0" />
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource IsFocused}">
                                                    <Binding />
                                                    <Binding Path="DataContext.FocusedProfile" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Lower" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="0.79" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="0.79" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Lower" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>

                                        <!--
                                            The name's swap, while focused with a real name, timed as the Toast's text cycle
                                            (ToastWindow.xaml): each way round for 2.2 s, a 0.3 s crossfade to the other, again;
                                            back as it was once focus moves on. Without a real name the gamertag stays put.
                                        -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Value="True">
                                                    <Condition.Binding>
                                                        <MultiBinding Converter="{StaticResource IsFocused}">
                                                            <Binding />
                                                            <Binding Path="DataContext.FocusedProfile" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        </MultiBinding>
                                                    </Condition.Binding>
                                                </Condition>
                                                <Condition Binding="{Binding RealName, Converter={StaticResource HasText}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="NameSwap">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpperGamertag" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="UpperRealName" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LowerRealName" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LowerGamertag" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1" />
                                                            <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="1" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="NameSwap" />
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--
                        Signing you in: the chosen profile's picture alone, centred, a light running round its ring, 5 out
                        from the picture as on Who's playing today?, its gamertag and "Signing you in" under it.
                    -->
                    <StackPanel VerticalAlignment="Top" Margin="0,340,0,0" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="{x:Static core:StartupPhase.SigningIn}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="410" Height="410" Margin="-5">
                            <ContentPresenter Content="{Binding SigningIn}" ContentTemplate="{StaticResource ProfilePicture}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="404" Height="404" StrokeThickness="7" Stroke="{DynamicResource GlyphLightBrush}" />
                            <!-- The light: a short white arc of the ring, turning. -->
                            <Ellipse Width="404" Height="404" StrokeThickness="7" Stroke="White"
                                     StrokeDashArray="16 200" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SigningSpin" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding SigningIn.Gamertag}" Style="{StaticResource StartupText}" FontSize="30"
                                   FontWeight="SemiBold" Margin="10,6,10,0" />
                        <TextBlock Text="Signing you in" Style="{StaticResource StartupText}" FontSize="26" Margin="10,8,10,0" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- The boot video, full screen on black, letterboxed to its own 16:9. -->
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" Volume="1"
                      Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
