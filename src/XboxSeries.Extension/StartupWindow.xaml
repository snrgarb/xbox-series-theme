<Window x:Class="XboxSeries.Extension.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxSeries.Extension"
        xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
        Title="Xbox Series Start-up"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="Black"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Start-up sequence: opaque, Topmost and full-screen over Playnite as it starts in Fullscreen, and again on
        waking from sleep. It follows the core's StartupState and holds no logic. The boot video plays full screen on
        black; then Who's playing today? and Signing you in, drawn after the console's (docs/reference/startup), over its
        green swirl: dark green with broad bands of lime and green sweeping in from the top right and the bottom left,
        drifting and turning slowly. Who's playing today? has the profiles in a row, centred, each a large round picture
        with its gamertag under it, the focused one bigger in a green ring with the real name under its gamertag too.
        Signing you in has the chosen profile's picture alone in the centre, its gamertag and "Signing you in" under it,
        and a light running round the ring. A picture that is missing or won't load shows the person glyph on green.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The image converter, as Image. -->
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
            <local:SameProfileConverter x:Key="IsFocused" />

            <!--
                The swirl's slow movement, begun while Who's playing today? or Signing you in shows and stopped once the
                window hides, so it never keeps WPF rendering behind Playnite: the whole turning a few degrees back and
                forth, and each corner's bands drifting along their own way at their own pace.
            -->
            <Storyboard x:Key="Swirl">
                <DoubleAnimation Storyboard.TargetName="SwirlTurn" Storyboard.TargetProperty="Angle"
                                 From="-5" To="5" Duration="0:0:22" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TopDrift" Storyboard.TargetProperty="X"
                                 From="-60" To="60" Duration="0:0:13" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="TopDrift" Storyboard.TargetProperty="Y"
                                 From="30" To="-30" Duration="0:0:17" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="BottomDrift" Storyboard.TargetProperty="X"
                                 From="50" To="-50" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="BottomDrift" Storyboard.TargetProperty="Y"
                                 From="-40" To="40" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                    <DoubleAnimation.EasingFunction>
                        <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <!-- Signing you in's light, once round the ring each 1.2 s. -->
                <DoubleAnimation Storyboard.TargetName="SigningSpin" Storyboard.TargetProperty="Angle"
                                 From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
            </Storyboard>

            <Style x:Key="StartupText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!--
                A profile's picture, 380 round: the person glyph on the console's green, under the picture itself, which
                covers it once it loads; null, missing or unreadable, it stays empty and the glyph shows.
            -->
            <DataTemplate x:Key="ProfilePicture" DataType="{x:Type core:Profile}">
                <Grid Width="380" Height="380">
                    <Ellipse Fill="{DynamicResource XboxGreenBrush}" />
                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource XboxIconFont}" FontSize="170" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Picture, Converter={StaticResource Image}, ConverterParameter=380}"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!--
            The green swirl, behind Who's playing today? and Signing you in, filling the screen whatever its aspect: drawn
            1920 × 1080, scaled up a little past the edges so its turning never shows them, and cropped to the screen.
        -->
        <Grid x:Name="SwirlLayer" Opacity="0">
            <Viewbox Stretch="UniformToFill">
                <Canvas Width="1920" Height="1080" ClipToBounds="True">
                    <Canvas.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                            <GradientStop Offset="0" Color="#FF1E2C1C" />
                            <GradientStop Offset="1" Color="#FF0C140B" />
                        </RadialGradientBrush>
                    </Canvas.Background>
                    <Canvas Width="1920" Height="1080" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                <RotateTransform x:Name="SwirlTurn" />
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <!-- The top right's bands: sweeping in from the top, round and away off the right edge. -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="TopDrift" />
                            </Canvas.RenderTransform>
                            <Path Data="M 520,-260 C 600,140 920,250 1360,250 C 1760,250 1960,420 2200,720"
                                  StrokeThickness="300" Opacity="0.9">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF14581A" />
                                        <GradientStop Offset="1" Color="#FF2E8B22" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Path Data="M 600,-260 C 680,90 980,180 1380,180 C 1760,180 1980,330 2240,620"
                                  StrokeThickness="150">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF3E9A24" />
                                        <GradientStop Offset="0.6" Color="#FF8FD13A" />
                                        <GradientStop Offset="1" Color="#FF5CB02A" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Path Data="M 650,-260 C 730,60 1020,130 1400,130 C 1770,130 2000,270 2260,560"
                                  StrokeThickness="46" Opacity="0.85">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF9BE03A" />
                                        <GradientStop Offset="1" Color="#FFC6F25A" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                        </Canvas>

                        <!-- The bottom left's bands: in from the left edge, round and away off the bottom. -->
                        <Canvas>
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="BottomDrift" />
                            </Canvas.RenderTransform>
                            <Path Data="M -300,520 C 60,640 160,880 560,940 C 900,990 1060,1060 1200,1400"
                                  StrokeThickness="320" Opacity="0.9">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF2E8B22" />
                                        <GradientStop Offset="1" Color="#FF14581A" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Path Data="M -300,600 C 40,720 140,960 540,1020 C 860,1070 1000,1140 1120,1460"
                                  StrokeThickness="160">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FF5CB02A" />
                                        <GradientStop Offset="0.4" Color="#FFA6E040" />
                                        <GradientStop Offset="1" Color="#FF3E9A24" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                            <Path Data="M -300,660 C 20,780 120,1020 520,1080 C 830,1130 960,1200 1060,1500"
                                  StrokeThickness="50" Opacity="0.85">
                                <Path.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#FFC6F25A" />
                                        <GradientStop Offset="1" Color="#FF9BE03A" />
                                    </LinearGradientBrush>
                                </Path.Stroke>
                            </Path>
                        </Canvas>
                    </Canvas>

                    <!-- A soft darkening to the centre, where the title and pictures sit. -->
                    <Rectangle Width="1920" Height="1080">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.45" RadiusY="0.55">
                                <GradientStop Offset="0" Color="#88101810" />
                                <GradientStop Offset="1" Color="#00101810" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Canvas>
            </Viewbox>

            <!-- The title and the profiles: laid out 1080 tall at the screen's aspect, as the Overlay is, and scaled to the screen. -->
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Root" Height="1080" Width="1920">
                    <TextBlock Text="Who's playing today?" Style="{StaticResource StartupText}" FontSize="60"
                               VerticalAlignment="Top" Margin="0,150,0,0" />

                    <!--
                        Who's playing today?: the profiles in a row, centred, their pictures centred on the screen's middle.
                        Each is 380 round, drawn at 300 unless focused, when it grows to its full size in its green ring
                        and its real name shows under its gamertag. A row wider than the screen scrolls to keep the
                        focused profile on it.
                    -->
                    <ScrollViewer x:Name="ProfileScroller" VerticalAlignment="Top" Margin="0,340,0,0"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" IsHitTestVisible="False">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="{x:Static core:StartupPhase.WhosPlaying}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl x:Name="ProfileRow" ItemsSource="{Binding Profiles}" HorizontalAlignment="Center"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:Profile}">
                                    <StackPanel Width="400">
                                        <Grid Width="400" Height="400">
                                            <Grid x:Name="Circle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="Grow" ScaleX="0.79" ScaleY="0.79" />
                                                </Grid.RenderTransform>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ProfilePicture}" />
                                                <Ellipse x:Name="Ring" Margin="-9" StrokeThickness="7"
                                                         Stroke="{DynamicResource GlyphLightBrush}" Opacity="0" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock Text="{Binding Gamertag}" Style="{StaticResource StartupText}" FontSize="30"
                                                   Margin="10,6,10,0" />
                                        <TextBlock x:Name="RealName" Text="{Binding RealName}" Style="{StaticResource StartupText}"
                                                   FontSize="24" Foreground="#D9FFFFFF" Margin="10,6,10,0" Opacity="0" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource IsFocused}">
                                                    <Binding />
                                                    <Binding Path="DataContext.FocusedProfile" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="RealName" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="0.79" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="0.79" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                        <DoubleAnimation Storyboard.TargetName="RealName" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Signing you in: the chosen profile's picture alone, centred, a light running round its ring, its gamertag and "Signing you in" under it. -->
                    <StackPanel VerticalAlignment="Top" Margin="0,340,0,0" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="{x:Static core:StartupPhase.SigningIn}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="400" Height="400">
                            <ContentPresenter Content="{Binding SigningIn}" ContentTemplate="{StaticResource ProfilePicture}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="398" Height="398" StrokeThickness="7" Stroke="{DynamicResource GlyphLightBrush}" />
                            <!-- The light: a short white arc of the ring, turning. -->
                            <Ellipse Width="398" Height="398" StrokeThickness="7" Stroke="White"
                                     StrokeDashArray="16 200" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SigningSpin" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="{Binding SigningIn.Gamertag}" Style="{StaticResource StartupText}" FontSize="30"
                                   FontWeight="SemiBold" Margin="10,6,10,0" />
                        <TextBlock Text="Signing you in" Style="{StaticResource StartupText}" FontSize="26" Margin="10,8,10,0" />
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- The boot video, full screen on black, letterboxed to its own 16:9. -->
        <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" Volume="1"
                      Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
