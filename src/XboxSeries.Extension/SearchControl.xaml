<controls:PluginUserControl x:Class="XboxSeries.Extension.SearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False">
    <!--
        Search, as on the console: the search box, a pill across the top showing what is typed; under it the rows of what
        was found, Recently added with nothing typed, else Games and Apps, each gone while empty; and the Console keyboard
        docked at the foot while it is up. Sized from the console's capture at 1080p, and centred rather than placed, as
        the page is 1080 tall but only as wide as the screen's aspect makes it. Its DataContext is the core's SearchState.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visibility" />
            <local:WholeTilesWidthConverter x:Key="WholeTilesWidth" />

            <!-- The console's Search colours, sampled from its capture, so approximate. -->
            <SolidColorBrush x:Key="BoxBrush" Color="#FF2E3136" />
            <SolidColorBrush x:Key="CaptionBrush" Color="#FF3A3D44" />
            <SolidColorBrush x:Key="DimBrush" Color="#FFB4B7BD" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- The rows' headings, in the header font's SemiLight (#77), as the other pages' headings. -->
            <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="350" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <!--
                The search box: a pill, lightening while focused, the accent ring 4 off it carrying the console's green glow
                as a blurred band, its corners the pill's plus the gap and ring.
            -->
            <Style x:Key="SearchBox" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="{StaticResource BoxBrush}" CornerRadius="27" />
                                <ContentPresenter Margin="28,0" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="35"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF44474E" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A row of tiles, slid sideways as focus moves along it, built only as far as it is seen. The tiles sit 24 in
                from the list's edges, which its margin cancels, so their rings and glow aren't cut off there. It shows only
                whole tiles, 7 at most, as many as the width its row has (the page's, less its 74 either side) fits: the
                list ends where the next tile begins, which its ScrollViewer cuts off, while the last shown's ring fits in
                the gap before it.
            -->
            <Style x:Key="TileRow" TargetType="ListBox">
                <Setter Property="Margin" Value="-24,-24,-24,6" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource WholeTilesWidth}}" />
                <Setter Property="local:SlidingRow.Slides" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter Margin="24" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A tile, as the console's search results: rounded, ringed 4 off it while focused, its ring carrying the glow
                band, and drawn over the tiles round it then, so they don't cover the glow.
            -->
            <Style x:Key="Tile" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="240" />
                <Setter Property="Margin" Value="0,0,15,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnTileFocused" />
                <EventSetter Event="KeyDown" Handler="OnTileKeyDown" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnTileClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Grid local:RoundedClip.Radius="6">
                                    <ContentPresenter />
                                </Grid>
                                <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="14" Margin="-8"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                A game: its cover, square, over a grey caption holding its title and, while it's being installed, its state.
                The cover is decoded at twice its 1080p size, for the 4K screen's 2 pixels to a 1080p one, and no larger.
            -->
            <DataTemplate x:Key="GameTile">
                <Grid Background="{StaticResource CaptionBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="240" />
                        <RowDefinition Height="110" />
                    </Grid.RowDefinitions>
                    <Grid Background="#FF1A1A1A">
                        <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=480}"
                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                        <!-- With no cover, its title in its place. -->
                        <TextBlock Text="{Binding Title}" Margin="12" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" FontFamily="{DynamicResource XboxFont}" FontSize="20" Foreground="White">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource Text}" Margin="18,14,18,0"
                               VerticalAlignment="Top" />
                    <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource Text}" FontSize="18"
                               Foreground="{StaticResource DimBrush}" Margin="18,0,18,14" VerticalAlignment="Bottom" />
                </Grid>
            </DataTemplate>

            <!--
                An App, as My games & apps' Apps tiles: square, filled with the accent, its icon centred and its name at the
                bottom left; with no icon, or one that can't be read, a generic app glyph in its place.
            -->
            <DataTemplate x:Key="AppTile">
                <Grid Height="240" Background="{DynamicResource GlyphBrush}">
                    <Image x:Name="Icon" Margin="18,18,18,44"
                           Source="{Binding Icon, Converter={StaticResource Image}, ConverterParameter=480}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                    <Viewbox x:Name="NoIcon" Margin="18,18,18,44" Visibility="Collapsed">
                        <TextBlock Text="&#xECAA;" FontFamily="{DynamicResource XboxIconFont}" Foreground="White" />
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="18"
                               VerticalAlignment="Bottom" Margin="12,0,12,10" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                        <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!--
        Over Home while shown, and opaque: the console's dark page, a green glow at its top left fading to black. The page
        itself takes the pad's shortcuts, the keyboard's typing and the D-pad between its parts.
    -->
    <Grid x:Name="Page" Visibility="{Binding IsShown, Converter={StaticResource Visibility}}"
          PreviewKeyDown="OnPagePreviewKeyDown" KeyDown="OnPageKeyDown" TextInput="OnPageTextInput">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Color="#FF123A2C" Offset="0" />
                <GradientStop Color="#FF07140F" Offset="0.45" />
                <GradientStop Color="#FF000000" Offset="0.8" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The search box, 960 across and centred: what is typed, the caret at the keyboard's cursor while the keyboard is
            up, or the prompt with nothing typed. A on it brings the keyboard back.
        -->
        <Button x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="960" Height="54" Margin="0,77,0,0"
                HorizontalAlignment="Center" Click="OnSearchBoxClick" KeyDown="OnSearchBoxKeyDown">
            <Grid>
                <TextBlock x:Name="Prompt" Text="Search for games and apps" Style="{StaticResource Text}" FontSize="24"
                           Foreground="{StaticResource DimBrush}" Margin="4,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BeforeCaret" Style="{StaticResource Text}" FontSize="24" TextTrimming="None" />
                    <Rectangle x:Name="Caret" Width="2" Height="30" Fill="White" Margin="1,0"
                               Visibility="{Binding IsKeyboardShown, Converter={StaticResource Visibility}}" />
                    <TextBlock x:Name="AfterCaret" Style="{StaticResource Text}" FontSize="24" TextTrimming="None" />
                </StackPanel>
            </Grid>
        </Button>

        <!--
            What was found: a row each, its heading over its tiles, gone while it has nothing. Scrolled up and down as focus
            moves between the rows, which only some fit above the keyboard.
        -->
        <ScrollViewer x:Name="Results" Grid.Row="1" Margin="0,36,0,0" Focusable="False"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="74,0,74,24">
                <StackPanel Visibility="{Binding ShowsRecentlyAdded, Converter={StaticResource Visibility}}">
                    <TextBlock Text="Recently added" Style="{StaticResource HeaderText}" />
                    <ListBox x:Name="RecentRow" ItemsSource="{Binding RecentlyAdded}" Style="{StaticResource TileRow}"
                             ItemContainerStyle="{StaticResource Tile}" ItemTemplate="{StaticResource GameTile}" />
                </StackPanel>
                <StackPanel Visibility="{Binding ShowsGames, Converter={StaticResource Visibility}}">
                    <TextBlock Text="Games" Style="{StaticResource HeaderText}" />
                    <ListBox x:Name="GamesRow" ItemsSource="{Binding Games}" Style="{StaticResource TileRow}"
                             ItemContainerStyle="{StaticResource Tile}" ItemTemplate="{StaticResource GameTile}" />
                </StackPanel>
                <StackPanel Visibility="{Binding ShowsApps, Converter={StaticResource Visibility}}">
                    <TextBlock Text="Apps" Style="{StaticResource HeaderText}" />
                    <ListBox x:Name="AppsRow" ItemsSource="{Binding Apps}" Style="{StaticResource TileRow}"
                             ItemContainerStyle="{StaticResource Tile}" ItemTemplate="{StaticResource AppTile}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The Console keyboard, docked at the foot and centred, while it is up. -->
        <local:ConsoleKeyboardControl x:Name="ConsoleKeys" Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,110"
                                      Visibility="{Binding DataContext.IsKeyboardShown, ElementName=Page, Converter={StaticResource Visibility}}"
                                      KeyChosen="OnKeyChosen" LeftTop="OnKeyboardLeftTop" />
    </Grid>
</controls:PluginUserControl>
