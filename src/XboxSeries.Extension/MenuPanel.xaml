<UserControl x:Class="XboxSeries.Extension.MenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!--
        A menu or prompt (a Dialog), drawn after the console's context menu (the user's capture at ~3:04, Menu on DayZ):
        a dark grey panel with softly rounded corners, the title top left in the regular weight, then full-width rows of
        a white line icon and a label, with no fill at rest. The focused row is filled a little lighter and wears the
        Home tiles' green focus ring. Shared by the Guide and the tile menu, so the two can't drift apart. Sized at 1080p,
        measured on the console's Menu on Call of Duty (720 capture, scaled by 1.5): the panel 450 wide, the title on one
        line cut short with an ellipsis, rows 72 apart with the icon centred 44 in and the label 88 in. The focused row's
        fill runs the panel's full width, and its ring stands 8 out past the panel on both sides, so nothing here or above
        it may clip (MenuPanelXamlTests).
        Collapsed when there is no Dialog, and for a wide one, which WideDialogPanel draws.
    -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWide}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Width="450" Padding="0,0,0,0" Background="#FF2B2B2B" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <!-- A menu's title (the game's name) on one line, cut short as the console's; a prompt's question wraps, to be read whole. -->
            <TextBlock Text="{Binding Title}" Margin="28,33,28,26"
                       FontFamily="{DynamicResource XboxHeaderFont}" FontSize="34" Foreground="White">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="NoWrap" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrompt}" Value="True">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- A prompt's message, under the title. -->
            <TextBlock Text="{Binding Message}" Margin="28,-14,28,20" TextWrapping="Wrap"
                       FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="#B3FFFFFF">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="72" MouseEnter="OnOptionMouseEnter" MouseLeftButtonUp="OnOptionClick">
                            <Border x:Name="Row" Margin="0,7" CornerRadius="2" Background="Transparent" />
                            <StackPanel Orientation="Horizontal" Margin="32,0,20,0" VerticalAlignment="Center">
                                <TextBlock x:Name="Icon" Width="24" FontFamily="{DynamicResource XboxIconFont}" FontSize="22"
                                           Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Margin="32,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="22" Foreground="White" />
                            </StackPanel>
                            <!--
                                As the console's: 4 thick, 76 tall, standing 4 off the fill all round, so 8 out past the panel's
                                left and right edges, carrying the glow band.
                            -->
                            <Border x:Name="FocusRing" Margin="-8,-2" BorderThickness="4" CornerRadius="7"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                <Border Style="{DynamicResource XboxFocusGlowCache}">
                                    <Border Style="{DynamicResource XboxFocusGlow}" />
                                </Border>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#FF404040" />
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <!-- Segoe Fluent Icons / MDL2 Assets glyphs. -->
                            <DataTrigger Binding="{Binding Icon}" Value="Play">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE768;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Quit">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE711;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Cancel">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE72B;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Favourite">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE734;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Unfavourite">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE8D9;" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Icon}" Value="Manage">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE7FC;" />
                            </DataTrigger>
                            <!-- Remove, as a Discord shortcut's Remove shortcut: the bin. -->
                            <DataTrigger Binding="{Binding Icon}" Value="Remove">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE74D;" />
                            </DataTrigger>
                            <!-- Customise, as the tile menu's Customise Home and Customise games & apps: Personalize's brush. -->
                            <DataTrigger Binding="{Binding Icon}" Value="Customise">
                                <Setter TargetName="Icon" Property="Text" Value="&#xE771;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
