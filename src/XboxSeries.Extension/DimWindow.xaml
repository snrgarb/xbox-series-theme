<Window x:Class="XboxSeries.Extension.DimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox Series Idle dim"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Idle screen's dim: a slight black, 40%, over the whole screen and every window on it, Playnite's, its dialogs
        and the Overlay with the Guide, while the screen is idle. Toasts show over it. Whatever is under it stays as it
        was. It never takes focus or the mouse, so the first press goes to Playnite, where the extension swallows it as
        the wake (see IdleInput.cs). It fades in slowly, and out quickly as the screen wakes (see DimWindow.xaml.cs).
    -->
    <Grid x:Name="Shade" Background="#66000000" Opacity="0" />
</Window>
