    </UserControl.Resources>

    <!-- 24 under the Recent row; four 359 x 190 tiles 30 apart spanning its 1526. -->
    <Grid x:Name="Tiles" Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Discord: Discord's blurple, its mark centred. -->
        <Button x:Name="DiscordTile" Grid.Column="0" Style="{StaticResource PromoTile}" Click="OnTileClick" KeyDown="OnTileKeyDown">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF7983F5" Offset="0" />
                    <GradientStop Color="#FF4752C4" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <Path Data="{StaticResource DiscordLogo}" Fill="{DynamicResource XboxTextBrush}" Width="48" Height="48" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Discord" Style="{StaticResource Title}" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- 2. Playnite settings: slate, a gear centred. -->
        <Button x:Name="PlayniteSettingsTile" Grid.Column="2" Style="{StaticResource PromoTile}" Click="OnTileClick" KeyDown="OnTileKeyDown">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF5F6B7A" Offset="0" />
                    <GradientStop Color="#FF2B323C" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Playnite settings" Style="{StaticResource Title}" />
                </StackPanel>
            </Grid>
        </Button>

        <!--
            3. Achievements: green, the trophy centred (U+1F3C6, not in the icon font, so in the body font, as the Guide's),
            the Score total under the title; with no totals there is no subtitle.
        -->
        <Button x:Name="AchievementsTile" Grid.Column="4" Style="{StaticResource PromoTile}" Click="OnTileClick" KeyDown="OnTileKeyDown">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3FA34D" Offset="0" />
                    <GradientStop Color="#FF0E5A1C" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <TextBlock Text="&#x1F3C6;" Style="{StaticResource Glyph}" FontFamily="{DynamicResource XboxFont}" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Achievements" Style="{StaticResource Title}" />
                    <TextBlock Text="{Binding Achievements.Score, StringFormat={}{0:N0} Score}" Foreground="{DynamicResource XboxTextDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Achievements}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Button>

        <!-- 4. Downloads: blue, the download glyph centred, what the Queue holds under the title. -->
        <Button x:Name="DownloadsTile" Grid.Column="6" Style="{StaticResource PromoTile}" Click="OnTileClick" KeyDown="OnTileKeyDown">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3A8EE6" Offset="0" />
                    <GradientStop Color="#FF1A4C8F" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Downloads" Style="{StaticResource Title}" />
                    <TextBlock Foreground="{DynamicResource XboxTextDimBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtitle}">
                                <Setter Property="Text" Value="{Binding QueueCount, StringFormat={}{0} in queue}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQueue}" Value="False">
                                        <Setter Property="Text" Value="Nothing queued" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
