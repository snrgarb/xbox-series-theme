<UserControl x:Class="XboxSeries.Extension.PromoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False">
    <!--
        The console's row of four wide tiles under Home's Recent row (#65): Browse the store, a promo, Best-rated games
        and a second promo. Placeholders with dummy text for now: nothing is read from Playnite, and A does nothing.
        Laid out at the Recent row's 1080p width, in RecentRowControl, which scales the two alike and moves focus in
        and out of the row. Focus only lights a tile, as the console's: the accent ring and its glow, no growing.
    -->
    <UserControl.Resources>
        <!-- A tile: its art (Background) clipped to the console's rounded corners, ringed in the accent when focused. -->
        <Style x:Key="PromoTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid Background="{TemplateBinding Background}" local:RoundedClip.Radius="6">
                                <ContentPresenter />
                            </Grid>
                            <!-- 4 of gap and 4 of ring out from the tile, its corners following the tile's, as Home's game tiles. -->
                            <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="14" Margin="-8"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                <Border Style="{DynamicResource XboxFocusGlowCache}">
                                    <Border Style="{DynamicResource XboxFocusGlow}" />
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile's text, bottom left: its title, and a promo's dimmer subtitle under it. -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxFontSemibold}" />
            <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Caption" TargetType="StackPanel">
            <Setter Property="Margin" Value="18,0,18,14" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- A tile's glyph, centred (Segoe Fluent Icons / MDL2 Assets). -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
            <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <!-- A promo's placeholder art fades to black at its foot, so its text reads over it, as on the console. -->
        <LinearGradientBrush x:Key="PromoScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.35" />
            <GradientStop Color="#CC000000" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- 24 under the Recent row; four 359 x 190 tiles 30 apart spanning its 1526. -->
    <Grid x:Name="Tiles" Margin="0,24,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Browse the store: the store's purple, its glyph centred. -->
        <Button Grid.Column="0" Style="{StaticResource PromoTile}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF9A6CF2" Offset="0" />
                    <GradientStop Color="#FF5B34C9" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <TextBlock Text="&#xE719;" Style="{StaticResource Glyph}" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Browse the store" Style="{StaticResource Title}" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- 2. A promo: art filling the tile (a placeholder gradient), a title and a dimmer subtitle. -->
        <Button Grid.Column="2" Style="{StaticResource PromoTile}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF4C7A9E" Offset="0" />
                    <GradientStop Color="#FF2A4632" Offset="0.6" />
                    <GradientStop Color="#FF1C2A1E" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid Background="{StaticResource PromoScrim}">
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Campaign Early Access" Style="{StaticResource Title}" />
                    <TextBlock Text="Pre-order, play now" Style="{StaticResource Subtitle}" Foreground="{DynamicResource XboxTextDimBrush}" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- 3. Best-rated games: green, five stars centred. -->
        <Button Grid.Column="4" Style="{StaticResource PromoTile}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3FA34D" Offset="0" />
                    <GradientStop Color="#FF0E5A1C" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid>
                <TextBlock Text="&#xE735;&#xE735;&#xE735;&#xE735;&#xE735;" Style="{StaticResource Glyph}" FontSize="30" />
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Best-rated games" Style="{StaticResource Title}" />
                </StackPanel>
            </Grid>
        </Button>

        <!-- 4. A promo, as 2. -->
        <Button Grid.Column="6" Style="{StaticResource PromoTile}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFE0A04A" Offset="0" />
                    <GradientStop Color="#FF8C3B1E" Offset="0.55" />
                    <GradientStop Color="#FF2E1712" Offset="1" />
                </LinearGradientBrush>
            </Button.Background>
            <Grid Background="{StaticResource PromoScrim}">
                <StackPanel Style="{StaticResource Caption}">
                    <TextBlock Text="Pre-order Deluxe Edition" Style="{StaticResource Title}" />
                    <TextBlock Text="Get a month of Ultimate" Style="{StaticResource Subtitle}" Foreground="{DynamicResource XboxTextDimBrush}" />
                </StackPanel>
            </Grid>
        </Button>
    </Grid>
</UserControl>
