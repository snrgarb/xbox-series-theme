<UserControl x:Class="XboxSeries.Extension.PromoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False">
    <!--
        The console's row of four wide tiles under Home's Recent row (#65), each going somewhere the Bundle has rather than
        to the console's store and promos: Discord, Playnite settings, Achievements (its Score total under it) and
        Downloads (what the Queue holds under it). Laid out at the Recent row's 1080p width, in RecentRowControl, which
        scales the two alike and moves focus in and out of the row. Focus only lights a tile, as the console's: the
        accent ring and its glow, no growing.
    -->
    <UserControl.Resources>
        <!-- A tile: its art (Background) clipped to the console's rounded corners, ringed in the accent when focused. -->
        <Style x:Key="PromoTile" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Grid Background="{TemplateBinding Background}" local:RoundedClip.Radius="6">
                                <ContentPresenter />
                            </Grid>
                            <!-- 4 of gap and 4 of ring out from the tile, its corners following the tile's, as Home's game tiles. -->
                            <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="14" Margin="-8"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                <Border Style="{DynamicResource XboxFocusGlowCache}">
                                    <Border Style="{DynamicResource XboxFocusGlow}" />
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile's text, bottom left: its title, and a dimmer subtitle under it on Achievements and Downloads. -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxFontSemibold}" />
            <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Caption" TargetType="StackPanel">
            <Setter Property="Margin" Value="18,0,18,14" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- A tile's glyph, centred (Segoe Fluent Icons / MDL2 Assets). -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
            <Setter Property="Foreground" Value="{DynamicResource XboxTextBrush}" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>

        <!-- Discord's own mark, as the Guide's and the Status area's. -->
