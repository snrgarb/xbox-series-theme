<UserControl x:Class="XboxSeries.Extension.StartUpPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False" KeyDown="OnPaneKeyDown">
    <!--
        Settings' Start up category, as the console's General and Account: a grid of dark boxes two wide, each a line icon
        and its name, opening a page of its own in their place. Its DataContext is the core's StartUpSettingsState; the
        page showing and its header follow the code-behind. In Settings' palette and 1080p units (SettingsControl.xaml).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <local:DecodedImageConverter x:Key="Image" />
            <local:StartUpTextConverter x:Key="StartUpText" />
            <BooleanToVisibilityConverter x:Key="Visibility" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="Foreground" Value="#B3FFFFFF" />
                <Setter Property="FontSize" Value="19" />
            </Style>

            <!-- Segoe Fluent Icons / MDL2 Assets glyphs. -->
            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <!--
                A box, as the console's: a dark rectangle, its line icon (Tag) at the left and its name, with a second line
                saying what it's set to, beside it; filled with the accent while focused, as Settings' rail.
            -->
            <Style x:Key="Box" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="437" />
                <Setter Property="Height" Value="131" />
                <Setter Property="Margin" Value="0,0,18,18" />
                <Setter Property="Padding" Value="100,0,24,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" Background="#FF2D2D2D">
                                <Grid>
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" FontSize="34"
                                               Width="40" HorizontalAlignment="Left" Margin="38,0,0,0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A choice in a list, as Boot video's: the width of two boxes, marked with a tick while it's the one set. -->
            <Style x:Key="Row" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="892" />
                <Setter Property="Height" Value="66" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" Background="#FF2D2D2D">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A profile's picture on a disc: the person glyph on the accent under it, showing for none or one that won't
                load, as Who's playing today? has it. The content is the picture's path.
            -->
            <DataTemplate x:Key="Picture">
                <Grid>
                    <Ellipse Fill="{DynamicResource GlyphLightBrush}" />
                    <Viewbox Margin="22">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" />
                    </Viewbox>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Converter={StaticResource Image}, ConverterParameter=200}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </DataTemplate>

            <!-- A gamerpic to choose, on Picture: its disc, ringed while focused, and ticked while it's the one worn. -->
            <Style x:Key="PictureButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="172" />
                <Setter Property="Height" Value="172" />
                <Setter Property="Margin" Value="0,0,30,30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter Margin="11" />
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource GlyphLightBrush}" StrokeThickness="6" Visibility="Hidden" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <!-- The category: Boot video, Profiles and Who's playing today?, each saying what it's set to. -->
        <UniformGrid x:Name="BoxesPage" Columns="2" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button x:Name="BootVideoBox" Style="{StaticResource Box}" Tag="&#xE714;" Click="OnBoxClick">
                <StackPanel>
                    <TextBlock Text="Boot video" Style="{StaticResource Text}" />
                    <TextBlock Text="{Binding BootVideo, Converter={StaticResource StartUpText}}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Button>
            <Button x:Name="ProfilesBox" Style="{StaticResource Box}" Tag="&#xE716;" Click="OnBoxClick">
                <StackPanel>
                    <TextBlock Text="Profiles" Style="{StaticResource Text}" />
                    <TextBlock Text="{Binding Profiles.Count, Converter={StaticResource StartUpText}, ConverterParameter=Profiles}"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Button>
            <Button x:Name="AskBox" Style="{StaticResource Box}" Tag="&#xE748;" Click="OnBoxClick">
                <StackPanel>
                    <TextBlock Text="Who's playing today?" Style="{StaticResource Text}" />
                    <TextBlock Text="{Binding AskWhosPlaying, Converter={StaticResource StartUpText}, ConverterParameter=Ask}"
                               Style="{StaticResource MutedText}" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Boot video: each generation's, oldest first after Off, the one that plays ticked. -->
        <StackPanel x:Name="BootVideoPage" Visibility="Collapsed">
            <TextBlock Text="Plays as Playnite starts in Fullscreen. Any button skips it."
                       Style="{StaticResource MutedText}" Margin="0,0,0,26" />
            <ItemsControl x:Name="BootVideoRows" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Row}" Click="OnRowClick">
                            <Grid>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Width="30"
                                           HorizontalAlignment="Left" Margin="30,0,0,0"
                                           Visibility="{Binding IsCurrent, Converter={StaticResource Visibility}}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" VerticalAlignment="Center" Margin="84,0,24,0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Profiles: each in a box, its picture, gamertag and real name, then Add profile last. -->
        <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" Focusable="False"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProfileBoxes" Focusable="False" HorizontalAlignment="Left">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type core:Profile}">
                        <Button Style="{StaticResource Box}" Padding="30,0,24,0" Click="OnProfileBoxClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}"
                                                  Width="80" Height="80" />
                                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gamertag}" Style="{StaticResource Text}" />
                                    <TextBlock Text="{Binding RealName}" Style="{StaticResource MutedText}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:AddProfileItem}">
                        <Button Style="{StaticResource Box}" Tag="&#xE8FA;" Click="OnProfileBoxClick">
                            <TextBlock Text="Add profile" Style="{StaticResource Text}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- A profile: its gamertag, real name and picture, each typed or chosen on a page of its own, and Remove. -->
        <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
            <ContentPresenter Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}" Width="120" Height="120"
                              HorizontalAlignment="Left" Margin="0,0,0,30" />
            <UniformGrid Columns="2" HorizontalAlignment="Left">
                <Button x:Name="GamertagBox" Style="{StaticResource Box}" Tag="&#xE8EC;" Click="OnBoxClick">
                    <StackPanel>
                        <TextBlock Text="Gamertag" Style="{StaticResource Text}" />
                        <TextBlock Text="{Binding Gamertag}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RealNameBox" Style="{StaticResource Box}" Tag="&#xE8AC;" Click="OnBoxClick">
                    <StackPanel>
                        <TextBlock Text="Real name" Style="{StaticResource Text}" />
                        <TextBlock Text="{Binding RealName, Converter={StaticResource StartUpText}, ConverterParameter=RealName}"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="PictureBox" Style="{StaticResource Box}" Tag="&#xE8B9;" Click="OnBoxClick">
                    <StackPanel>
                        <TextBlock Text="Picture" Style="{StaticResource Text}" />
                        <TextBlock x:Name="PictureDetail" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveBox" Style="{StaticResource Box}" Tag="&#xE74D;" Click="OnBoxClick">
                    <TextBlock Text="Remove profile" Style="{StaticResource Text}" />
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- Picture: the gamerpics to wear, the Windows account picture first, the one worn ticked. -->
        <DockPanel x:Name="PicturesPage" Visibility="Collapsed">
            <TextBlock x:Name="PicturesHint" DockPanel.Dock="Top" Text="Add images to the Gamerpics folder to choose from more."
                       Style="{StaticResource MutedText}" Margin="0,0,0,26" />
            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PictureButtons" Focusable="False" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PictureButton}" Click="OnPictureClick">
                                <Grid>
                                    <ContentPresenter Content="{Binding Path}" ContentTemplate="{StaticResource Picture}" />
                                    <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsCurrent, Converter={StaticResource Visibility}}">
                                        <Ellipse Fill="{DynamicResource GlyphBrush}" Stroke="#FF1F1F1F" StrokeThickness="3" />
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
