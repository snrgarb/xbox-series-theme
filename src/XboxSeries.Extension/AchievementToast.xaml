<UserControl x:Class="XboxSeries.Extension.AchievementToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
             Width="778" Height="128" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
    <!--
        An achievement's Toast, as the console's rare one (Xbox One's circle-and-pill Toast, still the rare one's on Series):
        a pill 778 by 128, fully rounded, with a brighter circle flush at its left. A rare achievement's is blue, its circle
        holding a spinning diamond; any other's is the Toast's green, its circle a lighter green holding the achievement's
        icon, or a white trophy without one, as for "<n> achievements unlocked". It comes in as a circle alone at the
        pill's centre, popping in with the white Xbox logo, which turns to the diamond flying out from inside the gem, or
        the icon zooming out to its place; then the pill unfurls from behind the circle, which rides its left end out, and
        its text fades in. It pages: the header, "Rare Achievement unlocked - 1%" or "Achievement unlocked", over the Score
        badge, the Score and the achievement's name (gone without a name, leaving the header alone); pushed up for the
        achievement's description, whole, two lines to a page, pushed up again for each page more (skipped without one);
        then cut to "Press (Guide) to view", centred, as the Guide button opens the Guide at Profile & system. A band of
        light sweeps across the pill once on each of the first two pages. It goes as the pill collapses back into the
        circle, which turns dark with the logo, rings bright, and shrinks to a dot. The timeline is in
        AchievementToast.xaml.cs and its pages' times in AchievementPages.cs; everything moves by transforms and opacity
        alone, and the diamond is drawn here, in vectors (CrownFacets and PavilionFacets). Its DataContext is the ToastState.
    -->
    <UserControl.Resources>
        <!--
            One of the eight slices of the diamond's crown, from an edge of its table (23 either side of its middle, at the
            top) down to the girdle (40 either side, 26 below): the star facet hanging from the table edge and a bezel
            either side, in the gem's whites, greys and pale blues, with a white glint over each (Tag "Glint <angle>": it
            flashes as the slice turns past that angle from facing us) and a shade over the slice (Tag "Shade"), darkening
            it as it turns away. The code lays five of these side by side around the gem and turns them (squashing,
            skewing and moving each to where the slice would be seen), so the diamond spins without a picture.
        -->
        <DataTemplate x:Key="CrownFacets">
            <Canvas>
                <Path Data="M -23,0 L 0,13 L 0,26 L -40,26 Z" Fill="#CBD9E6" />
                <Path Data="M 23,0 L 40,26 L 0,26 L 0,13 Z" Fill="#9FBAD3" />
                <Path Data="M -23,0 L 23,0 L 0,13 Z" Fill="#7FAEDB" />
                <Path Data="M -23,0 L 0,13 L 0,26 L -40,26 Z" Fill="White" Tag="Glint -30" />
                <Path Data="M 23,0 L 40,26 L 0,26 L 0,13 Z" Fill="White" Tag="Glint 35" />
                <Path Data="M -23,0 L 23,0 L 0,13 Z" Fill="White" Tag="Glint 5" />
                <Path Data="M -23,0 L 23,0 L 40,26 L -40,26 Z" Fill="#123F66" Tag="Shade" />
                <Path Data="M -23,0 L 0,13 L 23,0 M 0,13 L 0,26" Stroke="#B3FFFFFF" StrokeThickness="0.7" />
            </Canvas>
        </DataTemplate>

        <!--
            The matching slice of the pavilion, from the girdle (40 either side) down to the culet (53 below): a lower
            girdle facet either side of its middle and the main facet between them reaching to the point, the main one the
            deeper blue the gem shows through its middle; with glints and a shade as the crown's.
        -->
        <DataTemplate x:Key="PavilionFacets">
            <Canvas>
                <Path Data="M -40,0 L 0,0 L 0,24 Z" Fill="#E2EAF2" />
                <Path Data="M 0,0 L 40,0 L 0,24 Z" Fill="#B4C8DA" />
                <Path Data="M -40,0 L 0,24 L 40,0 L 0,53 Z" Fill="#4F8AC2" />
                <Path Data="M -40,0 L 0,0 L 0,24 Z" Fill="White" Tag="Glint -20" />
                <Path Data="M 0,0 L 40,0 L 0,24 Z" Fill="White" Tag="Glint 25" />
                <Path Data="M -40,0 L 0,24 L 40,0 L 0,53 Z" Fill="White" Tag="Glint -5" />
                <Path Data="M -40,0 L 40,0 L 0,53 Z" Fill="#123F66" Tag="Shade" />
                <Path Data="M -40,0 L 0,24 L 40,0 M 0,0 L 0,24" Stroke="#B3FFFFFF" StrokeThickness="0.7" />
            </Canvas>
        </DataTemplate>

        <!-- The body text, as the console's: Segoe UI at about 28.5 (a cap height of 20), on lines 45 apart. -->
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            The palette: the console's blues for a rare achievement, and their counterparts in green for any other. The
            pill is the Toast's own green, as the banner is, and the circle a lighter green, as much lighter and richer
            than the pill as the rare circle's blue is than its pill's (#0FC60F: the same hue, 14% lighter and 9% more
            saturated). Going, the dark circle is the pill's colour and the halo darker, a little over two thirds as light.
        -->
        <Style x:Key="PillFill" TargetType="Shape">
            <Setter Property="Fill" Value="#0F4E7E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                    <Setter Property="Fill" Value="{DynamicResource XboxGreenBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrightFill" TargetType="Shape">
            <Setter Property="Fill" Value="#0D7FC9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                    <Setter Property="Fill" Value="#0FC60F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkFill" TargetType="Shape">
            <Setter Property="Fill" Value="#0F5180" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                    <Setter Property="Fill" Value="{DynamicResource XboxGreenBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HaloFill" TargetType="Shape">
            <Setter Property="Fill" Value="#0B3456" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                    <Setter Property="Fill" Value="#0B550B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeLetter" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F4E7E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                    <Setter Property="Foreground" Value="{DynamicResource XboxGreenBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            A page of the description: as many of its words as two lines hold, wrapped to the text column, never cut
            short. The code adds one for each page (AchievementPages splits the description) and sets its text, and moves it
            below to wait, unseen, until pushed in (a template's transform would be frozen).
        -->
        <DataTemplate x:Key="DescriptionPage">
            <TextBlock Style="{StaticResource PillText}" LineHeight="45" FontFamily="{DynamicResource XboxFont}" FontSize="28.5"
                       Foreground="White" TextWrapping="Wrap" Opacity="0" Margin="0,0,0,2" />
        </DataTemplate>

        <!-- The achievement's icon, decoded at twice the circle's size, as the Guide's are, for the TV's 4K. -->
        <local:DecodedImageConverter x:Key="Icon" />
    </UserControl.Resources>

    <Grid x:Name="Pill" Width="778" Height="128">
        <!--
            The pill: two round ends and the span between them, all the pill's colour. It unfurls from the circle at its
            centre by moving its ends out as the span widens, so the ends stay round; it is hidden while the circle shows
            alone.
        -->
        <Grid x:Name="Body" Opacity="0">
            <Rectangle x:Name="Span" Margin="64,0" Style="{StaticResource PillFill}" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="SpanWidth" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Ellipse x:Name="LeftEnd" Width="128" Height="128" HorizontalAlignment="Left" Style="{StaticResource PillFill}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LeftEndShift" X="325" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="RightEnd" Width="128" Height="128" HorizontalAlignment="Right" Style="{StaticResource PillFill}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="RightEndShift" X="-325" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!--
            The shine: a soft band of white at 20% at its brightest, leaning "/" as the console's, swept left to right
            across the pill, clipped to it, under the text and the circle.
        -->
        <Grid>
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,778,128" RadiusX="64" RadiusY="64" />
            </Grid.Clip>
            <Rectangle x:Name="Shine" Width="560" HorizontalAlignment="Left" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush MappingMode="Absolute" StartPoint="93,-34" EndPoint="467,162">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.2" Color="#06FFFFFF" />
                        <GradientStop Offset="0.35" Color="#1AFFFFFF" />
                        <GradientStop Offset="0.5" Color="#33FFFFFF" />
                        <GradientStop Offset="0.65" Color="#1AFFFFFF" />
                        <GradientStop Offset="0.8" Color="#06FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="ShineShift" X="-95" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!--
            The text, in a column from 26 past the circle to the pill's radius short of its right end, clipped to the
            pill's height so a page pushed up leaves at its top and the next comes in from its bottom. It fades in as the
            pill unfurls, drifting a little left into place.
        -->
        <Grid x:Name="Pages" Margin="153,4,62,4" ClipToBounds="True" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PagesDrift" X="4" />
            </Grid.RenderTransform>

            <!-- Page 1: the header, then the Score badge, the Score and the name; the header alone, centred, without a name. -->
            <StackPanel x:Name="Page1" VerticalAlignment="Center" Margin="0,0,0,2">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="Page1Shift" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="Header" Style="{StaticResource PillText}" LineHeight="45" FontFamily="{DynamicResource XboxFont}"
                           FontSize="28.5" Foreground="White" TextTrimming="CharacterEllipsis"><Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding Rarity, Mode=OneWay, StringFormat='{} - {0:0.#}%', TargetNullValue=''}" /></TextBlock>
                <DockPanel x:Name="ScoreLine" Height="45">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <!-- The Score badge: a white disc with the "G" cut in, in the pill's colour; gone without a Score. -->
                    <Grid x:Name="Badge" DockPanel.Dock="Left" Width="33.5" Height="33.5" Margin="0,1,11,0" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Score}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Fill="#FCFFFF" />
                        <TextBlock Text="G" FontFamily="{DynamicResource XboxFontSemibold}" FontSize="22" Style="{StaticResource BadgeLetter}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                    </Grid>
                    <TextBlock x:Name="Score" DockPanel.Dock="Left" Text="{Binding Score, StringFormat={}{0} -}"
                               LineHeight="45" FontFamily="{DynamicResource XboxFont}" FontSize="28.5" Foreground="White" Margin="0,0,9,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Score}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="AchievementName" Text="{Binding Detail}" Style="{StaticResource PillText}" LineHeight="45"
                               FontFamily="{DynamicResource XboxFont}" FontSize="28.5" Foreground="White" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>

            <!-- Then the description's pages (DescriptionPage), each pushed up for the next. -->
            <Grid x:Name="Descriptions" />

            <!-- Page 3: the prompt, alone and centred. -->
            <StackPanel x:Name="Prompt" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <TextBlock Text="Press" Style="{StaticResource PillText}" LineHeight="45" FontFamily="{DynamicResource XboxFont}"
                           FontSize="28.5" Foreground="White" />
                <!-- The Guide button. -->
                <Path Data="{DynamicResource SourceXbox}" Fill="White" Width="34" Height="34" Stretch="Uniform" Margin="16,2,22,0"
                      VerticalAlignment="Center" />
                <TextBlock Text="to view" Style="{StaticResource PillText}" LineHeight="45" FontFamily="{DynamicResource XboxFont}"
                           FontSize="28.5" Foreground="White" />
            </StackPanel>
        </Grid>

        <!--
            The circle, a pixel inside the pill's left end and riding it, starting at the pill's centre. From the bottom:
            the dark halo, the bright ring and the dark disc the going shows; the bright circle; the Xbox logo; and a rare
            achievement's gem, clipped first to a disc inside the circle and then to the circle as the diamond flies out, or
            any other's icon, clipped to the circle.
        -->
        <Grid x:Name="Circle" Width="126" Height="126" HorizontalAlignment="Left" Margin="1,0,0,0" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5" Opacity="0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CircleScale" ScaleX="0.4" ScaleY="0.4" />
                    <TranslateTransform x:Name="CircleShift" X="325" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Ellipse x:Name="Halo" Style="{StaticResource HaloFill}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="HaloScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Ring" Style="{StaticResource BrightFill}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RingScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Dark" Style="{StaticResource DarkFill}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="DarkScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Bright" Style="{StaticResource BrightFill}" Opacity="0" />
            <Path x:Name="Logo" Data="{DynamicResource SourceXbox}" Fill="White" Width="70" Height="70" Stretch="Uniform" Opacity="0"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" />
                </Path.RenderTransform>
            </Path>
            <Grid x:Name="Gem" Opacity="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.AchievementUnlocked}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.Clip>
                    <EllipseGeometry Center="63,63" RadiusX="43.5" RadiusY="43.5">
                        <EllipseGeometry.Transform>
                            <ScaleTransform x:Name="GemOpening" CenterX="63" CenterY="63" />
                        </EllipseGeometry.Transform>
                    </EllipseGeometry>
                </Grid.Clip>
                <!-- The inside of the gem, close up, as the logo gives way: a pale disc the diamond flies out of. -->
                <Ellipse x:Name="Inside" Width="87" Height="87">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Offset="0" Color="#F4F8FB" />
                            <GradientStop Offset="0.7" Color="#C9D6E1" />
                            <GradientStop Offset="1" Color="#A9BBCB" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- The diamond, 80 by 79, table up, its five visible slices of crown and pavilion added by the code. -->
                <Canvas x:Name="Diamond" Width="80" Height="79" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="DiamondZoom" ScaleX="3" ScaleY="3" />
                    </Canvas.RenderTransform>
                </Canvas>
            </Grid>
            <!--
                An ordinary achievement's icon filling the circle, clipped round, over the white trophy (U+1F3C6, which the
                icon font lacks, drawn from Segoe UI Symbol's outline in the body font, as the banner's was), which shows
                without an icon, as for "<n> achievements unlocked", or while it loads or if it can't. Both zoom out to
                their place as the diamond flies out (IconZoom), but never spin.
            -->
            <Grid x:Name="Icon" Opacity="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.RareAchievementUnlocked}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.Clip>
                    <EllipseGeometry Center="63,63" RadiusX="63" RadiusY="63" />
                </Grid.Clip>
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IconZoom" ScaleX="3" ScaleY="3" />
                    </Grid.RenderTransform>
                    <TextBlock Text="&#x1F3C6;" FontFamily="{DynamicResource XboxFont}" FontSize="60" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Image, Converter={StaticResource Icon}, ConverterParameter=252}" Stretch="UniformToFill" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
