<controls:PluginUserControl x:Class="XboxSeries.Extension.RecentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        Home's Recent row: up to 7 game tiles, then the Play history tile. Sized from the console captures (H1-H3, #7):
        square tiles of 153 px at 1080p, 30 px apart, sitting on one baseline. The focused tile grows to 245 px and shows
        its title. The growth is sized in code (TileGrowth.cs) so the row's total width never changes as focus
        moves, however fast, and no tile but those growing or shrinking moves.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!--
        Laid out at a fixed 1080p width, the row with a tile focused (8 tiles, 7 gaps and the focus growth), and scaled
        to the width there is, so with a tile focused it spans the top bar on 16:9 and 16:10 screens alike: from the
        avatar's left edge (105) to the notifications button's right edge (105 + its 10 margin). With no tile focused
        the growth widens the gaps instead, so the row still spans it, as on the console. The scale never changes as focus moves. As tall as a focused tile, so focus
        never shifts the row; placed to sit where the console's row does.
    -->
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="105,53,115,0">
        <!-- No layout rounding: rounding each growing tile to whole pixels would nudge the tiles after it. -->
        <StackPanel Orientation="Horizontal" Width="1526" Height="245" UseLayoutRounding="False">
            <ItemsControl x:Name="Tiles" ItemsSource="{Binding RecentRow}" Focusable="False" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource HomeTile}" Tag="{Binding Title}"
                                Content="{Binding}" ContentTemplate="{StaticResource HomeTileArt}"
                                Click="OnTileClick" GotKeyboardFocus="OnTileFocused" LostKeyboardFocus="OnTileLeft" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Play history: a collage of the next 4 played games. It opens My games & apps on Play history. -->
            <!-- With nothing for the collage, the tile shows the history icon instead. -->
            <Button x:Name="PlayHistoryTile" Style="{StaticResource HomeTile}" Tag="Play history" Margin="0"
                    Click="OnPlayHistoryClick" KeyDown="OnPlayHistoryKeyDown">
                <ItemsControl Style="{StaticResource TileCollage}" ItemsSource="{Binding PlayHistory}" Tag="&#xE81C;" />
            </Button>
        </StackPanel>
    </Viewbox>
</controls:PluginUserControl>
