<controls:PluginUserControl x:Class="XboxSeries.Extension.RecentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!-- Home's Recent row: up to 8 game tiles, then the Play history tile. Its look follows the Dashboard's own tiles. -->
    <controls:PluginUserControl.Resources>
        <local:DecodedImageConverter x:Key="Image" />

        <!-- A Home tile: it grows, rings in the accent and shows its title (from Tag) when focused. -->
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="240" />
            <Setter Property="Height" Value="360" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="FocusedOn">
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                                 To="1" BeginTime="0:0:0.05" Duration="0:0:0.15" />
                            </Storyboard>
                            <Storyboard x:Key="FocusedOff">
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <Grid RenderTransformOrigin="0.5,0.5" Background="#FF1A1A1A">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <ContentPresenter />

                            <Border x:Name="TitleBand" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#E6000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{TemplateBinding Tag}" Margin="12,36,12,10"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="56"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="20" Foreground="White" />
                            </Border>

                            <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="6" Margin="-4"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" Opacity="0.9" BlurRadius="24"
                                                      Color="{DynamicResource GlyphColor}" RenderingBias="Quality" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                <Setter Property="Panel.ZIndex" Value="90" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FocusedOn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FocusedOff}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:PluginUserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="93,0,93,0">
        <ItemsControl x:Name="Tiles" ItemsSource="{Binding RecentRow}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource HomeTile}" Tag="{Binding Title}"
                            Click="OnTileClick" GotKeyboardFocus="OnTileFocused">
                        <Grid>
                            <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=360}"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                            <TextBlock Text="{Binding Title}" Margin="16" TextWrapping="Wrap" VerticalAlignment="Center"
                                       TextAlignment="Center" FontFamily="{DynamicResource XboxFont}" FontSize="22" Foreground="White">
                                <TextBlock.Style>
                                    <!-- Only for games with no cover. -->
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="Running" Background="{DynamicResource GlyphBrush}" CornerRadius="3" Padding="8,3"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed">
                                <TextBlock Text="Running" FontFamily="{DynamicResource XboxFont}" FontSize="14" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                            <Setter TargetName="Running" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Play history: a collage of the next 4 played games. It opens My games & apps on Play history once that page exists (#35). -->
        <Button x:Name="PlayHistoryTile" Style="{StaticResource HomeTile}">
            <Grid>
                <ItemsControl ItemsSource="{Binding PlayHistory}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=180}"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" Margin="1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Fill="#80000000" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource XboxIconFont}" FontSize="44"
                               Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="Play history" FontFamily="{DynamicResource XboxFont}" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Button>
    </StackPanel>
</controls:PluginUserControl>
