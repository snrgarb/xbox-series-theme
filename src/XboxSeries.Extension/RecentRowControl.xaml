<controls:PluginUserControl x:Class="XboxSeries.Extension.RecentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        Home's Recent row: up to 7 game tiles, then the Play history tile. Sized from the console captures (H1-H3, #7):
        square tiles of 153 px at 1080p, 30 px apart, sitting on one baseline. The focused tile grows to 245 px and shows
        its title. As focus moves, one tile shrinks while the next grows by the same amount on the same curve, so the
        pair's width never changes and no other tile moves.
    -->
    <controls:PluginUserControl.Resources>
        <local:DecodedImageConverter x:Key="Image" />

        <!--
            Library source icons, as vector paths so they stay sharp however the row is scaled. Path data from
            Simple Icons (CC0, simpleicons.org; Xbox from v9.21.0, the last release to carry it), on a 24x24 box.
        -->
        <Geometry x:Key="SourceSteam">M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z</Geometry>
        <Geometry x:Key="SourceXbox">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>

        <!-- Growing and shrinking share this curve and duration, which is what keeps the other tiles still. -->
        <CubicEase x:Key="TileEase" EasingMode="EaseOut" />

        <!-- A Home tile: square, growing in place, ringed in the accent and titled (from Tag) when focused. -->
        <Style x:Key="HomeTile" TargetType="Button">
            <Setter Property="Width" Value="153" />
            <Setter Property="Height" Value="153" />
            <Setter Property="Margin" Value="0,0,30,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="FocusedOn">
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="245" Duration="0:0:0.2" EasingFunction="{StaticResource TileEase}" />
                                <DoubleAnimation Storyboard.TargetProperty="Height" To="245" Duration="0:0:0.2" EasingFunction="{StaticResource TileEase}" />
                                <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity"
                                                 To="1" BeginTime="0:0:0.05" Duration="0:0:0.15" />
                            </Storyboard>
                            <Storyboard x:Key="FocusedOff">
                                <DoubleAnimation Storyboard.TargetProperty="Width" To="153" Duration="0:0:0.2" EasingFunction="{StaticResource TileEase}" />
                                <DoubleAnimation Storyboard.TargetProperty="Height" To="153" Duration="0:0:0.2" EasingFunction="{StaticResource TileEase}" />
                                <DoubleAnimation Storyboard.TargetName="TitleBand" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <!-- Rounded corners, as on the console: the art, title and ring are all clipped to them. -->
                        <Grid Background="#FF1A1A1A" local:RoundedClip.Radius="6">

                            <ContentPresenter />

                            <!-- A solid black band behind the title, as on the console, so it reads over any art. -->
                            <Border x:Name="TitleBand" VerticalAlignment="Bottom" Opacity="0" IsHitTestVisible="False"
                                    Background="#E6000000">
                                <TextBlock Text="{TemplateBinding Tag}" Margin="12,8,12,9"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52"
                                           FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White" />
                            </Border>

                            <!-- Inside the tile's bounds, so the next tile, drawn after it, can't cover part of it. -->
                            <Border x:Name="FocusRing" BorderThickness="4" CornerRadius="6"
                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource FocusedOn}" />
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource FocusedOff}" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </controls:PluginUserControl.Resources>

    <!--
        Laid out at a fixed 1080p width (7 tiles, Play history and one focused tile's growth) and scaled to the width
        there is, so 8 tiles fit on 16:9 and 16:10 screens alike and the scale never changes as focus moves.
        As tall as a focused tile, so focus never shifts the row; placed to sit where the console's row does.
    -->
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="105,53,105,0">
        <StackPanel Orientation="Horizontal" Width="1526" Height="245">
            <ItemsControl x:Name="Tiles" ItemsSource="{Binding RecentRow}" Focusable="False" VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource HomeTile}" Tag="{Binding Title}"
                                Click="OnTileClick" GotKeyboardFocus="OnTileFocused">
                            <Grid>
                                <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=300}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                <TextBlock Text="{Binding Title}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center"
                                           TextAlignment="Center" FontFamily="{DynamicResource XboxFont}" FontSize="18" Foreground="White">
                                    <TextBlock.Style>
                                        <!-- Only for games with no cover. -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- The game's library source, bottom left like the console's badges; the title replaces it on focus. -->
                                <Path x:Name="SourceIcon" Width="20" Height="20" Margin="10" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="White" Visibility="Collapsed">
                                    <Path.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.8" Color="Black" />
                                    </Path.Effect>
                                </Path>
                                <Border x:Name="Running" Background="{DynamicResource GlyphBrush}" CornerRadius="3" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Visibility="Collapsed">
                                    <TextBlock Text="Running" FontFamily="{DynamicResource XboxFont}" FontSize="13" Foreground="White" />
                                </Border>
                            </Grid>
                        </Button>
                    <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source}" Value="Steam">
                                <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceSteam}" />
                                <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                                <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceXbox}" />
                                <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                <Setter TargetName="SourceIcon" Property="Opacity" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Running" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Play history: a collage of the next 4 played games. It opens My games & apps on Play history once that page exists (#35). -->
            <Button x:Name="PlayHistoryTile" Style="{StaticResource HomeTile}" Tag="Play history" Margin="0">
                <Grid>
                    <ItemsControl x:Name="Collage" ItemsSource="{Binding PlayHistory}" Focusable="False" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="2" Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding CoverImage, Converter={StaticResource Image}, ConverterParameter=150}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" Margin="3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- With nothing for the collage, the tile shows the history icon instead. -->
                    <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource XboxIconFont}" FontSize="40" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=Collage}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>
        </StackPanel>
    </Viewbox>
</controls:PluginUserControl>
