<controls:PluginUserControl x:Class="XboxSeries.Extension.GroupsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        Home's Groups: the screen below the Recent row, which flies in as the Recent row flies out. One row per Group,
        its name over up to 7 game tiles and a See all tile: the Recent row's tiles, growing up on focus the same way, so
        each row is the Recent row's width. The focused Group slides to the top of the screen.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!--
        At the Recent row's fixed 1080p width and scaled the same way, so the two line up at the same size. Short enough
        that the width always sets the scale; Groups past its bottom, or scrolled past its top, are cut off there.
    -->
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="105,40,115,0">
        <!-- 5 px wider each side than the row, cancelled by its margins, so the clip clears the focus ring. -->
        <Grid Width="1536" Height="740" Margin="-5,0" ClipToBounds="True">
            <!--
                On a Canvas, which never cuts its content to its own size: the Groups run on past the bottom, and a layout
                clip on them would slide up with them as they scroll, cutting off the Groups coming into view.
            -->
            <Canvas>
                <ItemsControl x:Name="Rows" ItemsSource="{Binding Groups}" Focusable="False" Width="1526" Canvas.Left="5">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="Scroll" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="{Binding Name}" Margin="0,0,0,12" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource XboxFontSemibold}" FontSize="24" Foreground="White" />

                                <!--
                                    As tall as a focused tile, so focus never shifts the rows or the name above them: the tiles
                                    sit on its bottom and grow up into it. No layout rounding: rounding each growing tile to whole
                                    pixels would nudge the tiles after it.
                                -->
                                <StackPanel Orientation="Horizontal" Height="245" UseLayoutRounding="False">
                                    <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False" VerticalAlignment="Bottom">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource HomeTile}" Tag="{Binding Title}"
                                                        Content="{Binding}" ContentTemplate="{StaticResource HomeTileArt}"
                                                        Click="OnTileClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- See all: the whole Group, in My games & apps once that page exists (#37). -->
                                    <Button Style="{StaticResource HomeTile}" Tag="See all" Margin="0">
                                        <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource XboxIconFont}" FontSize="40"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Grid>
    </Viewbox>
</controls:PluginUserControl>
