<controls:PluginUserControl x:Class="XboxSeries.Extension.GroupsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        Home's Groups, below the Recent row: one row per Group, its name over up to 10 game tiles and a See all tile.
        The tiles are the Recent row's, at its size at rest; they don't grow on focus, which only rings and titles them.
        A row longer than the screen scrolls sideways as focus moves along it.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!-- At the Recent row's fixed 1080p width and scaled the same way, so the two line up at the same size. -->
    <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="105,0,115,0">
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Groups}" Width="1526" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,48">
                        <TextBlock Text="{Binding Name}" Margin="0,0,0,14" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource XboxFontSemibold}" FontSize="24" Foreground="White" />

                        <!-- Room around the tiles, inside the clip, for the focus ring that sits just past them. -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" Margin="-6">
                            <StackPanel Orientation="Horizontal" Margin="6">
                                <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource HomeTile}" Tag="{Binding Title}"
                                                    Content="{Binding}" ContentTemplate="{StaticResource HomeTileArt}"
                                                    Click="OnTileClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- See all: the whole Group, in My games & apps once that page exists (#37). -->
                                <Button Style="{StaticResource HomeTile}" Tag="See all" Margin="0">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{DynamicResource XboxIconFont}" FontSize="40"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Viewbox>
</controls:PluginUserControl>
