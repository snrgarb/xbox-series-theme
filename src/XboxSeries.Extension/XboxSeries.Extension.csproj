<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Generic extension: the only project that references the Playnite SDK. It wires real adapters to the core. -->
  <PropertyGroup>
    <RootNamespace>XboxSeries.Extension</RootNamespace>
    <UseWPF>true</UseWPF>
    <PluginGuid>eb759ff1-325b-4c34-9a64-d9704f72612b</PluginGuid>
    <ExtensionId>XboxSeries_$(PluginGuid)</ExtensionId>
    <ThemeId>XboxSeries_Dashboard</ThemeId>
    <DashboardDir>$(RepoRoot)src\XboxSeries.Dashboard\</DashboardDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Playnite provides Playnite.SDK.dll at runtime, so it is never copied into the package. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <!-- Windows.Gaming.Input, for pad 1's battery over Bluetooth, which XInput doesn't report. Windows provides it at runtime. -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XboxSeries.Core\XboxSeries.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="extension.yaml" />
    <AssemblyMetadata Include="PluginGuid" Value="$(PluginGuid)" />
  </ItemGroup>
  <!--
    The Windows SDK contracts bring .NET Standard facades into the build, which the XAML compiler needs. They aren't
    copied out: .NET Framework 4.7.2 and later, which Playnite runs on, have them built in.
  -->
  <Target Name="KeepNETStandardFacadesOutOfThePackage" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(FullPath)').Contains('Microsoft.NET.Build.Extensions'))" />
    </ItemGroup>
  </Target>
  <Import Project="$(RepoRoot)build\Bundle.targets" />
</Project>
