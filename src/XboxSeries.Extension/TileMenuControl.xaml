<controls:PluginUserControl x:Class="XboxSeries.Extension.TileMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        The tile menu, placed by the Dashboard over the whole of Home: the screen dims, and the menu floats on the
        focused tile, overlapping it, as the console's context menu does. Collapsed, and so never in the way, without one.
    -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TileMenu}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Border Background="#99000000" MouseLeftButtonDown="OnDimClick" />
        <Canvas>
            <local:MenuPanel x:Name="Panel" DataContext="{Binding TileMenu}" />
        </Canvas>
    </Grid>
</controls:PluginUserControl>
