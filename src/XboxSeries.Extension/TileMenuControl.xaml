<controls:PluginUserControl x:Class="XboxSeries.Extension.TileMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        The tile menu, placed by the Dashboard over the whole of Home: the screen dims, and the menu sits dead centre,
        as the Guide's do. The dim comes and goes at once; the menu flies up and fades in, and back down and out as it
        closes (TileMenuControl.xaml.cs).
        Collapsed, and so never in the way, without one.
    -->
    <Grid x:Name="Root" Visibility="Collapsed">
        <Border x:Name="Dim" Background="#99000000" MouseLeftButtonDown="OnDimClick" />
        <local:MenuPanel x:Name="Panel" DataContext="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</controls:PluginUserControl>
