<ResourceDictionary x:Class="XboxSeries.Extension.ToastImages"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:XboxSeries.Extension"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        The image on the Toast's tile for each kind of Toast, and whether its tile slides, the one place to change how
        a kind looks: the Toast picks ToastImage.<Kind> and ToastSlide.<Kind> by its ToastState.Kind. Each image is
        drawn white on the tile's lighter green, 96 square. A Toast that carries an image of its own, as a caller's
        avatar or a queued game's cover, shows that over the tile instead, but for the greeting, whose image is its own: the profile's picture.
    -->

    <!--
        Whether the tile slides out from behind the banner's left edge a moment after the banner has grown in, the text
        moving right into its place, and stays there as the banner shrinks out (True), or sits in its place from the
        start (False, as for a kind with no key here). A new kind gets its own ToastSlide.<Kind> here beside its
        ToastImage.<Kind>. The greeting slides, as the console's "Hi X!" shows its line alone at first
        (docs/reference/startup/3-hi-greeting).
    -->
    <sys:Boolean x:Key="ToastSlide.Notification">False</sys:Boolean>
    <sys:Boolean x:Key="ToastSlide.Screenshot">True</sys:Boolean>
    <sys:Boolean x:Key="ToastSlide.Call">False</sys:Boolean>
    <sys:Boolean x:Key="ToastSlide.Greeting">True</sys:Boolean>
    <sys:Boolean x:Key="ToastSlide.Queued">False</sys:Boolean>
    <sys:Boolean x:Key="ToastSlide.Installed">False</sys:Boolean>

    <!-- Discord's mark, 24 units wide (Simple Icons' discord, CC0), as the Guide's Discord tab wears it. -->
    <Geometry x:Key="DiscordLogo">M 20.317 4.3698 a 19.7913 19.7913 0 0 0 -4.8851 -1.5152 .0741 .0741 0 0 0 -.0785 .0371 c -.211 .3753 -.4447 .8648 -.6083 1.2495 -1.8447 -.2762 -3.68 -.2762 -5.4868 0 -.1636 -.3933 -.4058 -.8742 -.6177 -1.2495 a .077 .077 0 0 0 -.0785 -.037 19.7363 19.7363 0 0 0 -4.8852 1.515 .0699 .0699 0 0 0 -.0321 .0277 C .5334 9.0458 -.319 13.5799 .0992 18.0578 a .0824 .0824 0 0 0 .0312 .0561 c 2.0528 1.5076 4.0413 2.4228 5.9929 3.0294 a .0777 .0777 0 0 0 .0842 -.0276 c .4616 -.6304 .8731 -1.2952 1.226 -1.9942 a .076 .076 0 0 0 -.0416 -.1057 c -.6528 -.2476 -1.2743 -.5495 -1.8722 -.8923 a .077 .077 0 0 1 -.0076 -.1277 c .1258 -.0943 .2517 -.1923 .3718 -.2914 a .0743 .0743 0 0 1 .0776 -.0105 c 3.9278 1.7933 8.18 1.7933 12.0614 0 a .0739 .0739 0 0 1 .0785 .0095 c .1202 .099 .246 .1981 .3728 .2924 a .077 .077 0 0 1 -.0066 .1276 12.2986 12.2986 0 0 1 -1.873 .8914 .0766 .0766 0 0 0 -.0407 .1067 c .3604 .698 .7719 1.3628 1.225 1.9932 a .076 .076 0 0 0 .0842 .0286 c 1.961 -.6067 3.9495 -1.5219 6.0023 -3.0294 a .077 .077 0 0 0 .0313 -.0552 c .5004 -5.177 -.8382 -9.6739 -3.5485 -13.6604 a .061 .061 0 0 0 -.0312 -.0286 z M 8.02 15.3312 c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 .9555 -2.4189 2.157 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -.9555 2.4189 -2.1569 2.4189 z m 7.9748 0 c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 .9554 -2.4189 2.1569 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -.946 2.4189 -2.1568 2.4189 Z</Geometry>

    <!-- One of Playnite's notifications: Segoe Fluent Icons / MDL2 Assets' bell, as Home's top bar has it. -->
    <DataTemplate x:Key="ToastImage.Notification">
        <TextBlock Text="&#xE91C;" FontFamily="{DynamicResource XboxIconFont}" FontSize="44" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <!-- A screenshot: Segoe Fluent Icons / MDL2 Assets' camera. -->
    <DataTemplate x:Key="ToastImage.Screenshot">
        <TextBlock Text="&#xE722;" FontFamily="{DynamicResource XboxIconFont}" FontSize="44" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <!-- A call: Discord's mark, when the caller has no avatar. -->
    <DataTemplate x:Key="ToastImage.Call">
        <Path Data="{StaticResource DiscordLogo}" Fill="White" Width="48" Height="48" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <!--
        A game joining the queue, when it has no cover: Segoe Fluent Icons / MDL2 Assets' download arrow, as Manage
        Queue's empty state has it. A game with a cover shows that bare over the tile instead, cropped to the square
        (ToastWindow.xaml).
    -->
    <DataTemplate x:Key="ToastImage.Queued">
        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource XboxIconFont}" FontSize="44" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <!--
        A queued game finishing its install, when it has no cover: Segoe Fluent Icons / MDL2 Assets' play mark. A game
        with a cover shows that bare over the tile instead, as a Queued Toast's does.
    -->
    <DataTemplate x:Key="ToastImage.Installed">
        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource XboxIconFont}" FontSize="44" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>

    <!-- The greeting's picture, loaded at the tile's size. -->
    <local:DecodedImageConverter x:Key="GreetingPicture" />

    <!--
        "Hi X!" as a profile signs in: the profile's picture (the Toast's image) round in the tile, over the person glyph
        on the console's green, which shows while it loads, or if there is none or it can't be read.
    -->
    <DataTemplate x:Key="ToastImage.Greeting">
        <Grid Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Fill="{DynamicResource XboxGreenBrush}" />
            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource XboxIconFont}" FontSize="38" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse>
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Image, Converter={StaticResource GreetingPicture}, ConverterParameter=96}"
                                Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
