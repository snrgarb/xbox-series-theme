<Window x:Class="XboxSeries.Extension.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxSeries.Extension"
        xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
        Title="Xbox Series Toast"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Toast: a strip along the bottom of the screen, above every window, that never takes focus or the mouse, so
        a running game keeps its input. It shows a new Playnite notification, a DM ringing, or a game joining the queue, as the
        console shows its own: a wide, solid Xbox green banner low at the bottom centre, a square tile of lighter green on its left with
        the image for the Toast's kind (the bell, a camera, Discord's mark, a download arrow, a play mark, a bin, sync arrows; see ToastImages.xaml), or in
        its place the Toast's own image, as the caller's avatar or a queued game's cover, bare on the banner,
        and large white text beside it that fades back and forth between the Toast's own line and "Press (Guide) to view",
        but for the start-up's "Hi X!" greeting, which only greets. A Library updated Toast's line has "<n> games added" under it when the update added any.
        It comes in as the console's does: the banner grows from its centre as it fades in over 0.3 s. For a kind whose
        tile slides (ToastSlide.<Kind> in ToastImages.xaml), its text starts at its left where the tile will be, and
        0.7 s after the grow the tile slides out from behind the banner's left edge as it fades in, pushing the text right
        into its place, where it stays as the Toast goes. Any other kind has its tile and text in
        their place from the start. It goes by growing to 1.1, then shrinking to 0.9 as it fades out. The banner is laid
        out at its final size throughout; only render transforms move (see ToastWindow.xaml.cs).
        An achievement's Toast is not the banner but the console's rare achievement pill, shown in its place (Achievement):
        blue with its diamond for a rare one, green with the achievement's icon for any other.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The Xbox sphere, as SourceXbox, and the image converter, as Image. -->
                <local:HomeTiles />
                <!-- The tile's image for each kind, as ToastImage.<Kind>. -->
                <local:ToastImages />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The text's cycle, started on the Toast's line each time the Toast shows and stopped when it has hidden:
                the line for 2.2 s, a 0.3 s crossfade to the prompt, the prompt for 2.2 s, a 0.3 s crossfade back, again.
            -->
            <Storyboard x:Key="TextCycle" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Lines" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:5" Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Prompt" Storyboard.TargetProperty="Opacity" Duration="0:0:5">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:2.2" Value="0" />
                    <LinearDoubleKeyFrame KeyTime="0:0:2.5" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:4.7" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:5" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Laid out 1080 tall at the screen's aspect, as the Overlay is, and scaled to the screen; this is its bottom part. -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Height="{x:Static local:ToastWindow.StripHeight}" Width="1920">
            <!--
                The banner: as wide as the longer of its line and the prompt, which share one place, up to 640, where the
                line ends in an ellipsis (the Guide's Notifications has it whole); the 96 tile and 16 around it make it 128 tall.
                It grows and fades from its centre (Grow, and its opacity); its values here are where the Toast starts.
            -->
            <Border x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
                    MaxWidth="640" CornerRadius="6" Background="{DynamicResource XboxGreenBrush}" Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Grow" ScaleX="0.3" ScaleY="0.3" />
                </Border.RenderTransform>
                <!-- Clipped to the banner's rounded bounds, so the tile slides out from behind its left edge. -->
                <Grid local:RoundedClip.Radius="6">
                    <DockPanel Margin="16,16,32,16">
                        <!--
                            The tile: a lighter tint of the green holding the kind's image, or the Toast's own image bare. Its values
                            here are the slide's start, a tile and its gap (120) to the left, behind the banner's edge, and unseen,
                            whence a kind that slides slides in (TileShift); any other kind's tile is put in its place at once.
                        -->
                        <Grid x:Name="Tile" DockPanel.Dock="Left" Width="96" Height="96" VerticalAlignment="Center" Margin="0,0,24,0"
                              Opacity="0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TileShift" X="-120" />
                            </Grid.RenderTransform>
                            <!-- The lighter green, only under the kind's own image: a Toast with an image of its own shows it bare. -->
                            <Border CornerRadius="4" Background="#26FFFFFF">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <ContentControl Content="{Binding}" Focusable="False" IsTabStop="False">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Notification}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Screenshot}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Screenshot}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Call}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Call}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Greeting}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Greeting}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Queued}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Queued}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Installed}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Installed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Uninstalled}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.Uninstalled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.LibraryUpdated}">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ToastImage.LibraryUpdated}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <!--
                                The Toast's own image, as a caller's avatar or a queued game's cover, filling the tile to its rounded
                                corners over the kind's, which shows while it loads or if it can't; but for the greeting, whose kind's
                                image is round and its own. A cover isn't square, so UniformToFill crops it to the tile: decoded 96
                                wide, a portrait cover fills the width and loses a little top and bottom.
                            -->
                            <Grid local:RoundedClip.Radius="4">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Greeting}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image Source="{Binding Image, Converter={StaticResource Image}, ConverterParameter=96}" Stretch="UniformToFill" />
                            </Grid>
                        </Grid>
                        <!--
                            The text: the Toast's line, on one line, and the prompt in the same place, fading between them. For
                            a kind that slides it starts where the tile will be, 120 to the left, and moves right into its place
                            as the tile slides in, and back as it slides out; for any other kind it is in its place at once.
                        -->
                        <Grid VerticalAlignment="Center">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="TextShift" X="-120" />
                            </Grid.RenderTransform>
                            <!--
                                The line, and under it, for a Library updated Toast alone, its Detail ("<n> games added") when it
                                has one; no other banner kind shows a Detail. They fade together.
                            -->
                            <StackPanel x:Name="Lines" VerticalAlignment="Center">
                                <TextBlock x:Name="Line" Text="{Binding Text}" FontFamily="{DynamicResource XboxFont}" FontSize="34"
                                           Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailLine" Text="{Binding Detail}" FontFamily="{DynamicResource XboxFont}" FontSize="24"
                                           Foreground="White" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.LibraryUpdated}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Detail}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="Prompt" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                                <TextBlock Text="Press" FontFamily="{DynamicResource XboxFont}" FontSize="34" Foreground="White"
                                           VerticalAlignment="Center" />
                                <!-- The Guide button. -->
                                <Path Data="{StaticResource SourceXbox}" Fill="White" Width="32" Height="32" Stretch="Uniform"
                                      Margin="12,2,12,0" VerticalAlignment="Center" />
                                <!--
                                    A Ready to play Toast's press starts its game; any other kind's, an "X was uninstalled"
                                    one's among them, only opens the Guide, to view.
                                -->
                                <TextBlock FontFamily="{DynamicResource XboxFont}" FontSize="34" Foreground="White"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="to view" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ToastKind.Installed}">
                                                    <Setter Property="Text" Value="to start" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
            <!--
                An achievement's Toast in the banner's place: the console's rare achievement pill, blue with its spinning
                diamond for a rare one and green with the achievement's icon for any other, wider than the banner and with a
                timeline of its own (AchievementToast.xaml). Shown, and the banner hidden, for those kinds alone.
            -->
            <local:AchievementToast x:Name="Achievement" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
                                    Visibility="Collapsed" />
        </Grid>
    </Viewbox>
</Window>
