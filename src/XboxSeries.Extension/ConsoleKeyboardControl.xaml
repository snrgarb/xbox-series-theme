<UserControl x:Class="XboxSeries.Extension.ConsoleKeyboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False" PreviewKeyDown="OnBoardPreviewKeyDown" KeyDown="OnBoardKeyDown" KeyUp="OnBoardKeyUp"
             IsKeyboardFocusWithinChanged="OnFocusWithinChanged">
    <!--
        The Console keyboard, as the console's: dark grey keys on a grid of 5 rows by 12 columns (ConsoleKeyboard.Keys),
        the symbols key, the number row and backspace along the top, the cursor's left and right either side of two QWERTY
        rows, Shift and Enter either side of the last, the space bar under it. The side keys are a shade lighter than the
        letters. Each key the pad has a shortcut for carries the button's glyph, as on the console: LT on #+=, X on
        backspace, LB and RB on the arrows, the left stick on Shift, Y on the space bar, Menu on Enter. Sized from the
        console's capture at 1080p: rows 52 apart, letters 70 across and the side columns 114, 4 between keys.
        Its DataContext is the ConsoleKeyboard; it holds no logic, raising KeyChosen for the host to press the key.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The letters' grey, and the side columns' a shade lighter, sampled from the console's capture. -->
            <SolidColorBrush x:Key="KeyBrush" Color="#FF2F3238" />
            <SolidColorBrush x:Key="SideKeyBrush" Color="#FF3A3D44" />
            <SolidColorBrush x:Key="FocusedKeyBrush" Color="#FF555963" />
            <!-- Lighter again while the key is held down, by the mouse, A on it, or the pad button it carries. -->
            <SolidColorBrush x:Key="PressedKeyBrush" Color="#FF7A7E88" />
            <SolidColorBrush x:Key="HintBrush" Color="#FFB4B7BD" />

            <!--
                A key: a dark block filling its cells less 2 all round, lightening while focused and again while held
                down (pressed by the mouse, or IsHeld for the pad's A or the button it carries). The focus ring is the
                board's one ring, moved onto the key focused, so no key carries a glow of its own.
            -->
            <Style x:Key="Key" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Background" Value="{StaticResource SideKeyBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource FocusedKeyBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource PressedKeyBrush}" />
                                </Trigger>
                                <Trigger Property="local:ConsoleKeyboardControl.IsHeld" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource PressedKeyBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Character">
                        <Setter Property="Background" Value="{StaticResource KeyBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Space">
                        <Setter Property="Background" Value="{StaticResource KeyBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The keys, and over them on the same grid the focus ring, moved to the key focused. -->
    <Grid>
        <ItemsControl x:Name="Board" ItemsSource="{Binding Keys}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                            <RowDefinition Height="52" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="114" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="114" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding Row}" />
                    <Setter Property="Grid.Column" Value="{Binding Column}" />
                    <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button x:Name="KeyButton" Style="{StaticResource Key}" Click="OnKeyClick" KeyDown="OnKeyKeyDown"
                            GotKeyboardFocus="OnKeyFocused">
                        <!-- Side by side, as backspace and its X; the two-row keys stack theirs, the glyph over the button. -->
                        <StackPanel x:Name="Face" Orientation="Horizontal">
                            <TextBlock x:Name="Label" Text="{Binding Text}" FontFamily="{DynamicResource XboxFont}" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock x:Name="Glyph" FontFamily="{DynamicResource XboxIconFont}" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            <!-- The space bar's mark, the console's open box under the baseline. -->
                            <Path x:Name="SpaceMark" Data="M0,0 L0,6 L24,6 L24,0" Stroke="White" StrokeThickness="2"
                                  VerticalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />
                            <!-- The pad button that presses it: its letter or name in a ring or a pill, grey but for X's blue and Y's yellow. -->
                            <Border x:Name="Hint" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5"
                                    BorderBrush="{StaticResource HintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="HintText" FontFamily="{DynamicResource XboxFont}" FontSize="12"
                                           Foreground="{StaticResource HintBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <DataTemplate.Triggers>
                        <!-- A key drawn as a glyph has no text, and no line for it either. -->
                        <DataTrigger Binding="{Binding Text}" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Symbols">
                            <Setter TargetName="Label" Property="FontSize" Value="20" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Width" Value="28" />
                            <Setter TargetName="Hint" Property="Height" Value="22" />
                            <Setter TargetName="Hint" Property="CornerRadius" Value="9,9,3,3" />
                            <Setter TargetName="HintText" Property="Text" Value="LT" />
                            <Setter TargetName="HintText" Property="FontSize" Value="10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Backspace">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE750;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="BorderBrush" Value="#FF3F8EF0" />
                            <Setter TargetName="HintText" Property="Foreground" Value="#FF3F8EF0" />
                            <Setter TargetName="HintText" Property="Text" Value="X" />
                            <Setter TargetName="HintText" Property="FontSize" Value="14" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Left">
                            <Setter TargetName="Face" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE76B;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Margin" Value="0,16,0,0" />
                            <Setter TargetName="Hint" Property="Width" Value="32" />
                            <Setter TargetName="Hint" Property="Height" Value="18" />
                            <Setter TargetName="Hint" Property="CornerRadius" Value="5" />
                            <Setter TargetName="HintText" Property="Text" Value="LB" />
                            <Setter TargetName="HintText" Property="FontSize" Value="10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Right">
                            <Setter TargetName="Face" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE76C;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Margin" Value="0,16,0,0" />
                            <Setter TargetName="Hint" Property="Width" Value="32" />
                            <Setter TargetName="Hint" Property="Height" Value="18" />
                            <Setter TargetName="Hint" Property="CornerRadius" Value="5" />
                            <Setter TargetName="HintText" Property="Text" Value="RB" />
                            <Setter TargetName="HintText" Property="FontSize" Value="10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Shift">
                            <Setter TargetName="Face" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE74A;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Margin" Value="0,14,0,0" />
                            <Setter TargetName="HintText" Property="Text" Value="LS" />
                            <Setter TargetName="HintText" Property="FontSize" Value="10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Enter">
                            <Setter TargetName="Face" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE72A;" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Margin" Value="0,14,0,0" />
                            <!-- Menu: three lines in the ring, as the hint bar draws it. -->
                            <Setter TargetName="HintText" Property="Text" Value="&#xE700;" />
                            <Setter TargetName="HintText" Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                            <Setter TargetName="HintText" Property="FontSize" Value="11" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Space">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SpaceMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Hint" Property="BorderBrush" Value="#FFFFB900" />
                            <Setter TargetName="HintText" Property="Foreground" Value="#FFFFB900" />
                            <Setter TargetName="HintText" Property="Text" Value="Y" />
                            <Setter TargetName="HintText" Property="FontSize" Value="14" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            The one focus ring, on the same grid as the keys and moved onto the focused key's cells by the code-behind: the
            key's edge, carrying the console's green glow as a blurred band. One ring for the board, so its glow is drawn
            once rather than kept by every key. Hidden while no key has focus.
        -->
        <Grid IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="114" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="114" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FocusRing" Margin="-1" BorderThickness="3" CornerRadius="4"
                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                <Border Style="{DynamicResource XboxFocusGlowCache}">
                    <Border Style="{DynamicResource XboxFocusGlow}" />
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
