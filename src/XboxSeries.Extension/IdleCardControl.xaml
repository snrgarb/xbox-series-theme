<UserControl x:Class="XboxSeries.Extension.IdleCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False"
             IsHitTestVisible="False"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Opacity="0">
    <!--
        One Idle screen card, centred on the dim, in the Bundle's style: a panel as the Guide's menus and prompts are
        (MenuPanel), dark grey with softly rounded corners and their shadow, its title in the header font and its detail
        in the body font in grey, with their margins. Sized at 1080p, 640 wide, as wide as a Toast's banner may be.
        A game's card leads with its art across the panel's top, 640 by 360, as Home's hero shows it (HeroLayer):
        background art as it is, or a cover blurred and darkened, with the cover itself on it. An achievement's has its
        icon on a rounded square beside the text, as the Guide's recent achievements, over a grey one with the trophy for
        none (or one that won't load). A tip, and a game without art, is text alone. The detail collapses when there is none.
        The DimWindow holds two, crossfading from one card to the next; each starts unseen.
    -->
    <Border x:Name="Panel" Width="640" Background="#FF2B2B2B" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <!-- Clipped to the panel's rounded bounds, so the art's top corners follow the panel's. -->
        <Grid local:RoundedClip.Radius="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--
                The game's art, filled in from the code-behind with a HeroLayer. A cover, blurred and darkened there, reads
                as colour alone, so the cover itself stands on it too, whole and centred, 288 tall (36 clear above and below),
                its corners rounded as a tile's.
            -->
            <Grid x:Name="Art" Height="360" Visibility="Collapsed">
                <Border x:Name="Cover" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <Image x:Name="CoverImage" Height="288" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           local:RoundedClip.Radius="4" />
                </Border>
            </Grid>
            <DockPanel Grid.Row="1" Margin="28,32,28,32">
                <Grid x:Name="Icon" DockPanel.Dock="Left" Width="120" Height="120" Margin="0,0,24,0" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Border CornerRadius="4" Background="#FF4A4A4A">
                        <!-- The trophy, U+1F3C6, isn't in the icon font, so it is in the body font, drawn from Segoe UI Symbol. -->
                        <TextBlock Text="&#x1F3C6;" FontFamily="{DynamicResource XboxFont}" FontSize="52" Foreground="#B3FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush x:Name="IconImage" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <!--
                        A game's or an achievement's name on one line, cut short as a menu's title is; a tip wraps, to be
                        read whole, as a prompt's question does (see IdleCardControl.xaml.cs).
                    -->
                    <TextBlock x:Name="Title" FontFamily="{DynamicResource XboxHeaderFont}" FontSize="33" Foreground="White"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <!-- Under it, at most two lines, cut short after them. -->
                    <TextBlock x:Name="Detail" Margin="0,8,0,0" FontFamily="{DynamicResource XboxFont}" FontSize="22"
                               Foreground="#B3FFFFFF" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineStackingStrategy="BlockLineHeight" LineHeight="30" MaxHeight="60" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
