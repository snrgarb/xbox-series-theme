<controls:PluginUserControl x:Class="XboxSeries.Extension.MyGamesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        My games & apps, as on the console: one flat background, the left nav and a divider, the page's header, Apps'
        tiles and Play history's list. The Games grid is Playnite's own main list, which the Dashboard places beside the nav while
        ShowsGameGrid is true, in the same 1080p units, and which this lays out as the console's grid of square tiles.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visibility" />

            <!-- The console's My games & apps colours, sampled from #7's captures, so approximate. -->
            <SolidColorBrush x:Key="PageBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF303030" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="RowBrush" Color="#FF292929" />
            <SolidColorBrush x:Key="DimBrush" Color="#FF8F8F8F" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Headers, in the header font (#77): the page's heading, Manage Queue's and its sections, Play history's days. -->
            <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
            </Style>

            <Style x:Key="NavText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A nav item's name, a header (#77) in SemiLight, as the page heading: Bahnschrift's Regular reads heavy at
                 nav size. Its count beside it, and Manage's Queue line, stay NavText. -->
            <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource NavText}">
                <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
                <Setter Property="FontWeight" Value="350" />
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Width" Value="44" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A nav item, edge to edge across the nav: its icon, name and any count. The item showing (Tag "Selected")
                is lit and marked by an accent bar on its right edge; the focused one fills with the accent and carries the
                console's green glow as a blurred band. The fill is a Border of its own behind the content, carrying the
                band, so the glow traces only it. The band is blurred once into its own cached parent, which focus shows
                and hides with Hidden, so moving on and off the nav lays the picture on and takes it off rather than
                blurring the band again over the item's width at the 4K screen's size.
            -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Back">
                                    <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="93,0,43,0" />
                                <Border x:Name="Bar" Width="6" HorizontalAlignment="Right"
                                        Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Focused, drawn over the items round it, so their fills don't cover its glow. -->
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The console's flat grey button, filled with the accent and carrying the console's green glow as a blurred
                band when focused. The fill is a Border of its own behind the label, carrying the band, so the glow traces
                only it.
            -->
            <Style x:Key="FooterButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF333333" CornerRadius="2">
                                    <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="26,0,26,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A Play history row: the game's square art, its title, and when it was last played and on what. The focus
                ring sits in the row's own 4 px edge, round the row, so the list's scrolling never clips it, and carries the
                console's green glow as a blurred band, which the list's own edges make room for.
            -->
            <Style x:Key="HistoryRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="176" />
                <Setter Property="Margin" Value="0,0,0,7" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnEntryFocused" />
                <EventSetter Event="LostKeyboardFocus" Handler="OnEntryLeft" />
                <EventSetter Event="KeyDown" Handler="OnEntryKeyDown" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnEntryClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border Margin="4" Background="{StaticResource RowBrush}">
                                    <ContentPresenter />
                                </Border>
                                <!-- As Home's tiles: standing 4 px off the row, inset 4 in the item, its corners 0 + 4 + 4. -->
                                <Border x:Name="FocusRing" Margin="-4" CornerRadius="8" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Focused, drawn over the rows after it, so their backs don't cover its glow. -->
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                An App's tile, after the console's app tiles: square, filled with the accent, the App's icon centred and its
                name at the bottom left. Square from its width, which the grid sets to a fifth of the row. As Games' grid
                tiles: 15 apart, rounded, and ringed 4 px off the tile, its ring carrying the glow band.
            -->
            <Style x:Key="AppTile" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Margin" Value="7.5" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnAppFocused" />
                <EventSetter Event="KeyDown" Handler="OnAppKeyDown" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnAppClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border CornerRadius="6" Background="{DynamicResource GlyphBrush}">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="14" Margin="-8" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Focused, drawn over the tiles round it, so their fill doesn't cover its glow. -->
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                A box, as Settings' and the console's: a dark rectangle, its line icon (Tag) at the left and its name beside
                it. Focused, it lightens, and the accent ring stands 4 off it carrying the console's green glow as a blurred
                band; the ring is a Border of its own, so the glow traces only it.
            -->
            <Style x:Key="Box" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="437" />
                <Setter Property="Height" Value="131" />
                <Setter Property="Padding" Value="100,0,30,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF2D2D2D" />
                                <!-- The icon, centred in the space before the name. -->
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource NavIcon}" FontSize="34"
                                           Width="100" TextAlignment="Center" HorizontalAlignment="Left" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                <!-- 4 of gap and 4 of ring out from the box, as Home's tiles. -->
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="8"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF4A4A4A" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A game in the queue on Manage Queue, as the console's: a wide row, the game's cover at its left. Focused,
                the accent ring stands 4 off it carrying the console's green glow as a blurred band.
            -->
            <Style x:Key="QueueRow" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="250" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="#FF2D2D2D">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="8"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Full library's Sort dropdown, as the console's: a dark box, "Sorted by A–Z" at its left and a chevron at its
                right. Focused, it fills with the accent and carries the console's green glow as a blurred band, as the
                footer's button does.
            -->
            <Style x:Key="SortBox" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="400" />
                <Setter Property="Height" Value="60" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF333333" CornerRadius="2">
                                    <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="22,0,22,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                One of the Sort dropdown's options in its open list: its name, and a tick on the one the grid is in (Tag
                "Selected"). Focused, it fills with the accent and carries the glow band, as the nav's items do.
            -->
            <Style x:Key="SortOption" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="60" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Back">
                                    <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                                <TextBlock x:Name="Tick" Text="&#xE73E;" Style="{StaticResource NavIcon}" FontSize="20"
                                           Margin="18,0,0,0" Visibility="Hidden" />
                                <ContentPresenter Margin="62,0,24,0" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Full library's name box: Playnite's own name filter of the grid, typed into with a keyboard or, from the
                pad's A, Playnite's on-screen keyboard. A dark box as the Sort dropdown beside it, reading "Filter by name"
                from its left while empty, left aligned whatever the page round it inherits, and the search glyph in a
                column of its own at its right, as the dropdown's chevron, so the name never runs under it. Focused, the
                accent ring lies on the box's own edge carrying the console's green glow as a blurred band, the box
                staying dark so the name stays legible: Full library's grid, and its fade painted in the page's colour,
                start only 4 under the row and draw over it, so a ring standing out of the box had its bottom edge painted
                over.
            -->
            <Style x:Key="NameBox" TargetType="TextBox">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="400" />
                <Setter Property="Height" Value="60" />
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="CaretBrush" Value="White" />
                <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="#FF333333" CornerRadius="2" />
                                <TextBlock x:Name="Placeholder" Text="Filter by name" Style="{StaticResource Text}"
                                           Foreground="{StaticResource DimBrush}" TextAlignment="Left" Margin="22,0,14,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Hidden" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="20,0,14,0" VerticalAlignment="Center"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                <TextBlock x:Name="Icon" Grid.Column="1" Text="&#xE721;" Style="{StaticResource NavIcon}"
                                           FontSize="20" Width="Auto" Margin="0,0,22,0" />
                                <Border x:Name="FocusRing" Grid.ColumnSpan="2" BorderThickness="4" CornerRadius="2"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The holder of a cover or queue row: drawn over its neighbours while what it holds is focused, so their backs
                don't cover the ring's glow band.
            -->
            <Style x:Key="RaisedWhenFocused" TargetType="ContentPresenter">
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!-- One flat background over the whole page, as on the console; Playnite's main list draws over it as Games' grid. -->
    <Grid Background="{StaticResource PageBrush}" Visibility="{Binding IsShown, Converter={StaticResource Visibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The nav: the profile, then one item per page section. Focusing an item shows it. -->
        <StackPanel x:Name="NavPane" Grid.Column="0" Margin="0,78,0,0">
            <StackPanel Orientation="Horizontal" Margin="75,0,0,58">
                <Grid Width="54" Height="54">
                    <Ellipse Fill="{DynamicResource GlyphBrush}" />
                    <TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}" Width="Auto" HorizontalAlignment="Center" />
                </Grid>
                <TextBlock Text="{x:Static sys:Environment.UserName}" Style="{StaticResource Text}"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="Nav" KeyDown="OnNavKeyDown">
                <Button x:Name="GamesItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GameCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Games" Style="{StaticResource NavLabel}" />
                    </DockPanel>
                </Button>
                <!-- Hidden when Playnite's Software tools can't be read, rather than showing an Apps that never fills. -->
                <Button x:Name="AppsItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick"
                        Visibility="{Binding HasApps, Converter={StaticResource Visibility}}">
                    <DockPanel>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Apps.Count}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Apps" Style="{StaticResource NavLabel}" />
                    </DockPanel>
                </Button>
                <Button x:Name="PlayHistoryItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlayHistoryCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Play history" Style="{StaticResource NavLabel}" />
                    </DockPanel>
                </Button>
                <Button x:Name="FullLibraryItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FullLibraryCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Full library" Style="{StaticResource NavLabel}" />
                    </DockPanel>
                </Button>

                <!-- The console's line between the nav's lists and Manage. -->
                <Border Height="2" Margin="36,4,58,32" Background="{StaticResource DividerBrush}" />

                <!--
                    Manage, as on the console: its briefcase and name, and while anything is queued a second line under the
                    name, Queue and the queue's count. Lit and barred as one item, both lines.
                -->
                <Button x:Name="ManageItem" Style="{StaticResource NavItem}" Height="Auto" MinHeight="58"
                        GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <StackPanel>
                        <DockPanel Height="58">
                            <TextBlock Text="&#xE821;" Style="{StaticResource NavIcon}" />
                            <TextBlock Text="Manage" Style="{StaticResource NavLabel}" />
                        </DockPanel>
                        <DockPanel Height="40" Margin="44,0,0,10" Visibility="{Binding HasQueue, Converter={StaticResource Visibility}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding QueueCount}" Style="{StaticResource NavText}"
                                       Foreground="{StaticResource DimBrush}" />
                            <TextBlock Text="Queue" Style="{StaticResource NavText}" Foreground="{StaticResource DimBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!--
            The nav's foot: the current download, then the storage ring, as on the console.
        -->
        <StackPanel x:Name="NavFoot" Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="75,0,0,66">
            <!--
                The current download, above All storage, only while one is downloading: its name; its state with the speed
                right-aligned; then how much is down of the whole and the share, without that line while the library can't
                say. Small, as the console's.
            -->
            <StackPanel x:Name="DownloadBlock" DataContext="{Binding CurrentDownload}" Width="301" Margin="0,0,0,34">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Tile.Title}" Style="{StaticResource Text}" FontSize="18" />
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Speed}" Style="{StaticResource Text}" FontSize="18" />
                    <TextBlock Text="{Binding State}" Style="{StaticResource Text}" FontSize="18" />
                </DockPanel>
                <!--
                    Such as "67.80 MB of 3.55 GB, 1.9%"; without the amount, no line at all; a share the library can't give
                    drops its ", " with it (a null skips the StringFormat).
                -->
                <TextBlock FontSize="18" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Amount}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Amount, Mode=OneWay}" /><Run Text="{Binding Percent, Mode=OneWay, StringFormat='{}, {0}'}" />
                </TextBlock>
            </StackPanel>

            <!--
                The storage ring, at the foot of the nav, as on the console: All storage and the space free, beside a thin ring
                filled round from the top by the share used, with that share inside it. Its storage is the drive holding most
                installed games. The code sets the fill's dashes from Storage.
            -->
            <Grid x:Name="StorageRing" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="All storage" Style="{StaticResource NavText}" />
                    <TextBlock Text="{Binding Storage.Free}" Style="{StaticResource NavText}" Margin="0,3,0,0" />
                </StackPanel>
                <Grid Grid.Column="1">
                    <Ellipse Width="95" Height="95" Stroke="{StaticResource SelectedBrush}" StrokeThickness="4" />
                    <Ellipse x:Name="StorageUsed" Width="95" Height="95" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="4"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock Text="{Binding Storage.UsedPercent}" Style="{StaticResource NavText}" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </StackPanel>

        <Border x:Name="NavDivider" Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <!--
            What the nav item shows: its header, and Apps or Play history. As focus moves along the nav it comes in a short
            way from below or above, as on the console, with Playnite's main list as Games' grid (PaneFlyIn).
        -->
        <Grid x:Name="ItemHost" Grid.Column="2" Margin="77,72,170,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bahnschrift SemiLight (350, a face of its own, not a synthesised weight), lighter than the page's other text, as the console's headings are: regular reads heavy at this size. -->
            <TextBlock x:Name="Header" Style="{StaticResource HeaderText}" FontSize="42" FontWeight="350" VerticalAlignment="Top" />
            <TextBlock x:Name="Count" Text="{Binding GameCount, StringFormat='{}{0} games'}" Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,0,0" />

            <!--
                Full library's tabs take focus through this, laid under the Dashboard's tabs (PART_FilterPresetSelector, at
                the top of this row): the active tab is lit as the console lights focus, Left and Right switch the tab as
                LB and RB do, and the tabs themselves, Playnite's own, never take focus, as A on one would apply it again.
            -->
            <Button x:Name="TabsFocus" Grid.Row="1" Height="56" VerticalAlignment="Top" FocusVisualStyle="{x:Null}"
                    Visibility="Collapsed" PreviewKeyDown="OnTabsPreviewKeyDown" KeyDown="OnTabsKeyDown">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!--
                Full library's row between its tabs and its grid, as the console's: the Sort dropdown at the left, then the
                name box while it is open or holds a name, and at the right the count of the games the grid shows and the
                Filter button, which opens the name box, as Y does. Flush with the grid's tiles below it.
            -->
            <DockPanel x:Name="LibraryBar" Grid.Row="1" Height="60" Margin="4,72,4,0" VerticalAlignment="Top"
                       Visibility="Collapsed" LastChildFill="False" KeyDown="OnLibraryBarKeyDown" GotKeyboardFocus="OnLibraryBarFocused"
                       PreviewKeyDown="OnLibraryBarPreviewKeyDown">
                <Button x:Name="SortButton" DockPanel.Dock="Left" Style="{StaticResource SortBox}" Click="OnSortClick">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource NavIcon}" FontSize="18"
                                   Width="Auto" />
                        <TextBlock Text="{Binding SortLabel}" Style="{StaticResource Text}" FontSize="22" />
                    </DockPanel>
                </Button>
                <TextBox x:Name="NameBox" DockPanel.Dock="Left" Style="{StaticResource NameBox}" Margin="24,0,0,0"
                         Visibility="Collapsed" TextChanged="OnNameTyped" GotKeyboardFocus="OnNameBoxFocused"
                         LostKeyboardFocus="OnNameBoxLeft" PreviewKeyDown="OnNameBoxPreviewKeyDown" />
                <Button x:Name="FilterButton" DockPanel.Dock="Right" Style="{StaticResource FooterButton}" Height="60"
                        Click="OnFilterClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource NavIcon}" FontSize="20" Width="Auto" Margin="0,0,14,0" />
                        <TextBlock Text="Filter" Style="{StaticResource Text}" FontSize="22" />
                    </StackPanel>
                </Button>
                <!-- Full library's count: the games its grid shows, under the user's tab and any name. -->
                <TextBlock x:Name="LibraryCount" DockPanel.Dock="Right" Text="{Binding FullLibraryCount, StringFormat='{}{0} games'}"
                           Style="{StaticResource Text}" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                           Margin="0,0,24,0" />
            </DockPanel>

            <!--
                The Sort dropdown's list, opened by A on it, over the grid below: Playnite's main list draws over the page,
                so the list is a popup of its own, opaque. Up and down move through it, A sorts the grid by the option
                focused, and B closes it, focus back on the dropdown either way.
            -->
            <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortButton}" Placement="Bottom" VerticalOffset="8"
                   StaysOpen="True" AllowsTransparency="False" Focusable="False">
                <Border Width="400" Background="#FF2B2B2B" Padding="0,8">
                    <ItemsControl x:Name="SortOptions" ItemsSource="{Binding SortOptions}" Focusable="False"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  PreviewKeyDown="OnSortOptionsPreviewKeyDown" KeyDown="OnSortOptionsKeyDown">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SortOption}" Click="OnSortOptionClick">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="22" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!--
                Play history, in its sections. Virtualized: only the rows on screen are built, and their art read, so a long
                history opens at once. Elsewhere this space is Playnite's main list, placed by the Dashboard.
            -->
            <ListBox x:Name="History" Grid.Row="1" ItemContainerStyle="{StaticResource HistoryRow}" Margin="-24,0"
                     Background="Transparent" BorderThickness="0" Padding="0,0,0,80"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.DirectionalNavigation="Contained"
                     PreviewKeyDown="OnHistoryKeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <!-- The rows sit 24 in from the list's sides, which its margin cancels, so their glow band isn't cut off there. -->
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter Margin="24,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource HeaderText}" FontSize="30" Margin="32,0,0,18" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Margin" Value="0,0,0,24" />
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Background="#FF1A1A1A">
                                <Image Source="{Binding Tile.CoverImage, Converter={StaticResource Image}, ConverterParameter=200}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="22,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tile.Title}" Style="{StaticResource Text}" FontSize="28"
                                           FontFamily="{DynamicResource XboxFontSemibold}" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="{Binding LastPlayed, StringFormat=d, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource Text}" Foreground="{StaticResource DimBrush}" />
                                    <TextBlock Text="{Binding Platform, StringFormat='{}  •  {0}'}" Style="{StaticResource Text}"
                                               Foreground="{StaticResource DimBrush}" />
                                </StackPanel>
                                <!-- A game being installed: Queued or Installing..., as its tile reads on Home. -->
                                <TextBlock Text="{Binding Tile.Status}" Margin="0,8,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tile.Status}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                Apps, five to a row like Games' grid. Not virtualized: a library has a handful of Apps, and their
                icons are read small.
            -->
            <ListBox x:Name="AppsList" Grid.Row="1" ItemsSource="{Binding Apps}" ItemContainerStyle="{StaticResource AppTile}"
                     Margin="-24,-24,-24,0" Background="Transparent" BorderThickness="0" Padding="0,0,0,80"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained" PreviewKeyDown="OnAppsKeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <!--
                            The tiles sit 24 in from the list's top and sides, which its margin cancels, so their ring and glow
                            band aren't cut off there; less their own 7.5 margin, so they are flush with the list's edges.
                        -->
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter Margin="16.5,16.5,16.5,0" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{x:Static local:MyGamesControl.AppsPerRow}" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- The icon fills the tile above the name, at whatever size the tile is. Decoded at twice the
                                 widest a tile gets, for the 4K screen's 2 pixels to a 1080p one, and no larger. -->
                            <Image x:Name="Icon" Margin="18,18,18,44"
                                   Source="{Binding Icon, Converter={StaticResource Image}, ConverterParameter=480}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                            <!-- With no icon, or one that can't be read: a generic app glyph in its place, as large. -->
                            <Viewbox x:Name="NoIcon" Margin="18,18,18,44" Visibility="Collapsed">
                                <TextBlock Text="&#xECAA;" FontFamily="{DynamicResource XboxIconFont}" Foreground="White" />
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="18"
                                       VerticalAlignment="Bottom" Margin="12,0,12,10" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoApps" Grid.Row="1" Text="Software tools you add in Playnite show up here." Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" Margin="28,0,0,0" VerticalAlignment="Top" />

            <TextBlock x:Name="NoHistory" Grid.Row="1" Text="Games you play show up here." Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" Margin="28,0,0,0" VerticalAlignment="Top" />

            <!-- Under Games' grid, as on the console: the way to every game, under the user's own filter. -->
            <StackPanel x:Name="LookingForMore" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="3,0,0,20">
                <TextBlock Text="Looking for more?" Style="{StaticResource Text}" Margin="0,0,0,12" />
                <Button x:Name="SeeFullLibrary" Style="{StaticResource FooterButton}" Click="OnSeeFullLibrary"
                        KeyDown="OnSeeFullLibraryKeyDown">
                    <TextBlock Text="SEE FULL LIBRARY" Style="{StaticResource Text}" FontSize="22" />
                </Button>
            </StackPanel>

            <!--
                Manage: its Queue box, the queue's count at its right while anything is queued. The console's other boxes
                (updates, storage, its settings) have nothing to stand for here. A opens Manage Queue.
            -->
            <Button x:Name="QueueBox" Grid.Row="1" Style="{StaticResource Box}" Tag="&#xE896;" Margin="0,4,0,0"
                    Click="OnQueueBoxClick" KeyDown="OnQueueBoxKeyDown">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding QueueCount}" Style="{StaticResource Text}" FontSize="24"
                               Visibility="{Binding HasQueue, Converter={StaticResource Visibility}}" />
                    <TextBlock Text="Queue" Style="{StaticResource Text}" FontSize="24" />
                </DockPanel>
            </Button>
        </Grid>

        <!--
            Manage Queue, as on the console: a page of its own over the whole of My games & apps, the nav hidden. Recently
            installed's covers, then the queue's rows, the current download first; or, with nothing queued, a box saying
            where they'll show. The console's Pause all and Cancel all aren't here: Steam can't be asked either from outside.
            Focusable itself only for when it has nothing else to focus, so B still reaches the page.
        -->
        <Grid x:Name="QueuePage" Grid.ColumnSpan="3" Background="{StaticResource PageBrush}" Margin="0"
              Focusable="True" FocusVisualStyle="{x:Null}" Visibility="Collapsed" PreviewKeyDown="OnQueuePageKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Manage Queue" Style="{StaticResource HeaderText}" FontSize="42" FontWeight="350"
                       Margin="96,72,96,0" />

            <!-- The rows sit 24 in from the scroller's edges, which its margin cancels, so their ring and glow band aren't cut off there. -->
            <ScrollViewer x:Name="QueueScroll" Grid.Row="1" Margin="72,0,72,0" Focusable="False"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,0,24,80">
                    <!-- Recently installed: the games' covers, as Home's tiles, the focused one titled at its foot. -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentlyInstalled.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Recently installed" Style="{StaticResource HeaderText}" FontSize="30" Margin="0,14,0,14" />
                        <ScrollViewer Margin="-24,0" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="Covers" ItemsSource="{Binding RecentlyInstalled}" Focusable="False" Margin="24"
                                          ItemContainerStyle="{StaticResource RaisedWhenFocused}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeTile}" Width="200" Height="200" Margin="0,0,16,0"
                                                Tag="{Binding Title}" Content="{Binding}" ContentTemplate="{StaticResource HomeTileArt}"
                                                Click="OnCoverClick" GotKeyboardFocus="OnCoverFocused" LostKeyboardFocus="OnCoverLeft" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Installing: one row for each game in the queue, the current download first, then those next up. -->
                    <StackPanel Visibility="{Binding HasQueue, Converter={StaticResource Visibility}}">
                        <TextBlock Text="Installing" Style="{StaticResource HeaderText}" FontSize="30" Margin="0,30,0,30" />
                        <ItemsControl x:Name="QueueRows" Focusable="False" ItemContainerStyle="{StaticResource RaisedWhenFocused}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource QueueRow}" Click="OnQueueRowClick"
                                            GotKeyboardFocus="OnQueueRowFocused" LostKeyboardFocus="OnQueueRowLeft">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Background="#FF1A1A1A">
                                                <Image Source="{Binding Cover, Converter={StaticResource Image}, ConverterParameter=300}"
                                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                            </Grid>
                                            <!--
                                                Its name, bold, and its state; the speed at the right. Then the amount down of
                                                the whole, the share at the right, over a thin white bar on a dim track filled
                                                to that share. Queued, only the share and the empty track.
                                            -->
                                            <Grid Grid.Column="1" Margin="36,38,40,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Entry.Speed}" Style="{StaticResource Text}" FontSize="24"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Entry.Tile.Title}" Style="{StaticResource Text}" FontSize="24"
                                                           FontFamily="{DynamicResource XboxFontSemibold}" FontWeight="Bold"
                                                           Margin="0,0,160,0" />
                                                <TextBlock Grid.Row="1" Text="{Binding Entry.State}" Style="{StaticResource Text}" FontSize="24" />
                                                <DockPanel Grid.Row="2" Margin="0,34,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Entry.Percent}" Style="{StaticResource Text}"
                                                               FontSize="24" />
                                                    <TextBlock Text="{Binding Entry.Amount, StringFormat='Network: {0}'}" Style="{StaticResource Text}"
                                                               FontSize="24" />
                                                </DockPanel>
                                                <Grid Grid.Row="3" Height="5" Margin="0,12,0,0">
                                                    <Border Background="#FF4A4A4A" />
                                                    <Border Background="White" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Entry.Fraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--
                        Nothing queued: in place of Installing, a box with a thin light grey outline and no fill, the download
                        arrow over where the queue will show.
                    -->
                    <Border Height="330" Margin="0,40,0,0" BorderThickness="2" BorderBrush="#FF5C5C5C">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasQueue}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource XboxIconFont}" FontSize="64" Foreground="White"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="When games and apps are installing, you'll see them here" Style="{StaticResource Text}"
                                       FontSize="30" FontWeight="350" Margin="0,40,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</controls:PluginUserControl>
