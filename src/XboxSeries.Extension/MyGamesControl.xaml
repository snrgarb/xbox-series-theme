<controls:PluginUserControl x:Class="XboxSeries.Extension.MyGamesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        My games & apps: the left nav and the page's header, and Play history's list. The Games grid is Playnite's own
        main list, which the Dashboard places beside the nav while ShowsGameGrid is true, in the same 1080p units.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visibility" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- A nav item: its name, lit while its item is showing, ringed in the accent while focused. -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="60" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" CornerRadius="6" Background="Transparent" />
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Text}"
                                           Margin="20,0" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing" CornerRadius="7" Margin="-1" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A Play history row: the game's art, title and last-played date, and its platform on the right. -->
            <Style x:Key="HistoryRow" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="112" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="6" Background="#99000000" />
                                <ContentPresenter />
                                <Border x:Name="FocusRing" CornerRadius="7" Margin="-1" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <Grid Visibility="{Binding IsShown, Converter={StaticResource Visibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The nav: the profile header, then one item per page section. Focusing an item shows it. -->
        <Border Grid.Column="0" Background="#B3101010">
            <StackPanel Margin="40,80,40,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <Grid Width="56" Height="56">
                        <Ellipse Fill="{DynamicResource GlyphBrush}" />
                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource XboxIconFont}" FontSize="26" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{x:Static sys:Environment.UserName}" Style="{StaticResource Text}"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Text="My games &amp; apps" Style="{StaticResource Text}" FontSize="30"
                           FontFamily="{DynamicResource XboxFontSemibold}" Margin="0,0,0,24" />
                <StackPanel x:Name="Nav" KeyDown="OnNavKeyDown">
                    <Button x:Name="GamesItem" Content="Games" Style="{StaticResource NavItem}"
                            GotKeyboardFocus="OnNavFocused" Click="OnNavClick" />
                    <Button x:Name="PlayHistoryItem" Content="Play history" Style="{StaticResource NavItem}"
                            GotKeyboardFocus="OnNavFocused" Click="OnNavClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="60,80,60,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Header" Style="{StaticResource Text}" FontSize="36"
                       FontFamily="{DynamicResource XboxFontSemibold}" VerticalAlignment="Top" />

            <!-- Play history. Elsewhere this space is Playnite's main list, placed by the Dashboard. -->
            <ScrollViewer x:Name="History" Grid.Row="1" Focusable="False"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          PreviewKeyDown="OnHistoryKeyDown">
                <ItemsControl x:Name="Sections" ItemsSource="{Binding PlayHistory}" Focusable="False" Margin="4,4,4,80">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text}" Opacity="0.7" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource HistoryRow}"
                                                    Click="OnEntryClick" GotKeyboardFocus="OnEntryFocused" LostKeyboardFocus="OnEntryLeft">
                                                <Grid Margin="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid local:RoundedClip.Radius="4" Background="#FF1A1A1A">
                                                        <Image Source="{Binding Tile.CoverImage, Converter={StaticResource Image}, ConverterParameter=200}"
                                                               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tile.Title}" Style="{StaticResource Text}" FontSize="24" />
                                                        <TextBlock Text="{Binding LastPlayed, StringFormat='Last played {0:d MMMM yyyy}'}"
                                                                   Style="{StaticResource Text}" FontSize="18" Opacity="0.7" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Platform}" Style="{StaticResource Text}"
                                                               FontSize="18" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,24,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="NoHistory" Grid.Row="1" Text="Games you play show up here." Style="{StaticResource Text}"
                       Opacity="0.7" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</controls:PluginUserControl>
