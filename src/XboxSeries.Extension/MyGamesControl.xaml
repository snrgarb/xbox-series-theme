<controls:PluginUserControl x:Class="XboxSeries.Extension.MyGamesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:glob="clr-namespace:System.Globalization;assembly=mscorlib"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             Focusable="False">
    <!--
        My games & apps, as on the console: one flat background, the left nav and a divider, the page's header, Apps'
        tiles and Play history's list. The Games grid is Playnite's own main list, which the Dashboard places beside the nav while
        ShowsGameGrid is true, in the same 1080p units, and which this lays out as the console's grid of square tiles.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visibility" />

            <!-- The console's My games & apps colours, sampled from #7's captures, so approximate. -->
            <SolidColorBrush x:Key="PageBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF303030" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF262626" />
            <SolidColorBrush x:Key="RowBrush" Color="#FF292929" />
            <SolidColorBrush x:Key="DimBrush" Color="#FF8F8F8F" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NavText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="NavIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="Width" Value="44" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A nav item, edge to edge across the nav: its icon, name and any count. The item showing (Tag "Selected")
                is lit and marked by an accent bar on its right edge; the focused one fills with the accent.
            -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Back" Background="Transparent">
                                <ContentPresenter Margin="93,0,43,0" />
                                <Border x:Name="Bar" Width="6" HorizontalAlignment="Right"
                                        Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The console's flat grey button, filled with the accent when focused. -->
            <Style x:Key="FooterButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Back" Background="#FF333333" Padding="26,0,26,0" CornerRadius="2">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A Play history row: the game's square art, its title, and when it was last played and on what. The focus
                ring sits in the row's own 4 px edge, round the row, so the list's scrolling never clips it.
            -->
            <Style x:Key="HistoryRow" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="176" />
                <Setter Property="Margin" Value="0,0,0,7" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnEntryFocused" />
                <EventSetter Event="LostKeyboardFocus" Handler="OnEntryLeft" />
                <EventSetter Event="KeyDown" Handler="OnEntryKeyDown" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnEntryClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border Margin="4" Background="{StaticResource RowBrush}">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="4" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                An App's tile, after the console's app tiles: square, filled with the accent, the App's icon centred and its
                name at the bottom left. Square from its width, which the grid sets to a fifth of the row. As on a Play
                history row, the focus ring sits in the tile's own 4 px edge, so the list's scrolling never clips it.
            -->
            <Style x:Key="AppTile" TargetType="ListBoxItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="{Binding ActualWidth, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Margin" Value="0,0,14,14" />
                <EventSetter Event="GotKeyboardFocus" Handler="OnAppFocused" />
                <EventSetter Event="KeyDown" Handler="OnAppKeyDown" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnAppClick" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border Margin="4" CornerRadius="3" Background="{DynamicResource GlyphBrush}">
                                    <ContentPresenter />
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="6" BorderThickness="4"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <!-- One flat background over the whole page, as on the console; Playnite's main list draws over it as Games' grid. -->
    <Grid Background="{StaticResource PageBrush}" Visibility="{Binding IsShown, Converter={StaticResource Visibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The nav: the profile, then one item per page section. Focusing an item shows it. -->
        <StackPanel Grid.Column="0" Margin="0,78,0,0">
            <StackPanel Orientation="Horizontal" Margin="75,0,0,58">
                <Grid Width="54" Height="54">
                    <Ellipse Fill="{DynamicResource GlyphBrush}" />
                    <TextBlock Text="&#xE77B;" Style="{StaticResource NavIcon}" Width="Auto" HorizontalAlignment="Center" />
                </Grid>
                <TextBlock Text="{x:Static sys:Environment.UserName}" Style="{StaticResource Text}"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <StackPanel x:Name="Nav" KeyDown="OnNavKeyDown">
                <Button x:Name="GamesItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding GameCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Games" Style="{StaticResource NavText}" />
                    </DockPanel>
                </Button>
                <!-- Hidden when Playnite's Software tools can't be read, rather than showing an Apps that never fills. -->
                <Button x:Name="AppsItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick"
                        Visibility="{Binding HasApps, Converter={StaticResource Visibility}}">
                    <DockPanel>
                        <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Apps.Count}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Apps" Style="{StaticResource NavText}" />
                    </DockPanel>
                </Button>
                <Button x:Name="PlayHistoryItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PlayHistoryCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Play history" Style="{StaticResource NavText}" />
                    </DockPanel>
                </Button>
                <Button x:Name="FullLibraryItem" Style="{StaticResource NavItem}" GotKeyboardFocus="OnNavFocused" Click="OnNavClick">
                    <DockPanel>
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding FullLibraryCount}" Style="{StaticResource NavText}" />
                        <TextBlock Text="Full library" Style="{StaticResource NavText}" />
                    </DockPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!--
            The storage ring, at the foot of the nav, as on the console: All storage and the space free, beside a thin ring
            filled round from the top by the share used, with that share inside it. Its storage is the drive holding most
            installed games. The code sets the fill's dashes from Storage.
        -->
        <Grid x:Name="StorageRing" Grid.Column="0" VerticalAlignment="Bottom" Margin="75,0,0,66">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="All storage" Style="{StaticResource NavText}" />
                <TextBlock Text="{Binding Storage.Free}" Style="{StaticResource NavText}" Margin="0,3,0,0" />
            </StackPanel>
            <Grid Grid.Column="1">
                <Ellipse Width="95" Height="95" Stroke="{StaticResource SelectedBrush}" StrokeThickness="4" />
                <Ellipse x:Name="StorageUsed" Width="95" Height="95" Stroke="{DynamicResource GlyphBrush}" StrokeThickness="4"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="{Binding Storage.UsedPercent}" Style="{StaticResource NavText}" HorizontalAlignment="Center" />
            </Grid>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <Grid Grid.Column="2" Margin="77,72,170,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Header" Style="{StaticResource Text}" FontSize="42" VerticalAlignment="Top" />
            <TextBlock x:Name="Count" Text="{Binding GameCount, StringFormat='{}{0} games'}" Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,0,0" />
            <!-- Full library's count: the games Playnite's main list shows under the user's filter. -->
            <TextBlock x:Name="LibraryCount" Text="{Binding FullLibraryCount, StringFormat='{}{0} games'}"
                       Style="{StaticResource Text}" Foreground="{StaticResource DimBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,0,0" />

            <!--
                Play history, in its sections. Virtualized: only the rows on screen are built, and their art read, so a long
                history opens at once. Elsewhere this space is Playnite's main list, placed by the Dashboard.
            -->
            <ListBox x:Name="History" Grid.Row="1" ItemContainerStyle="{StaticResource HistoryRow}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,0,80"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.DirectionalNavigation="Contained"
                     PreviewKeyDown="OnHistoryKeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="30" Margin="32,0,0,18" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Margin" Value="0,0,0,24" />
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="168" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Background="#FF1A1A1A">
                                <Image Source="{Binding Tile.CoverImage, Converter={StaticResource Image}, ConverterParameter=200}"
                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="22,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tile.Title}" Style="{StaticResource Text}" FontSize="28"
                                           FontFamily="{DynamicResource XboxFontSemibold}" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <TextBlock Text="{Binding LastPlayed, StringFormat=d, ConverterCulture={x:Static glob:CultureInfo.CurrentCulture}}"
                                               Style="{StaticResource Text}" Foreground="{StaticResource DimBrush}" />
                                    <TextBlock Text="{Binding Platform, StringFormat='{}  •  {0}'}" Style="{StaticResource Text}"
                                               Foreground="{StaticResource DimBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--
                Apps, five to a row like Games' grid. Not virtualized: a library has a handful of Apps, and their
                icons are read small.
            -->
            <ListBox x:Name="AppsList" Grid.Row="1" ItemsSource="{Binding Apps}" ItemContainerStyle="{StaticResource AppTile}"
                     Background="Transparent" BorderThickness="0" Padding="0,0,0,80"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained" PreviewKeyDown="OnAppsKeyDown">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{x:Static local:MyGamesControl.AppsPerRow}" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- The icon fills the tile above the name, at whatever size the tile is. Decoded at twice the
                                 widest a tile gets, for the 4K screen's 2 pixels to a 1080p one, and no larger. -->
                            <Image x:Name="Icon" Margin="18,18,18,44"
                                   Source="{Binding Icon, Converter={StaticResource Image}, ConverterParameter=480}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />
                            <!-- With no icon, or one that can't be read: a generic app glyph in its place, as large. -->
                            <Viewbox x:Name="NoIcon" Margin="18,18,18,44" Visibility="Collapsed">
                                <TextBlock Text="&#xECAA;" FontFamily="{DynamicResource XboxIconFont}" Foreground="White" />
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" FontSize="18"
                                       VerticalAlignment="Bottom" Margin="12,0,12,10" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoApps" Grid.Row="1" Text="Software tools you add in Playnite show up here." Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" Margin="28,0,0,0" VerticalAlignment="Top" />

            <TextBlock x:Name="NoHistory" Grid.Row="1" Text="Games you play show up here." Style="{StaticResource Text}"
                       Foreground="{StaticResource DimBrush}" Margin="28,0,0,0" VerticalAlignment="Top" />

            <!-- Under Games' grid, as on the console: the way to every game, under the user's own filter. -->
            <StackPanel x:Name="LookingForMore" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="3,0,0,20">
                <TextBlock Text="Looking for more?" Style="{StaticResource Text}" Margin="0,0,0,12" />
                <Button x:Name="SeeFullLibrary" Style="{StaticResource FooterButton}" Click="OnSeeFullLibrary"
                        PreviewKeyDown="OnSeeFullLibraryKeyDown">
                    <TextBlock Text="SEE FULL LIBRARY" Style="{StaticResource Text}" FontSize="22" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</controls:PluginUserControl>
