<UserControl x:Class="XboxSeries.Extension.PlaynitePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False" KeyDown="OnPaneKeyDown">
    <!--
        Settings' Playnite settings category, as Personalisation: dark boxes two wide, each a line icon and its name alone.
        Download metadata fills in the games missing metadata, reading Cancel while it runs; Playnite settings opens
        Playnite's own restyled Fullscreen Settings window. Update after downloads is a checkbox setting as the console's
        My profile shows one: on a row of its own, its name at the box's left and the checkbox at its right, and while it
        has focus its info beside it, in the second column's place. Its DataContext is the core's PlayniteSettingsState.
        In Settings' palette and 1080p units (SettingsControl.xaml).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SettingsBoxes />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Download metadata: the games missing it, from Playnite's saved sources; A again, or B, cancels a run going. -->
        <Button x:Name="DownloadMetadataBox" Grid.Row="0" Grid.Column="0" Style="{StaticResource Box}" Tag="&#xE896;"
                Click="OnBoxClick">
            <TextBlock x:Name="DownloadMetadataTitle">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text}">
                        <Setter Property="Text" Value="Download metadata" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDownloadingMetadata}" Value="True">
                                <Setter Property="Text" Value="Cancel" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>

        <Button x:Name="PlayniteSettingsBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource Box}" Tag="&#xE713;" Click="OnBoxClick">
            <TextBlock Text="Playnite settings" Style="{StaticResource Text}" />
        </Button>

        <!--
            Update after downloads: the console's checkbox setting, no icon, its name from the box's left, as a profile's
            box starts its picture, and the checkbox, an icon's size, at its right inside the box's padding: the ticked box
            on, the empty square off. A turns it over at once, saved; no page opens.
        -->
        <Button x:Name="UpdateAfterDownloadsBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource Box}" Padding="30,0,24,0"
                Click="OnBoxClick">
            <Grid>
                <TextBlock Text="Update after downloads" Style="{StaticResource Text}" VerticalAlignment="Center" Margin="0,0,50,0" />
                <TextBlock x:Name="UpdateAfterDownloadsCheck" HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="FontSize" Value="34" />
                            <Setter Property="Text" Value="&#xE739;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateAfterDownloads}" Value="True">
                                    <Setter Property="Text" Value="&#xE73A;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <!-- Beside the box while it has focus, top-aligned with it, as the console's. -->
        <TextBlock x:Name="UpdateAfterDownloadsInfo" Grid.Row="1" Grid.Column="1" Style="{StaticResource Text}"
                   Text="Updates every library and downloads missing metadata for new games after a download finishes."
                   TextWrapping="Wrap" TextTrimming="None" Width="400" Margin="30,8,0,0" VerticalAlignment="Top"
                   HorizontalAlignment="Left"
                   Visibility="{Binding IsKeyboardFocused, ElementName=UpdateAfterDownloadsBox, Converter={StaticResource Visibility}}" />
    </Grid>
</UserControl>
