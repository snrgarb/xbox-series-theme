<controls:PluginUserControl x:Class="XboxSeries.Extension.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False">
    <!--
        Settings, as on the console: one flat background, the left rail and a divider, and the category showing beside it
        under its name. In My games & apps' palette and 1080p units, its rail where My games & apps' nav is.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="Visibility" />

            <!-- My games & apps' colours (MyGamesControl.xaml), so approximate. -->
            <SolidColorBrush x:Key="PageBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF303030" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF262626" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RailText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A rail item, edge to edge across the rail, as My games & apps' nav items. The category showing (Tag
                "Selected") is lit and marked by an accent bar on its right edge; the focused item fills with the accent and
                wears the console's faint green glow. The fill is a Border of its own behind the name, so the glow traces only it.
            -->
            <Style x:Key="RailItem" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Back" />
                                <ContentPresenter Margin="75,0,43,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar" Width="6" HorizontalAlignment="Right"
                                        Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Back" Property="Effect" Value="{DynamicResource XboxFocusGlow}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="Foreground" Value="#B3FFFFFF" />
            </Style>

            <!--
                A button in a category: a dark block, filled with the accent and glowing while focused, as the rail's items,
                the fill a Border of its own behind the label. One that does nothing now (Tag False, as Connect without a
                Client ID and Secret) is greyed but keeps its place in the pad's path, so focus never drops off it when it
                stops applying.
            -->
            <Style x:Key="PaneButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF333333" CornerRadius="2" />
                                <ContentPresenter x:Name="Content" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag">
                                    <Trigger.Value>
                                        <sys:Boolean>False</sys:Boolean>
                                    </Trigger.Value>
                                    <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Back" Property="Effect" Value="{DynamicResource XboxFocusGlow}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <Grid Background="{StaticResource PageBrush}" Visibility="{Binding IsShown, Converter={StaticResource Visibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            The rail: the page's name, the Bundle's categories, then under a divider Playnite's own entries, which open its
            windows rather than show beside the rail. Focusing a category shows it.
        -->
        <StackPanel Grid.Column="0" Margin="0,78,0,0">
            <TextBlock Text="Settings" Style="{StaticResource Text}" FontSize="30" Height="54" Margin="75,0,0,58" />
            <StackPanel x:Name="Rail" KeyDown="OnRailKeyDown">
                <Button x:Name="PersonalisationItem" Style="{StaticResource RailItem}" GotKeyboardFocus="OnCategoryFocused">
                    <TextBlock Text="Personalisation" Style="{StaticResource RailText}" />
                </Button>
                <Button x:Name="GuideItem" Style="{StaticResource RailItem}" GotKeyboardFocus="OnCategoryFocused">
                    <TextBlock Text="Guide" Style="{StaticResource RailText}" />
                </Button>
                <Button x:Name="DiscordItem" Style="{StaticResource RailItem}" GotKeyboardFocus="OnCategoryFocused">
                    <TextBlock Text="Discord" Style="{StaticResource RailText}" />
                </Button>
                <Border Height="2" Margin="75,0,43,14" Background="{StaticResource DividerBrush}" />
                <Button x:Name="PlayniteSettingsItem" Style="{StaticResource RailItem}" Click="OnPlayniteEntryClick">
                    <TextBlock Text="Playnite settings" Style="{StaticResource RailText}" />
                </Button>
                <Button x:Name="MorePlayniteOptionsItem" Style="{StaticResource RailItem}" Click="OnPlayniteEntryClick">
                    <TextBlock Text="More Playnite options" Style="{StaticResource RailText}" />
                </Button>
                <!-- Debug builds only, shown by the code-behind: under a second divider, the Debug menu, to try Toasts. -->
                <Border x:Name="DebugDivider" Height="2" Margin="75,0,43,14" Background="{StaticResource DividerBrush}"
                        Visibility="Collapsed" />
                <Button x:Name="DebugItem" Style="{StaticResource RailItem}" Visibility="Collapsed">
                    <TextBlock Text="Debug menu" Style="{StaticResource RailText}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <!-- The category showing: its name, over its options. -->
        <Grid Grid.Column="2" Margin="77,72,170,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="Header" Style="{StaticResource Text}" FontSize="42" VerticalAlignment="Top" />

            <!--
                Personalisation: its boxes, Start up's for now, each opening a page of its own in their place, the header
                following. Right or A on the rail's Personalisation comes in; Left from the first column or B from its
                boxes goes back to it.
            -->
            <local:PersonalisationPane x:Name="PersonalisationPane" Grid.Row="1" Visibility="Collapsed" />

            <!--
                Discord: the checklist for making the user's own Discord application, beside the QR code of the developer
                portal it's made at; its Client ID and Secret, each filled by Paste from the Windows clipboard; Connect and
                Disconnect; and the status line. Right or A on the rail's Discord comes in; Left from the first column or
                B goes back to it.
            -->
            <StackPanel x:Name="DiscordPane" Grid.Row="1" DataContext="{Binding Discord}" Visibility="Collapsed"
                        KeyDown="OnDiscordPaneKeyDown">
                <TextBlock Text="Connect your own Discord application, so the Guide can show you on Discord."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,30" />

                <Grid Margin="0,0,0,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="DiscordSteps" Focusable="False" VerticalAlignment="Top" Margin="0,0,40,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The portal's address as a QR code, to open on a phone, with the address under it. -->
                    <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Top">
                        <Image Source="/XboxSeries.Extension;component/DiscordPortalQr.png" Width="200" Height="200"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PortalUrl}" Style="{StaticResource MutedText}" FontSize="16"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- The application's Client ID, shown, and its Secret, only whether one is saved. -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Client ID" Style="{StaticResource Text}" />
                        <TextBlock Text="{Binding ClientId, TargetNullValue='Not set'}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button x:Name="PasteClientIdButton" Grid.Column="1" Style="{StaticResource PaneButton}" Click="OnDiscordButtonClick">
                        <TextBlock Text="Paste" Style="{StaticResource Text}" />
                    </Button>
                </Grid>
                <Grid Margin="0,0,0,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Client Secret" Style="{StaticResource Text}" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Text" Value="Not set" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClientSecret}" Value="True">
                                            <Setter Property="Text" Value="Saved" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="PasteClientSecretButton" Grid.Column="1" Style="{StaticResource PaneButton}" Click="OnDiscordButtonClick">
                        <TextBlock Text="Paste" Style="{StaticResource Text}" />
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Button x:Name="ConnectButton" Style="{StaticResource PaneButton}" Tag="{Binding CanConnect}"
                            Margin="0,0,20,0" Click="OnDiscordButtonClick">
                        <TextBlock Text="Connect" Style="{StaticResource Text}" />
                    </Button>
                    <Button x:Name="DisconnectButton" Style="{StaticResource PaneButton}" Tag="{Binding CanDisconnect}"
                            Click="OnDiscordButtonClick">
                        <TextBlock Text="Disconnect" Style="{StaticResource Text}" />
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text}" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Debug builds only: buttons that put up Toasts, one a row. Right or A on the rail's Debug menu comes in; Left
                or B goes back to it. The code-behind wires them; in a Release build the pane stays collapsed and out of reach.
            -->
            <StackPanel x:Name="DebugPane" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left">
                <TextBlock Text="Try the Toasts. Each button puts one up as Playnite or Discord would."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,30" />
                <Button x:Name="DebugNotificationButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Notification" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugScreenshotButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Screenshot notification" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugLongButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Long notification" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugThreeButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Three notifications" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugCallButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Call" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugCallAvatarButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Call with avatar" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="DebugCallAvatarFailsButton" Style="{StaticResource PaneButton}" Margin="0,0,0,14">
                    <TextBlock Text="Call, avatar fails" Style="{StaticResource Text}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</controls:PluginUserControl>
