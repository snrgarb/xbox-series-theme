<controls:PluginUserControl x:Class="XboxSeries.Extension.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False">
    <!--
        Settings, as on the console: one flat background, the left rail and a divider, and the category showing beside it
        under its name. In My games & apps' palette and 1080p units, its rail where My games & apps' nav is.
    -->
    <controls:PluginUserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="Visibility" />

            <!-- My games & apps' colours (MyGamesControl.xaml), so approximate. -->
            <SolidColorBrush x:Key="PageBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FF303030" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#FF262626" />

            <Style x:Key="Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Headers, in the header font (#77): Settings' title and the category's heading. -->
            <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="FontFamily" Value="{DynamicResource XboxHeaderFont}" />
            </Style>

            <!-- The rail's names, Settings' nav, headers as My games & apps' nav labels are (#77). -->
            <Style x:Key="RailText" TargetType="TextBlock" BasedOn="{StaticResource HeaderText}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="350" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A rail item, edge to edge across the rail, as My games & apps' nav items. The category showing (Tag
                "Selected") is lit and marked by an accent bar on its right edge; the focused item fills with the accent and
                carries the console's green glow as a blurred band. The fill is a Border of its own behind the name, carrying
                the band, so the glow traces only it.
            -->
            <Style x:Key="RailItem" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Back">
                                    <Border x:Name="Glow" Style="{DynamicResource XboxFocusGlowCache}" Visibility="Hidden">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                                <ContentPresenter Margin="75,0,43,0" VerticalAlignment="Center" />
                                <Border x:Name="Bar" Width="6" HorizontalAlignment="Right"
                                        Background="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource GlyphBrush}" />
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- Focused, drawn over the items round it, so their fills don't cover its glow. -->
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Text}">
                <Setter Property="Foreground" Value="#B3FFFFFF" />
            </Style>

            <!--
                A button in a category: a dark block. Focused, as Personalisation's boxes, it lightens and the accent ring
                stands 3 off it carrying the console's green glow as a blurred band; the ring is a Border of its own, so the
                glow traces only it, its corners the block's plus the gap and ring, and it is drawn over the buttons round it, so they
                don't cover the glow. One that does nothing now (Tag False, as Connect without a Client ID and Secret) is
                greyed but keeps its place in the pad's path, so focus never drops off it when it stops applying.
            -->
            <Style x:Key="PaneButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF333333" CornerRadius="2" />
                                <ContentPresenter x:Name="Content" Margin="30,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- 4 of gap and 4 of ring out from the block, as Home's tiles. -->
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="10"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag">
                                    <Trigger.Value>
                                        <sys:Boolean>False</sys:Boolean>
                                    </Trigger.Value>
                                    <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF4A4A4A" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                A row holding a button, as Discord's Client ID and Secret: drawn over the rows after it while its button is
                focused, so their buttons don't cover the ring's glow.
            -->
            <Style x:Key="RaisedWhenFocused" TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                A dropdown's box, as the Guide's Audio Output and Input (OverlayWindow's DropBox): a box naming the choice,
                a long one cut short, with a chevron at its end. Focused, as the pane's buttons, it lightens and the accent
                ring stands off it carrying the glow. Open (Tag "Open"), focus down in its list, it stays lit, its own edge
                the accent with the glow, a blurred band centred on it, and the chevron points up.
            -->
            <Style x:Key="DropBox" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="58" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" CornerRadius="4" BorderThickness="2" BorderBrush="#80FFFFFF" Background="#14FFFFFF" />
                                <ContentPresenter Margin="18,0,50,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{DynamicResource XboxIconFont}" FontSize="16"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0" />
                                <Border x:Name="OpenEdge" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource GlyphLightBrush}"
                                        Visibility="Hidden">
                                    <!-- The band centred on this thinner edge: half its 2 and 8 more out. -->
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" Margin="-6.5" />
                                    </Border>
                                </Border>
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="12"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Open">
                                    <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                                    <Setter TargetName="OpenEdge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A dropdown's open list, under its box and as wide. Taller than the room left under
                its box, as Show things after's eleven steps, it is cut to that room and scrolls, the focused choice kept in
                view (SettingsControl.OpenDropdown). Its scroller stands out past the list's sides, its choices as far in, so
                a focused choice's ring and glow aren't cut off there.
            -->
            <Style x:Key="DropList" TargetType="Border">
                <Setter Property="Width" Value="560" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Background" Value="#FF2E2E2E" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="DropScroller" TargetType="ScrollViewer">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Margin" Value="-16,0" />
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!--
                A choice in a dropdown's open list, as the Guide's devices: a shorter row, its name cut short when long, the
                one chosen (Tag "Selected") ticked where the Guide's rows have their icon. Focused, it lightens and the accent
                ring stands off it carrying the glow, drawn over the rows round it.
            -->
            <Style x:Key="DropOption" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="60" />
                <Setter Property="Margin" Value="6,0,6,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" CornerRadius="4" Background="Transparent" />
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{DynamicResource XboxIconFont}" FontSize="20"
                                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"
                                           Visibility="Hidden" />
                                <ContentPresenter Margin="52,0,16,0" VerticalAlignment="Center" />
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="12"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Selected">
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#26FFFFFF" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Panel.ZIndex" Value="1" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </controls:PluginUserControl.Resources>

    <Grid Background="{StaticResource PageBrush}" Visibility="{Binding IsShown, Converter={StaticResource Visibility}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="441" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            The rail: the page's name, the Bundle's own settings as one category, Theme settings, then Playnite's own:
            Playnite settings, a category of boxes as Theme settings is, and under a divider, More Playnite options, which
            opens Playnite's main menu rather than show beside the rail. Focusing a category shows it.
        -->
        <StackPanel Grid.Column="0" Margin="0,78,0,0">
            <TextBlock Text="Settings" Style="{StaticResource HeaderText}" FontSize="30" Height="54" Margin="75,0,0,58" />
            <StackPanel x:Name="Rail" KeyDown="OnRailKeyDown">
                <Button x:Name="ThemeSettingsItem" Style="{StaticResource RailItem}" GotKeyboardFocus="OnCategoryFocused">
                    <TextBlock Text="Theme settings" Style="{StaticResource RailText}" />
                </Button>
                <Button x:Name="PlayniteSettingsItem" Style="{StaticResource RailItem}" GotKeyboardFocus="OnCategoryFocused">
                    <TextBlock Text="Playnite settings" Style="{StaticResource RailText}" />
                </Button>
                <!-- More Playnite options is an action, not a category: a divider sets it apart. -->
                <Border x:Name="MoreOptionsDivider" Height="2" Margin="75,0,43,14" Background="{StaticResource DividerBrush}" />
                <Button x:Name="MorePlayniteOptionsItem" Style="{StaticResource RailItem}" Click="OnPlayniteEntryClick">
                    <TextBlock Text="More Playnite options" Style="{StaticResource RailText}" />
                </Button>
                <!-- Debug builds only, shown by the code-behind: under a divider, the Debug menu, to try Toasts and Steam installs. -->
                <Border x:Name="DebugDivider" Height="2" Margin="75,0,43,14" Background="{StaticResource DividerBrush}"
                        Visibility="Collapsed" />
                <Button x:Name="DebugItem" Style="{StaticResource RailItem}" Visibility="Collapsed">
                    <TextBlock Text="Debug menu" Style="{StaticResource RailText}" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource DividerBrush}" />

        <!--
            The category showing: its name, over its options. As focus moves along the rail it comes in a short way from
            below or above, as on the console (PaneFlyIn).
        -->
        <Grid x:Name="CategoryHost" Grid.Column="2" Margin="77,72,170,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="118" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Semilight (350), lighter than the page's other text, as the console's headings are: regular reads heavy at this size. -->
            <TextBlock x:Name="Header" Style="{StaticResource HeaderText}" FontSize="42" FontWeight="350" VerticalAlignment="Top" />

            <!--
                Theme settings: its boxes, Personalisation, Idle, Guide and Discord, each opening its page below in their place,
                the header following (SettingsState.ThemePage). Right or A on the rail's Theme settings comes in; Left
                from the first column or B from its boxes goes back to it. On a page, B, or Left from its first column,
                goes back to the boxes, focus on the one it came from.
            -->
            <local:ThemeSettingsPane x:Name="ThemeSettingsPane" Grid.Row="1" Visibility="Collapsed" />

            <!--
                Theme settings > Personalisation: its boxes, Start up's for now, each opening a page of its own in their
                place, the header following; B steps back a page at a time, then from its boxes to Theme settings'.
            -->
            <local:PersonalisationPane x:Name="PersonalisationPane" Grid.Row="1" Visibility="Collapsed" />

            <!--
                Theme settings > Idle: how long with nothing pressed before the screen dims, and before the Idle screen
                shows things, each a dropdown as the Guide page's Now Playing source is, from the core's IdleState. Each
                box and its list are raised together while focus is in them, so Dim after's open list lies over Show things
                after. The core keeps Show things after no shorter than Dim after, leaving the shorter steps out of its
                list. A on Theme settings' Idle comes in; Left or B goes back to it.
            -->
            <StackPanel x:Name="IdlePane" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" Width="560"
                        KeyDown="OnIdlePaneKeyDown">
                <Grid Style="{StaticResource RaisedWhenFocused}" Margin="0,0,0,40">
                    <StackPanel>
                        <TextBlock Text="Dim after" Style="{StaticResource Text}" Margin="0,0,0,14" />
                        <Button x:Name="DimAfterBox" Style="{StaticResource DropBox}" Click="OnDropBoxClick">
                            <TextBlock x:Name="DimAfterText" Style="{StaticResource Text}" />
                        </Button>
                        <Canvas Height="0" Margin="0,8,0,0">
                            <Border x:Name="DimAfterList" Style="{StaticResource DropList}" Visibility="Collapsed">
                                <ScrollViewer Style="{StaticResource DropScroller}">
                                    <StackPanel x:Name="DimAfterOptions" Margin="16,8" />
                                </ScrollViewer>
                            </Border>
                        </Canvas>
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource RaisedWhenFocused}">
                    <StackPanel>
                        <TextBlock Text="Show things after" Style="{StaticResource Text}" Margin="0,0,0,14" />
                        <Button x:Name="ShowThingsAfterBox" Style="{StaticResource DropBox}" Click="OnDropBoxClick">
                            <TextBlock x:Name="ShowThingsAfterText" Style="{StaticResource Text}" />
                        </Button>
                        <Canvas Height="0" Margin="0,8,0,0">
                            <Border x:Name="ShowThingsAfterList" Style="{StaticResource DropList}" Visibility="Collapsed">
                                <ScrollViewer Style="{StaticResource DropScroller}">
                                    <StackPanel x:Name="ShowThingsAfterOptions" Margin="16,8" />
                                </ScrollViewer>
                            </Border>
                        </Canvas>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--
                Theme settings > Guide: its behaviour options, the Now Playing source for now, a dropdown as the Guide's
                Audio Output and Input are: which app the Audio flyout's Now Playing follows. Its list opens under the box
                and as wide, laid over what is below rather than pushing it down: the Canvas takes no height. A on Theme
                settings' Guide comes in; Left or B goes back to it.
            -->
            <StackPanel x:Name="GuidePane" Grid.Row="1" DataContext="{Binding Guide}" Visibility="Collapsed"
                        HorizontalAlignment="Left" Width="560" KeyDown="OnGuidePaneKeyDown">
                <TextBlock Text="Now Playing source" Style="{StaticResource Text}" />
                <TextBlock Text="The app the Audio flyout's Now Playing follows while it plays or is paused, else whatever Windows shows."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,18" />
                <Button x:Name="NowPlayingSourceBox" Style="{StaticResource DropBox}" Click="OnDropBoxClick">
                    <TextBlock Text="{Binding NowPlayingSource}" Style="{StaticResource Text}" />
                </Button>
                <Canvas Height="0" Margin="0,8,0,0">
                    <Border x:Name="NowPlayingSourceList" Style="{StaticResource DropList}" Visibility="Collapsed">
                        <ScrollViewer Style="{StaticResource DropScroller}">
                            <StackPanel x:Name="NowPlayingSourceOptions" Margin="16,8" />
                        </ScrollViewer>
                    </Border>
                </Canvas>
            </StackPanel>

            <!--
                Discord: the checklist for making the user's own Discord application, beside the QR code of the developer
                portal it's made at; its Client ID and Secret, each typed over the page with Type or filled by Paste from the
                Windows clipboard; Connect and Disconnect; and the status line, under Theme settings. A on Theme settings'
                Discord comes in; Left from the first column or B goes back to it.
            -->
            <StackPanel x:Name="DiscordPane" Grid.Row="1" DataContext="{Binding Discord}" Visibility="Collapsed"
                        KeyDown="OnDiscordPaneKeyDown">
                <TextBlock Text="Connect your own Discord application, so the Guide can show you on Discord."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,30" />

                <Grid Margin="0,0,0,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="DiscordSteps" Focusable="False" VerticalAlignment="Top" Margin="0,0,40,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Text}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Text}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The portal's address as a QR code, to open on a phone, with the address under it. -->
                    <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Top">
                        <Image Source="/XboxSeries.Extension;component/DiscordPortalQr.png" Width="200" Height="200"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PortalUrl}" Style="{StaticResource MutedText}" FontSize="16"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <!-- The application's Client ID, shown, and its Secret, only whether one is saved; each with Type, then Paste. -->
                <Grid Margin="0,0,0,20" Style="{StaticResource RaisedWhenFocused}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Client ID" Style="{StaticResource Text}" />
                        <TextBlock Text="{Binding ClientId, TargetNullValue='Not set'}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="TypeClientIdButton" Style="{StaticResource PaneButton}" Margin="0,0,20,0" Click="OnDiscordButtonClick">
                            <TextBlock Text="Type" Style="{StaticResource Text}" />
                        </Button>
                        <Button x:Name="PasteClientIdButton" Style="{StaticResource PaneButton}" Click="OnDiscordButtonClick">
                            <TextBlock Text="Paste" Style="{StaticResource Text}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,36" Style="{StaticResource RaisedWhenFocused}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Client Secret" Style="{StaticResource Text}" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Text" Value="Not set" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasClientSecret}" Value="True">
                                            <Setter Property="Text" Value="Saved" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="TypeClientSecretButton" Style="{StaticResource PaneButton}" Margin="0,0,20,0" Click="OnDiscordButtonClick">
                            <TextBlock Text="Type" Style="{StaticResource Text}" />
                        </Button>
                        <Button x:Name="PasteClientSecretButton" Style="{StaticResource PaneButton}" Click="OnDiscordButtonClick">
                            <TextBlock Text="Paste" Style="{StaticResource Text}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <Button x:Name="ConnectButton" Style="{StaticResource PaneButton}" Tag="{Binding CanConnect}"
                            Margin="0,0,20,0" Click="OnDiscordButtonClick">
                        <TextBlock Text="Connect" Style="{StaticResource Text}" />
                    </Button>
                    <Button x:Name="DisconnectButton" Style="{StaticResource PaneButton}" Tag="{Binding CanDisconnect}"
                            Click="OnDiscordButtonClick">
                        <TextBlock Text="Disconnect" Style="{StaticResource Text}" />
                    </Button>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text}" TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Playnite settings: its boxes, Download metadata, Playnite settings (Playnite's own Fullscreen Settings
                window) and Update after downloads, as Theme settings'. Right or A on the rail's Playnite settings comes
                in; Left from the first column or B from its boxes goes back to it.
            -->
            <local:PlaynitePane x:Name="PlaynitePane" Grid.Row="1" Visibility="Collapsed" />

            <!--
                Debug builds only: the Debug menu (DebugPane), made by the code-behind and placed here, in the options' row.
            -->
        </Grid>
    </Grid>
</controls:PluginUserControl>
