<UserControl x:Class="XboxSeries.Extension.PersonalisationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:XboxSeries.Core;assembly=XboxSeries.Core"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False" KeyDown="OnPaneKeyDown">
    <!--
        Theme settings' Personalisation page, as the console's General and Account: a grid of dark boxes two wide, each a
        line icon and its name alone, opening a page of its own in their place. Its DataContext
        is the core's StartUpSettingsState; the page showing and its header follow the code-behind. In Settings' palette and 1080p units (SettingsControl.xaml).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SettingsBoxes />
            </ResourceDictionary.MergedDictionaries>
            <local:DecodedImageConverter x:Key="Image" />
            <BooleanToVisibilityConverter x:Key="Visibility" />

            <!--
                A choice in a list, as Boot video's: the width of two boxes, marked with a tick while it's the one set, and
                lightened and ringed while focused as a box is.
            -->
            <Style x:Key="Row" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="892" />
                <Setter Property="Height" Value="66" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Back" Background="#FF2D2D2D" />
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="FocusRing" Margin="-8" BorderThickness="4" CornerRadius="8"
                                        BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF4A4A4A" />
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A ChoiceRow in a Row: its tick while it's the one set, then its name. -->
            <DataTemplate x:Key="ChoiceRow">
                <Button Style="{StaticResource Row}" Click="OnRowClick">
                    <Grid>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Width="30"
                                   HorizontalAlignment="Left" Margin="30,0,0,0"
                                   Visibility="{Binding IsCurrent, Converter={StaticResource Visibility}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text}" VerticalAlignment="Center" Margin="84,0,24,0" />
                    </Grid>
                </Button>
            </DataTemplate>

            <!--
                A profile's picture on a disc: the person glyph on the accent under it, showing for none or one that won't
                load, as Who's playing today? has it. The content is the picture's path.
            -->
            <DataTemplate x:Key="Picture">
                <Grid>
                    <Ellipse Fill="{DynamicResource GlyphLightBrush}" />
                    <Viewbox Margin="22">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" />
                    </Viewbox>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Converter={StaticResource Image}, ConverterParameter=200}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </DataTemplate>

            <!--
                A gamerpic to choose, on Picture: its disc, ringed while focused with a gap between the two, the ring
                carrying the console's green glow as a blurred band, and ticked while it's the one worn. The ring is a
                Border rounded to a circle, so it can carry the band.
            -->
            <Style x:Key="PictureButton" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Width" Value="172" />
                <Setter Property="Height" Value="172" />
                <Setter Property="Margin" Value="0,0,30,30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter Margin="12" />
                                <Border x:Name="Ring" CornerRadius="999" BorderBrush="{DynamicResource GlyphLightBrush}" BorderThickness="6"
                                        Visibility="Hidden">
                                    <Border Style="{DynamicResource XboxFocusGlowCache}">
                                        <Border Style="{DynamicResource XboxFocusGlow}" CornerRadius="999" Margin="-8.5" />
                                    </Border>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,20,0,0">
        <!-- Personalisation's boxes: Boot video, Profiles and Who's playing today?, each opening its page. -->
        <UniformGrid x:Name="PersonalisationPage" Columns="2" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button x:Name="BootVideoBox" Style="{StaticResource Box}" Tag="&#xE714;" Click="OnBoxClick">
                <TextBlock Text="Boot video" Style="{StaticResource Text}" />
            </Button>
            <Button x:Name="ProfilesBox" Style="{StaticResource Box}" Tag="&#xE716;" Click="OnBoxClick">
                <TextBlock Text="Profiles" Style="{StaticResource Text}" />
            </Button>
            <Button x:Name="AskBox" Style="{StaticResource Box}" Tag="&#xE748;" Click="OnBoxClick">
                <TextBlock Text="Who's playing today?" Style="{StaticResource Text}" />
            </Button>
        </UniformGrid>

        <!-- Boot video: each generation's, oldest first after Off, the one that plays ticked. -->
        <StackPanel x:Name="BootVideoPage" Visibility="Collapsed">
            <TextBlock Text="Plays as Playnite starts in Fullscreen. Any button skips it."
                       Style="{StaticResource MutedText}" Margin="0,0,0,26" />
            <ItemsControl x:Name="BootVideoRows" Focusable="False" ItemTemplate="{StaticResource ChoiceRow}"
                          ItemContainerStyle="{StaticResource RaisedWhenFocused}" />
        </StackPanel>

        <!-- Who's playing today?: whether it asks on every start and on waking from sleep, the one set ticked. -->
        <StackPanel x:Name="WhosPlayingPage" Visibility="Collapsed">
            <TextBlock Text="Choose who's playing as Playnite starts in Fullscreen and wakes from sleep."
                       Style="{StaticResource MutedText}" Margin="0,0,0,26" />
            <ItemsControl x:Name="WhosPlayingRows" Focusable="False" ItemTemplate="{StaticResource ChoiceRow}"
                          ItemContainerStyle="{StaticResource RaisedWhenFocused}" />
        </StackPanel>

        <!--
            Profiles: each in a box, its picture and gamertag, then Add profile last. The boxes sit 32 in from the scroller's
            top and left, which its margin cancels, so a focused box's ring and glow band aren't cut off there.
        -->
        <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" Focusable="False" Margin="-32,-32,0,0"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProfileBoxes" Focusable="False" HorizontalAlignment="Left" Margin="32,32,0,0"
                          ItemContainerStyle="{StaticResource RaisedWhenFocused}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type core:Profile}">
                        <Button Style="{StaticResource Box}" Padding="30,0,24,0" Click="OnProfileBoxClick">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}"
                                                  Width="80" Height="80" />
                                <TextBlock Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Gamertag}" Style="{StaticResource Text}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:AddProfileItem}">
                        <Button Style="{StaticResource Box}" Tag="&#xE8FA;" Click="OnProfileBoxClick">
                            <TextBlock Text="Add profile" Style="{StaticResource Text}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- A profile: its gamertag and real name, each typed over the page, its picture, chosen on a page of its own, and Remove. -->
        <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
            <ContentPresenter Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}" Width="120" Height="120"
                              HorizontalAlignment="Left" Margin="0,0,0,30" />
            <UniformGrid Columns="2" HorizontalAlignment="Left">
                <Button x:Name="GamertagBox" Style="{StaticResource Box}" Tag="&#xE8EC;" Click="OnBoxClick">
                    <TextBlock Text="Gamertag" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="RealNameBox" Style="{StaticResource Box}" Tag="&#xE8AC;" Click="OnBoxClick">
                    <TextBlock Text="Real name" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="PictureBox" Style="{StaticResource Box}" Tag="&#xE8B9;" Click="OnBoxClick">
                    <TextBlock Text="Picture" Style="{StaticResource Text}" />
                </Button>
                <Button x:Name="RemoveBox" Style="{StaticResource Box}" Tag="&#xE74D;" Click="OnBoxClick">
                    <TextBlock Text="Remove profile" Style="{StaticResource Text}" />
                </Button>
            </UniformGrid>
        </StackPanel>

        <!-- Picture: the gamerpics to wear, the Windows account picture first, the one worn ticked. -->
        <DockPanel x:Name="PicturesPage" Visibility="Collapsed">
            <TextBlock x:Name="PicturesHint" DockPanel.Dock="Top" Text="Add images to the Gamerpics folder to choose from more."
                       Style="{StaticResource MutedText}" Margin="0,0,0,26" />
            <!-- As Profiles' boxes, the gamerpics sit in from the scroller's top and left, 24, so a ring's glow band isn't cut off. -->
            <ScrollViewer Focusable="False" Margin="-24,-24,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PictureButtons" Focusable="False" HorizontalAlignment="Left" Margin="24,24,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PictureButton}" Click="OnPictureClick">
                                <Grid>
                                    <ContentPresenter Content="{Binding Path}" ContentTemplate="{StaticResource Picture}" />
                                    <Grid Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          Visibility="{Binding IsCurrent, Converter={StaticResource Visibility}}">
                                        <Ellipse Fill="{DynamicResource GlyphBrush}" Stroke="#FF1F1F1F" StrokeThickness="3" />
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="20" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
