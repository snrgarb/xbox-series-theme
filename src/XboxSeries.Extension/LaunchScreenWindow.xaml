<Window x:Class="XboxSeries.Extension.LaunchScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox Series Launch screen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Launch screen: the launching game's art over the whole screen, above every window, as on the console, so
        Steam, the Xbox app, Epic's launcher and any splash or update windows stay hidden behind it until the game is
        running. It never takes focus or the mouse, so the game gets the foreground and input as soon as it starts. The
        art is as Home's hero shows it (HeroLayer): background art as it is, or a cover blurred and darkened; black for
        none. It fades in, and out once the game runs or the launch ends (see LaunchScreenWindow.xaml.cs).
    -->
    <Grid x:Name="Root" Background="Black" Opacity="0" />
</Window>
