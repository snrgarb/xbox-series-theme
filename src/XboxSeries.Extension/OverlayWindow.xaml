<Window x:Class="XboxSeries.Extension.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxSeries.Extension"
        Title="Xbox Series Guide"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Overlay: transparent, Topmost and full-screen. It hosts the Guide and nothing else. The Guide is drawn after
        the console's (the captures under docs/reference/console/G-guide, scaled from 720p to 1080p): a panel with
        rounded corners down the left, dark at the top and green toward the bottom, its tab icons along the top over a
        green underline on the tab showing, and the hints beside it.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The Image converter and the library source icons the Home tiles badge their covers with. -->
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Xbox sphere, 24 units square (Simple Icons' xbox, CC0). -->
            <Geometry x:Key="XboxLogo">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>
            <!-- Discord's mark, 24 units wide (Simple Icons' discord, CC0), for the Discord tab and its account card. -->
            <Geometry x:Key="DiscordLogo">M 20.317 4.3698 a 19.7913 19.7913 0 0 0 -4.8851 -1.5152 .0741 .0741 0 0 0 -.0785 .0371 c -.211 .3753 -.4447 .8648 -.6083 1.2495 -1.8447 -.2762 -3.68 -.2762 -5.4868 0 -.1636 -.3933 -.4058 -.8742 -.6177 -1.2495 a .077 .077 0 0 0 -.0785 -.037 19.7363 19.7363 0 0 0 -4.8852 1.515 .0699 .0699 0 0 0 -.0321 .0277 C .5334 9.0458 -.319 13.5799 .0992 18.0578 a .0824 .0824 0 0 0 .0312 .0561 c 2.0528 1.5076 4.0413 2.4228 5.9929 3.0294 a .0777 .0777 0 0 0 .0842 -.0276 c .4616 -.6304 .8731 -1.2952 1.226 -1.9942 a .076 .076 0 0 0 -.0416 -.1057 c -.6528 -.2476 -1.2743 -.5495 -1.8722 -.8923 a .077 .077 0 0 1 -.0076 -.1277 c .1258 -.0943 .2517 -.1923 .3718 -.2914 a .0743 .0743 0 0 1 .0776 -.0105 c 3.9278 1.7933 8.18 1.7933 12.0614 0 a .0739 .0739 0 0 1 .0785 .0095 c .1202 .099 .246 .1981 .3728 .2924 a .077 .077 0 0 1 -.0066 .1276 12.2986 12.2986 0 0 1 -1.873 .8914 .0766 .0766 0 0 0 -.0407 .1067 c .3604 .698 .7719 1.3628 1.225 1.9932 a .076 .076 0 0 0 .0842 .0286 c 1.961 -.6067 3.9495 -1.5219 6.0023 -3.0294 a .077 .077 0 0 0 .0313 -.0552 c .5004 -5.177 -.8382 -9.6739 -3.5485 -13.6604 a .061 .061 0 0 0 -.0312 -.0286 z M 8.02 15.3312 c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 .9555 -2.4189 2.157 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -.9555 2.4189 -2.1569 2.4189 z m 7.9748 0 c -1.1825 0 -2.1569 -1.0857 -2.1569 -2.419 0 -1.3332 .9554 -2.4189 2.1569 -2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332 -.946 2.4189 -2.1568 2.4189 Z</Geometry>
            <Style x:Key="GuideText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GuideIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
            <!--
                An entry, on a tab or in a flyout. Home and My games & apps are an icon and a title; games show their cover;
                the profile card shows the account picture; Settings and Power are a smaller icon and title, each under a
                divider. On the Discord tab in a call, the people in it with their avatars, then switches for Discord's
                mute and deafen, also in the Audio flyout. In a flyout: notifications as cards with their text; Audio's
                volume slider and mute switch. The
                focused entry is filled a little lighter and wears the tiles' green ring.
                Each part that shows a picture gets it only from the trigger on the kind that shows it, so an entry
                decodes its image once, for the one part showing, rather than once for every part it has.
            -->
            <DataTemplate x:Key="GuideEntry">
                <StackPanel>
                    <Border x:Name="Divider" Height="1" Margin="30,14,30,26" Background="#33FFFFFF" Visibility="Collapsed" />
                    <Grid x:Name="Entry" Height="105" Margin="9,0,9,3" Background="Transparent"
                          MouseEnter="OnEntryMouseEnter" MouseLeftButtonUp="OnEntryClick">
                        <Border x:Name="Fill" CornerRadius="4" Background="Transparent" />
                        <TextBlock x:Name="Glyph" Style="{StaticResource GuideIcon}" FontSize="30" Width="36"
                                   HorizontalAlignment="Left" Margin="33,0,0,0" />
                        <!-- The Discord tab's account card: Discord's mark on a disc in its blurple, where the profile card has the picture. -->
                        <Grid x:Name="DiscordMark" Width="60" Height="60" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                            <Ellipse Fill="#FF5865F2" />
                            <Path Data="{StaticResource DiscordLogo}" Fill="White" Width="32" Height="32" Stretch="Uniform" />
                        </Grid>
                        <Grid x:Name="Cover" Width="90" Height="90" HorizontalAlignment="Left" Margin="6,0,0,0"
                              Visibility="Collapsed">
                            <!--
                                The fallback under the cover, showing for a game with none (or one that won't
                                load): the console's own tile for a title without art, a square in the accent
                                with a controller on it.
                            -->
                            <Border Background="{DynamicResource GlyphLightBrush}">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource GuideIcon}" FontSize="36" HorizontalAlignment="Center" />
                            </Border>
                            <Image x:Name="CoverArt" Stretch="UniformToFill" />
                            <!-- The game's library source, bottom left, where the console badges its covers. -->
                            <Path x:Name="SourceIcon" Width="18" Height="18" Margin="6" Stretch="Uniform"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="White" Visibility="Collapsed">
                                <Path.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.8" Color="Black" />
                                </Path.Effect>
                            </Path>
                        </Grid>
                        <Grid x:Name="Avatar" Width="60" Height="60" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                            <Ellipse Fill="#FF4A4A4A" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Tag, ElementName=Avatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <!--
                            Someone in a Discord call, as in the console's Parties &amp; chats: their avatar on a disc, a grey one for
                            none (or one that won't load), ringed in the accent while they speak.
                        -->
                        <Grid x:Name="Participant" Width="56" Height="56" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                            <Ellipse Width="48" Height="48" Fill="#FF4A4A4A" />
                            <TextBlock Text="&#xE77B;" Style="{StaticResource GuideIcon}" FontSize="22" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                            <Ellipse Width="48" Height="48">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Tag, ElementName=Participant}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="SpeakingRing" Stroke="{DynamicResource GlyphLightBrush}" StrokeThickness="3" Visibility="Hidden" />
                        </Grid>
                        <!--
                            Someone calling, as the console's incoming invite: their avatar on a disc as a person in a
                            call has it, a grey one for none (or one that won't load), and a green phone badged at its foot.
                        -->
                        <Grid x:Name="Caller" Width="60" Height="60" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                            <Ellipse Fill="#FF4A4A4A" />
                            <TextBlock Text="&#xE77B;" Style="{StaticResource GuideIcon}" FontSize="26" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Tag, ElementName=Caller}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Grid Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                <Ellipse Fill="#FF23A55A" Stroke="#FF1F1F1F" StrokeThickness="2" />
                                <TextBlock Text="&#xE717;" Style="{StaticResource GuideIcon}" FontSize="13" HorizontalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <!--
                            A Discord server in the Servers flyout: its icon on a rounded square, as Discord shows them, over a grey
                            one with Discord's mark for a server without an icon (or one that won't load).
                        -->
                        <Grid x:Name="ServerIcon" Width="60" Height="60" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                            <Border CornerRadius="16" Background="#FF4A4A4A">
                                <Path Data="{StaticResource DiscordLogo}" Fill="#B3FFFFFF" Width="30" Height="30" Stretch="Uniform" />
                            </Border>
                            <Border CornerRadius="16">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Tag, ElementName=ServerIcon}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="Text" Margin="112,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource GuideText}" FontSize="25"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68" />
                            <TextBlock x:Name="Running" Text="Running" Style="{StaticResource GuideText}" FontSize="22"
                                       Foreground="#B3FFFFFF" Visibility="Collapsed" />
                            <!-- Who is calling, under Answer. -->
                            <TextBlock x:Name="Calling" Text="{Binding Detail}" Style="{StaticResource GuideText}" FontSize="22"
                                       Foreground="#B3FFFFFF" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                            <!--
                                Audio's Output and Input dropdowns, as the console's Settings ones: a box under the title naming
                                the device set, a long name cut short, with a chevron at its end, pointing up while the list is open.
                            -->
                            <Border x:Name="DropBox" Height="48" Margin="0,10,0,0" CornerRadius="4" BorderThickness="2"
                                    BorderBrush="#80FFFFFF" Background="#14FFFFFF" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Text="{Binding Selection}" Style="{StaticResource GuideText}" FontSize="22" Margin="14,0,46,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="Chevron" Text="&#xE70D;" Style="{StaticResource GuideIcon}" FontSize="16"
                                               HorizontalAlignment="Right" Margin="0,0,16,0" />
                                </Grid>
                            </Border>
                            <!-- Audio's volume slider: a track filled to the level, in the accent. -->
                            <ProgressBar x:Name="Slider" Minimum="0" Maximum="100" Value="{Binding Level, Mode=OneWay}"
                                         Height="6" Margin="0,12,56,0" Visibility="Collapsed" Focusable="False">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border x:Name="PART_Track" Background="#40FFFFFF" CornerRadius="3" />
                                            <Border x:Name="PART_Indicator" Background="{DynamicResource GlyphLightBrush}"
                                                    CornerRadius="3" HorizontalAlignment="Left" />
                                        </Grid>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <!--
                                Who is in a server's voice channel: their avatars on small discs in a row, each overlapping the
                                one before and edged in the flyout's grey, a grey disc for none (or one that won't load); a
                                row too long for the flyout is cut off at its edge. Gone until Discord has said who is there.
                            -->
                            <ItemsControl x:Name="Occupants" ItemsSource="{Binding Occupants}" Focusable="False" Margin="0,8,0,0"
                                          ClipToBounds="True" IsHitTestVisible="False">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="34" Height="34" Margin="0,0,-8,0">
                                            <Ellipse Fill="#FF4A4A4A" Stroke="#FF1F1F1F" StrokeThickness="2" />
                                            <Ellipse Margin="2">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Converter={StaticResource Image}, ConverterParameter=64}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- A voice channel nobody is in. -->
                            <TextBlock x:Name="EmptyChannel" Text="Empty" Style="{StaticResource GuideText}" FontSize="20"
                                       Foreground="#B3FFFFFF" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="LevelText" Text="{Binding Level}" Style="{StaticResource GuideText}" FontSize="24"
                                   HorizontalAlignment="Right" Margin="0,0,24,0" Visibility="Collapsed" />
                        <!-- Audio's mute switch: a pill, filled in the accent with its knob to the right when on. -->
                        <Grid x:Name="Switch" Width="48" Height="24" HorizontalAlignment="Right" Margin="0,0,24,0" Visibility="Collapsed">
                            <Border x:Name="SwitchTrack" CornerRadius="12" BorderBrush="White" BorderThickness="2" />
                            <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="6,0" />
                        </Grid>
                        <!-- A person in the call muted (the microphone struck through) or deafened (the headphones struck through). -->
                        <StackPanel x:Name="CallMarks" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,24,0" Visibility="Collapsed">
                            <TextBlock x:Name="MutedMark" Text="&#xEC54;" Style="{StaticResource GuideIcon}" FontSize="22" Width="26"
                                       Foreground="#B3FFFFFF" Visibility="Collapsed" />
                            <Grid x:Name="DeafenedMark" Width="26" Height="26" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE7F6;" Style="{StaticResource GuideIcon}" FontSize="22" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                                <Line X1="3" Y1="3" X2="23" Y2="23" Stroke="#B3FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </StackPanel>
                        <!--
                            A Discord shortcut's tile, one of three across a row: the DM's avatar on a disc or the server's
                            icon on a rounded square, over the name and, for a voice channel, its server's name below in
                            grey. Under the picture, showing while there is none or it won't load, a grey shape with
                            Discord's mark for a DM or the speaker for a voice channel.
                        -->
                        <StackPanel x:Name="Tile" VerticalAlignment="Center" Margin="10,0" Visibility="Collapsed">
                            <Grid Width="72" Height="72">
                                <Border x:Name="TileFallback" CornerRadius="16" Background="#FF4A4A4A">
                                    <Grid>
                                        <TextBlock x:Name="TileSpeaker" Text="&#xE767;" Style="{StaticResource GuideIcon}" FontSize="28"
                                                   Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                                        <Path x:Name="TileMark" Data="{StaticResource DiscordLogo}" Fill="#B3FFFFFF" Width="34" Height="34"
                                              Stretch="Uniform" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Border x:Name="TileArt" CornerRadius="16">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Tag, ElementName=TileArt}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource GuideText}" FontSize="20" Margin="0,10,0,0"
                                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TileDetail" Text="{Binding Detail}" Style="{StaticResource GuideText}" FontSize="17"
                                       Foreground="#B3FFFFFF" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- The tiles' ring, 1 px past the entry as theirs is past their art. -->
                        <Border x:Name="Ring" Margin="-1" BorderThickness="4" CornerRadius="7"
                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                    </Grid>
                    <!--
                        An Output or Input dropdown's open list, under its box and as wide, laid over the entries below
                        it rather than pushing them down: the Canvas takes no height, and the list sits on it at its own.
                        A box a little lighter than the flyout, each device a row of this template (so it has the
                        entries' focus and is pointed at and picked as they are), the one set ticked. Gone while the
                        list is closed.
                    -->
                    <Canvas x:Name="OptionLayer" Height="0" Margin="78,-8,33,0">
                    <Border x:Name="OptionList" Width="{Binding ActualWidth, ElementName=OptionLayer}" Padding="0,6" CornerRadius="4"
                            Background="#FF2E2E2E" BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl x:Name="Options" ItemsSource="{Binding Options}" ItemTemplate="{DynamicResource GuideEntry}"
                                      Focusable="False" />
                    </Border>
                    </Canvas>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Source}" Value="Steam">
                        <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceSteam}" />
                        <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Source}" Value="Xbox">
                        <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceXbox}" />
                        <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasDividerAbove}" Value="True">
                        <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- Segoe Fluent Icons / MDL2 Assets glyphs. -->
                    <DataTrigger Binding="{Binding Kind}" Value="Home">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE80F;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="MyGamesAndApps">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE8F1;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="RunningGame">
                        <Setter TargetName="CoverArt" Property="Source" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=180}" />
                        <Setter TargetName="Running" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="96" />
                        <Setter TargetName="Entry" Property="Margin" Value="9,0,9,12" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="RecentGame">
                        <Setter TargetName="CoverArt" Property="Source" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=180}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="96" />
                        <Setter TargetName="Entry" Property="Margin" Value="9,0,9,12" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Profile">
                        <Setter TargetName="Avatar" Property="Tag" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=120}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Avatar" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="138" />
                        <Setter TargetName="Text" Property="Margin" Value="96,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <!-- Settings and Power: smaller rows, the icon further left, as on the console. -->
                    <DataTrigger Binding="{Binding Kind}" Value="Settings">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE713;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Power">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7E8;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <!--
                        A notification: a card in the console's inbox, slightly lighter than the panel, with
                        the bell Home's top bar uses beside its wrapping text.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="Notification">
                        <Setter TargetName="Entry" Property="Height" Value="NaN" />
                        <Setter TargetName="Entry" Property="MinHeight" Value="87" />
                        <Setter TargetName="Entry" Property="Margin" Value="9,0,9,9" />
                        <Setter TargetName="Fill" Property="Background" Value="#14FFFFFF" />
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE91C;" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="Glyph" Property="Padding" Value="0,24,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,18,24,18" />
                        <Setter TargetName="Title" Property="FontSize" Value="22" />
                        <Setter TargetName="Title" Property="MaxHeight" Value="120" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Volume">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE767;" />
                        <Setter TargetName="Entry" Property="Height" Value="96" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Slider" Property="Visibility" Value="Visible" />
                        <Setter TargetName="LevelText" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Mute">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE74F;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!--
                        Audio's Output and Input dropdowns (#55): the speaker or the microphone beside the title, the box
                        naming the device under it. Open, the box is ringed in the accent and the chevron points up, and
                        the row stays lit while focus is down in its list; the list itself is OptionList, under the row.
                        Each device in the list is a shorter row, its name cut short when long, the one set ticked where
                        the other rows have their icon.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="AudioOutput">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7F5;" />
                        <Setter TargetName="Entry" Property="Height" Value="128" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="Glyph" Property="Padding" Value="0,22,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,24,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="DropBox" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="AudioInput">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE720;" />
                        <Setter TargetName="Entry" Property="Height" Value="128" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="Glyph" Property="Padding" Value="0,22,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,24,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="DropBox" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="#26FFFFFF" />
                        <Setter TargetName="DropBox" Property="BorderBrush" Value="{DynamicResource GlyphLightBrush}" />
                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="AudioDevice">
                        <Setter TargetName="Entry" Property="Height" Value="60" />
                        <Setter TargetName="Entry" Property="Margin" Value="6,0,6,2" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="20" />
                        <Setter TargetName="Glyph" Property="Margin" Value="14,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="52,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="22" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind}" Value="AudioDevice" />
                            <Condition Binding="{Binding IsOn}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                    </MultiDataTrigger>
                    <!-- The Discord tab: who is signed in, as the profile card, then a quieter line about voice. -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordAccount">
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="DiscordMark" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="105" />
                        <Setter TargetName="Text" Property="Margin" Value="96,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="27" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordIdle">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7F6;" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="#B3FFFFFF" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="22" />
                        <Setter TargetName="Title" Property="Foreground" Value="#B3FFFFFF" />
                    </DataTrigger>
                    <!--
                        The Discord tab while it can't show Discord, its only line: as quiet as the one about voice, with a
                        warning rather than the headset, its text wrapping as a title does.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordUnavailable">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="#B3FFFFFF" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="22" />
                        <Setter TargetName="Title" Property="Foreground" Value="#B3FFFFFF" />
                    </DataTrigger>
                    <!--
                        The Discord tab in a call: the channel's or DM's name over the people in it, each a row with their
                        avatar, then Mute, Deafen and Leave under a divider.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordChannel">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE767;" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="#B3FFFFFF" />
                        <Setter TargetName="Entry" Property="Height" Value="60" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="24" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordParticipant">
                        <Setter TargetName="Participant" Property="Tag" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=96}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Participant" Property="Visibility" Value="Visible" />
                        <Setter TargetName="CallMarks" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="72" />
                        <Setter TargetName="Text" Property="Margin" Value="88,0,96,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="22" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                        <Setter TargetName="SpeakingRing" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                        <Setter TargetName="MutedMark" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDeafened}" Value="True">
                        <Setter TargetName="DeafenedMark" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- The user's Discord mute and deafen, on the tab and in the Audio flyout: switches, as Audio's Mute. -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordMute">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE720;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordDeafen">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE7F6;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- Leave: the hang-up, in Discord's red. -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordLeave">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE778;" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="#FFED4245" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <!--
                        The Discord tab's shortcuts: tiles, three to a row, 160 square with 18 between them and below each
                        row, as the utilities' squares. The first one's divider runs on across the whole row from the left
                        tile, where it stands, to where every other divider ends.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordShortcut">
                        <Setter TargetName="TileArt" Property="Tag" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=144}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Tile" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="160" />
                        <Setter TargetName="Entry" Property="Margin" Value="9,0,9,18" />
                        <Setter TargetName="Divider" Property="Margin" Value="30,14,-328,26" />
                    </DataTrigger>
                    <!-- A DM's shortcut: no server, so a disc, as an avatar, and Discord's mark under it rather than the speaker. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind}" Value="DiscordShortcut" />
                            <Condition Binding="{Binding IsDirectMessage}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="TileFallback" Property="CornerRadius" Value="36" />
                        <Setter TargetName="TileArt" Property="CornerRadius" Value="36" />
                        <Setter TargetName="TileSpeaker" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="TileMark" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                    <!-- No server's name to show: a DM's, or a voice channel's until its server has said. -->
                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                        <Setter TargetName="TileDetail" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <!-- Servers, last on the tab under a divider: a row as Settings', opening the flyout of the user's servers. -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordServers">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE716;" />
                        <Setter TargetName="Entry" Property="Height" Value="75" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource GlyphLightBrush}" />
                        <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource GlyphLightBrush}" />
                        <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="#26FFFFFF" />
                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- The Servers flyout: each server a row with its icon, as the profile card has the picture. -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordServer">
                        <Setter TargetName="ServerIcon" Property="Tag" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=120}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="ServerIcon" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="96" />
                        <Setter TargetName="Text" Property="Margin" Value="96,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <!--
                        A server's voice channels: the speaker level with each name, and under it who is in it, or Empty;
                        the row grows to take them.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordVoiceChannel">
                        <Setter TargetName="Glyph" Property="Text" Value="&#xE767;" />
                        <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                        <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                        <Setter TargetName="Glyph" Property="VerticalAlignment" Value="Top" />
                        <Setter TargetName="Glyph" Property="Padding" Value="0,14,0,0" />
                        <Setter TargetName="Entry" Property="Height" Value="NaN" />
                        <Setter TargetName="Text" Property="Margin" Value="69,16,16,16" />
                        <Setter TargetName="Title" Property="FontSize" Value="24" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Occupants.Count}" Value="0">
                        <Setter TargetName="EmptyChannel" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!--
                        A DM ringing, first on the Discord tab: the caller's avatar with the green phone, Answer in Discord's
                        green over who is calling, a row as tall as the account card's so it stands out above the rest.
                    -->
                    <DataTrigger Binding="{Binding Kind}" Value="DiscordIncomingCall">
                        <Setter TargetName="Caller" Property="Tag" Value="{Binding Image, Converter={StaticResource Image}, ConverterParameter=120}" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Caller" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Calling" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Entry" Property="Height" Value="105" />
                        <Setter TargetName="Text" Property="Margin" Value="96,0,16,0" />
                        <Setter TargetName="Title" Property="FontSize" Value="25" />
                        <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                        <Setter TargetName="Title" Property="Foreground" Value="#FF23A55A" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <!-- The dim behind the Guide, as dark as the console's: it leaves the screen behind at under half its brightness. -->
    <Window.Background>
        <SolidColorBrush x:Name="Dim" Color="#8F000000" Opacity="0" />
    </Window.Background>
    <!--
        Laid out at 1080 tall and the screen's aspect, as Playnite lays out the theme, then scaled to the screen, so the
        Guide keeps its size against the Dashboard whatever the resolution and DPI.
    -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Height="1080" Width="1920">
            <!--
                A shade across the top, near-opaque black at the very top and fading out by y 420, behind the panel and the
                status area, as over the console's landing tab (G2-tab-1-landing), so the clock and battery read over whatever
                is in front: a game, or any Dashboard page. It comes and goes with the dim. Only with the panel, as the status
                area: Power on its own has none.
            -->
            <Rectangle Height="420" VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                       Opacity="{Binding Opacity, ElementName=Dim}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FA000000" Offset="0" />
                        <GradientStop Color="#EB000000" Offset="0.3" />
                        <GradientStop Color="#A6000000" Offset="0.6" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsPanel}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <!--
                The hints beside the panel, as on the console. Only with the panel: Power on its own has none. A flyout
                covers where they stand, so they go while one is open, as on the console (G5-profile-flyout).
            -->
            <ItemsControl ItemsSource="{Binding Hints}" Focusable="False" Margin="675,168,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Opacity="{Binding Opacity, ElementName=Dim}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowsPanel}" Value="True" />
                                    <Condition Binding="{Binding Flyout}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="45">
                            <Grid Width="27" Height="27" VerticalAlignment="Center">
                                <!-- The Guide button: the Xbox sphere. -->
                                <Path x:Name="GuideGlyph" Data="{StaticResource XboxLogo}" Fill="White" Stretch="Uniform" />
                                <!-- Menu: a ring round three lines. -->
                                <Grid x:Name="MenuGlyph" Visibility="Collapsed">
                                    <Ellipse Stroke="White" StrokeThickness="2" />
                                    <TextBlock Text="&#xE700;" Style="{StaticResource GuideIcon}" FontSize="12" HorizontalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource GuideText}" FontSize="24" Margin="14,0,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Button}" Value="Start">
                                <Setter TargetName="GuideGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MenuGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
                The panel and its flyout slide in and out together, off screen far enough to take the flyout, whose right
                edge is the furthest right.
            -->
            <Grid HorizontalAlignment="Left">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Slide" X="-700" />
                </Grid.RenderTransform>
            <Border x:Name="GuidePanel"
                    Width="536"
                    Margin="78,33,0,35"
                    HorizontalAlignment="Left"
                    CornerRadius="12">
                <Border.Background>
                    <!-- Sampled down the console's panel: grey through the top half, only then turning a dark green. -->
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF1F1F1F" Offset="0" />
                        <GradientStop Color="#FF1E201C" Offset="0.5" />
                        <GradientStop Color="#FF172116" Offset="0.71" />
                        <GradientStop Color="#FF152611" Offset="0.86" />
                        <GradientStop Color="#FF132A0E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Blurred behind a menu or prompt, so the dialog reads clearly over it. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dialog}" Value="{x:Null}">
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid local:RoundedClip.Radius="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        The tabs: the landing tab's Xbox sphere, Discord's mark while it is connected, then Profile & system's
                        account picture. A tab not showing is greyed, as on the console.
                    -->
                    <Border Background="#FF1F1F1F" />
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" Margin="21,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="84" Height="102">
                                    <Path x:Name="Logo" Data="{StaticResource XboxLogo}" Fill="#FF8C8C8C" Width="33" Height="33" Stretch="Uniform" />
                                    <Grid x:Name="Picture" Width="54" Height="54" Visibility="Collapsed">
                                        <Ellipse Fill="#FF4A4A4A" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Image, Converter={StaticResource Image}, ConverterParameter=108}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <Border x:Name="Underline" Height="5" VerticalAlignment="Bottom" Margin="0,0,0,0" CornerRadius="2"
                                            Background="{DynamicResource GlyphLightBrush}" Visibility="Hidden" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Discord">
                                        <Setter TargetName="Logo" Property="Data" Value="{StaticResource DiscordLogo}" />
                                        <Setter TargetName="Logo" Property="Width" Value="36" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="ProfileAndSystem">
                                        <Setter TargetName="Logo" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Logo" Property="Fill" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Grid.Row="1" Margin="0,30,0,0">
                        <!--
                            The landing tab's row of utilities along the bottom, as on the console: small squares from the
                            left, Notifications, with how many there are, and Audio, each opening its flyout. Empty, and so
                            gone, on the other tabs. The squares are the console's: 87 across with 18 between, darker than the
                            panel behind them.
                        -->
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Utilities}" Focusable="False" Margin="15,12,9,16"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="87" Height="87" Margin="0,0,18,0" Background="Transparent"
                                          MouseEnter="OnEntryMouseEnter" MouseLeftButtonUp="OnEntryClick">
                                        <Border x:Name="Fill" CornerRadius="4" Background="#73000000" />
                                        <!-- Segoe Fluent Icons / MDL2 Assets glyphs: the bell Home's top bar uses, and the speaker. -->
                                        <TextBlock x:Name="Glyph" Text="&#xE767;" Style="{StaticResource GuideIcon}" FontSize="33" HorizontalAlignment="Center" />
                                        <Border x:Name="Badge" MinWidth="24" Height="24" CornerRadius="12" Padding="6,0"
                                                Background="{DynamicResource GlyphLightBrush}" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                            <TextBlock Text="{Binding Status.NotificationCount, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}"
                                                       Style="{StaticResource GuideText}" FontSize="16" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="Ring" Margin="-1" BorderThickness="4" CornerRadius="7"
                                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Notifications">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE91C;" />
                                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.NotificationCount, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}" Value="0">
                                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="#26FFFFFF" />
                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The heading: Discord's or Profile & system's. The landing tab has none. -->
                        <TextBlock DockPanel.Dock="Top" FontSize="33" Margin="28,-4,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GuideText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="Discord">
                                            <Setter Property="Text" Value="Discord" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tab}" Value="ProfileAndSystem">
                                            <Setter Property="Text" Value="Profile &amp; system" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--
                            The tab's entries. They wrap, so that the Discord tab's shortcuts, a third of the panel wide, sit
                            three to a row as the core moves between them, while every other entry is the panel's full
                            width and so a row of its own. The tiles of a row stand on its bottom, so the first one's
                            divider, above it, leaves them level.
                        -->
                        <ScrollViewer x:Name="EntriesScroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="Entries" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource GuideEntry}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="536" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="DiscordShortcut">
                                            <Setter Property="Width" Value="178" />
                                            <Setter Property="VerticalAlignment" Value="Bottom" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <!-- The landing tab's Home sits a little lower, where the other tab has its heading. -->
                                        <DataTrigger Binding="{Binding Tab}" Value="Landing">
                                            <Setter Property="Margin" Value="0,18,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                    <!-- Dimmed behind a flyout, as on the console, so the flyout in front stands out. -->
                    <Border Grid.RowSpan="2" Background="#73000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Flyout}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>
            <!--
                The flyout a utility opens, beside and over the panel as the console's profile flyout (G5-profile-flyout):
                as wide as the panel, from 77 in past its left edge, level with its top and down to the bottom of the
                screen, a flat #1F1F1F with its top corners rounded and a shadow round it. It comes in from the left
                quickly, as on the console; gone while no flyout is open.
            -->
            <Border x:Name="FlyoutPanel" Width="536" Margin="155,33,0,0" HorizontalAlignment="Left"
                    CornerRadius="12,12,0,0" Background="#FF1F1F1F">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.7" Color="Black" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Flyout}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="-48" To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel local:RoundedClip.Radius="12">
                    <!-- Its heading, the utility's name. -->
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Flyout.Title}" Style="{StaticResource GuideText}" FontSize="33" Margin="28,36,0,24" />
                    <!--
                        Notifications with none to show; the Servers flyout, or a server's voice channels, while Discord is
                        still being asked for them, then if it has none.
                    -->
                    <TextBlock DockPanel.Dock="Top" FontSize="24" Foreground="#B3FFFFFF" Margin="28,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GuideText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Flyout.Kind}" Value="Notifications" />
                                            <Condition Binding="{Binding Flyout.Items.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="No new notifications" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <!-- An empty flyout's entries may be an array, which has no Count to bind to, so these ask the list itself. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Flyout.Kind}" Value="DiscordServers" />
                                            <Condition Binding="{Binding HasItems, ElementName=FlyoutEntries}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="No servers" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Flyout.Kind}" Value="DiscordServer" />
                                            <Condition Binding="{Binding HasItems, ElementName=FlyoutEntries}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="No voice channels" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <!-- Last, so it wins over the empty messages while the entries are on their way. -->
                                    <DataTrigger Binding="{Binding Flyout.IsLoading}" Value="True">
                                        <Setter Property="Text" Value="Loading&#x2026;" />
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Its entries, the focused one scrolled into view when a long list of notifications runs past the bottom. -->
                    <ScrollViewer x:Name="FlyoutScroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="FlyoutEntries" ItemsSource="{Binding Flyout.Items}" ItemTemplate="{StaticResource GuideEntry}"
                                      Focusable="False" Margin="0,0,0,24">
                            <!-- A dropdown with its list open is drawn over the entries after it, which its list covers. -->
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Panel.ZIndex" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            </Grid>
            <!-- The status area, top right, the clock large under the battery, as on the console. Only with the panel: Power on its own has none. -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,86,150,0" Opacity="{Binding Opacity, ElementName=Dim}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsPanel}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <local:StatusArea Stacked="True" DataContext="{Binding Status, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}" />
            </Grid>
            <!-- Darkens everything behind a menu or prompt, the Guide included. -->
            <Border Background="#B3000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dialog}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <!-- A menu or prompt over the Guide (Menu on the running game, force quit, "Quit X and start Y?"), centred. It has the pad until answered. -->
            <local:MenuPanel x:Name="DialogPanel" DataContext="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Power: the console's "What do you want to do?" band across the screen. -->
            <local:WideDialogPanel x:Name="WidePanel" DataContext="{Binding Dialog}" />
        </Grid>
    </Viewbox>
</Window>
