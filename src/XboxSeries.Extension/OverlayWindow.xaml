<Window x:Class="XboxSeries.Extension.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XboxSeries.Extension"
        Title="Xbox Series Guide"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="10" Height="10">
    <!--
        The Overlay: transparent, Topmost and full-screen. It hosts the Guide and nothing else. The Guide is drawn after
        the console's (the captures under docs/reference/console/G-guide, scaled from 720p to 1080p): a panel with
        rounded corners down the left, dark at the top and green toward the bottom, its tab icons along the top over a
        green underline on the tab showing, and the hints beside it.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The Image converter and the library source icons the Home tiles badge their covers with. -->
                <local:HomeTiles />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Xbox sphere, 24 units square (Simple Icons' xbox, CC0). -->
            <Geometry x:Key="XboxLogo">M4.102 21.033C6.211 22.881 8.977 24 12 24c3.026 0 5.789-1.119 7.902-2.967 1.877-1.912-4.316-8.709-7.902-11.417-3.582 2.708-9.779 9.505-7.898 11.417zm11.16-14.406c2.5 2.961 7.484 10.313 6.076 12.912C23.002 17.48 24 14.861 24 12.004c0-3.34-1.365-6.362-3.57-8.536 0 0-.027-.022-.082-.042-.063-.022-.152-.045-.281-.045-.592 0-1.985.434-4.805 3.246zM3.654 3.426c-.057.02-.082.041-.086.042C1.365 5.642 0 8.664 0 12.004c0 2.854.998 5.473 2.661 7.533-1.401-2.605 3.579-9.951 6.08-12.91-2.82-2.813-4.216-3.245-4.806-3.245-.131 0-.223.021-.281.046v-.002zM12 3.551S9.055 1.828 6.755 1.746c-.903-.033-1.454.295-1.521.339C7.379.646 9.659 0 11.984 0H12c2.334 0 4.605.646 6.766 2.085-.068-.046-.615-.372-1.52-.339C14.946 1.828 12 3.545 12 3.545v.006z</Geometry>
            <Style x:Key="GuideText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="GuideIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource XboxIconFont}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Background>
        <SolidColorBrush x:Name="Dim" Color="#66000000" Opacity="0" />
    </Window.Background>
    <!--
        Laid out at 1080 tall and the screen's aspect, as Playnite lays out the theme, then scaled to the screen, so the
        Guide keeps its size against the Dashboard whatever the resolution and DPI.
    -->
    <Viewbox Stretch="Uniform">
        <Grid x:Name="Root" Height="1080" Width="1920">
            <!--
                A shade across the top, near-opaque black at the very top and fading out by y 420, behind the panel and the
                status area, as over the console's landing tab (G2-tab-1-landing), so the clock and battery read over whatever
                is in front: a game, or any Dashboard page. It comes and goes with the dim. Only with the panel, as the status
                area: Power on its own has none.
            -->
            <Rectangle Height="420" VerticalAlignment="Top" HorizontalAlignment="Stretch" IsHitTestVisible="False"
                       Opacity="{Binding Opacity, ElementName=Dim}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FA000000" Offset="0" />
                        <GradientStop Color="#EB000000" Offset="0.3" />
                        <GradientStop Color="#A6000000" Offset="0.6" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsPanel}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            <!-- The hints beside the panel, as on the console. Only with the panel: Power on its own has none. -->
            <ItemsControl ItemsSource="{Binding Hints}" Focusable="False" Margin="675,168,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          Opacity="{Binding Opacity, ElementName=Dim}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsPanel}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Height="45">
                            <Grid Width="27" Height="27" VerticalAlignment="Center">
                                <!-- The Guide button: the Xbox sphere. -->
                                <Path x:Name="GuideGlyph" Data="{StaticResource XboxLogo}" Fill="White" Stretch="Uniform" />
                                <!-- Menu: a ring round three lines. -->
                                <Grid x:Name="MenuGlyph" Visibility="Collapsed">
                                    <Ellipse Stroke="White" StrokeThickness="2" />
                                    <TextBlock Text="&#xE700;" Style="{StaticResource GuideIcon}" FontSize="12" HorizontalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource GuideText}" FontSize="24" Margin="14,0,0,0" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Button}" Value="Start">
                                <Setter TargetName="GuideGlyph" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MenuGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="GuidePanel"
                    Width="536"
                    Margin="78,33,0,35"
                    HorizontalAlignment="Left"
                    CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FF262626" Offset="0" />
                        <GradientStop Color="#FF232A23" Offset="0.35" />
                        <GradientStop Color="#FF1B4A1E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <!-- Blurred behind a menu or prompt, so the dialog reads clearly over it. -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="12" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dialog}" Value="{x:Null}">
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="Slide" X="-620" />
                </Border.RenderTransform>
                <Grid local:RoundedClip.Radius="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="102" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The tabs: the landing tab's Xbox sphere, then Profile & system's account picture. -->
                    <Border Background="#FF1F1F1F" />
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" Margin="21,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="84" Height="102">
                                    <Path x:Name="Logo" Data="{StaticResource XboxLogo}" Fill="#FFD0D0D0" Width="33" Height="33" Stretch="Uniform" />
                                    <Grid x:Name="Picture" Width="54" Height="54" Visibility="Collapsed">
                                        <Ellipse Fill="#FF4A4A4A" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Image, Converter={StaticResource Image}, ConverterParameter=108}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <Border x:Name="Underline" Height="5" VerticalAlignment="Bottom" Margin="0,0,0,0" CornerRadius="2"
                                            Background="{DynamicResource GlyphLightBrush}" Visibility="Hidden" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="ProfileAndSystem">
                                        <Setter TargetName="Logo" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Logo" Property="Fill" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Grid.Row="1" Margin="0,30,0,0">
                        <!--
                            The landing tab's row of utilities along the bottom, as on the console: small squares from the
                            left, Notifications, with how many there are, and Audio. Empty, and so gone, on the other tabs
                            and on a utility.
                        -->
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Utilities}" Focusable="False" Margin="9,12,9,16"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="78" Height="78" Margin="0,0,12,0" Background="Transparent"
                                          MouseEnter="OnEntryMouseEnter" MouseLeftButtonUp="OnEntryClick">
                                        <Border x:Name="Fill" CornerRadius="4" Background="#33000000" />
                                        <!-- Segoe Fluent Icons / MDL2 Assets glyphs: the bell Home's top bar uses, and the speaker. -->
                                        <TextBlock x:Name="Glyph" Text="&#xE767;" Style="{StaticResource GuideIcon}" FontSize="30" HorizontalAlignment="Center" />
                                        <Border x:Name="Badge" MinWidth="24" Height="24" CornerRadius="12" Padding="6,0"
                                                Background="{DynamicResource GlyphLightBrush}" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                                            <TextBlock Text="{Binding Status.NotificationCount, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}"
                                                       Style="{StaticResource GuideText}" FontSize="16" HorizontalAlignment="Center" />
                                        </Border>
                                        <Border x:Name="Ring" Margin="-1" BorderThickness="4" CornerRadius="6"
                                                BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Notifications">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE91C;" />
                                            <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.NotificationCount, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}" Value="0">
                                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="#26FFFFFF" />
                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The heading: Profile & system's, or the utility's. The landing tab has none. -->
                        <TextBlock DockPanel.Dock="Top" FontSize="33" Margin="28,-4,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GuideText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tab}" Value="ProfileAndSystem">
                                            <Setter Property="Text" Value="Profile &amp; system" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Utility}" Value="Notifications">
                                            <Setter Property="Text" Value="Notifications" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Utility}" Value="Audio">
                                            <Setter Property="Text" Value="Audio" />
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Notifications with none to show. -->
                        <TextBlock DockPanel.Dock="Top" Text="No new notifications" FontSize="24" Foreground="#B3FFFFFF" Margin="28,12,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GuideText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Utility}" Value="Notifications" />
                                                <Condition Binding="{Binding Items.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!--
                            The tab's entries. Home and My games & apps are an icon and a title; games show their cover; the
                            profile card shows the account picture; Settings and Power are a smaller icon and title, each
                            under a divider. A utility's entries: notifications as their text; Audio's volume slider and
                            mute switch. The focused entry is filled a little lighter and wears the tiles' green ring, and is
                            scrolled into view when a long list of notifications runs past the panel.
                        -->
                        <ScrollViewer x:Name="EntriesScroller" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <ItemsControl x:Name="Entries" ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <!-- The landing tab's Home sits a little lower, where the other tab has its heading. -->
                                        <DataTrigger Binding="{Binding Tab}" Value="Landing">
                                            <Setter Property="Margin" Value="0,18,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Utility}" Value="Notifications">
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Utility}" Value="Audio">
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Border x:Name="Divider" Height="1" Margin="30,14,30,26" Background="#33FFFFFF" Visibility="Collapsed" />
                                        <Grid x:Name="Entry" Height="105" Margin="9,0,9,3" Background="Transparent"
                                              MouseEnter="OnEntryMouseEnter" MouseLeftButtonUp="OnEntryClick">
                                            <Border x:Name="Fill" CornerRadius="4" Background="Transparent" />
                                            <TextBlock x:Name="Glyph" Style="{StaticResource GuideIcon}" FontSize="30" Width="36"
                                                       HorizontalAlignment="Left" Margin="33,0,0,0" />
                                            <Grid x:Name="Cover" Width="90" Height="90" HorizontalAlignment="Left" Margin="6,0,0,0"
                                                  Background="#FF1A1A1A" Visibility="Collapsed">
                                                <Image Source="{Binding Image, Converter={StaticResource Image}, ConverterParameter=180}" Stretch="UniformToFill" />
                                                <!-- The game's library source, bottom left, where the console badges its covers. -->
                                                <Path x:Name="SourceIcon" Width="18" Height="18" Margin="6" Stretch="Uniform"
                                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="White" Visibility="Collapsed">
                                                    <Path.Effect>
                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Opacity="0.8" Color="Black" />
                                                    </Path.Effect>
                                                </Path>
                                            </Grid>
                                            <Grid x:Name="Avatar" Width="60" Height="60" HorizontalAlignment="Left" Margin="18,0,0,0" Visibility="Collapsed">
                                                <Ellipse Fill="#FF4A4A4A" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Image, Converter={StaticResource Image}, ConverterParameter=120}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel x:Name="Text" Margin="112,0,16,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="Title" Text="{Binding Title}" Style="{StaticResource GuideText}" FontSize="25"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="68" />
                                                <TextBlock x:Name="Running" Text="Running" Style="{StaticResource GuideText}" FontSize="22"
                                                           Foreground="#B3FFFFFF" Visibility="Collapsed" />
                                                <!-- Audio's volume slider: a track filled to the level, in the accent. -->
                                                <ProgressBar x:Name="Slider" Minimum="0" Maximum="100" Value="{Binding Level, Mode=OneWay}"
                                                             Height="6" Margin="0,12,56,0" Visibility="Collapsed" Focusable="False">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border x:Name="PART_Track" Background="#40FFFFFF" CornerRadius="3" />
                                                                <Border x:Name="PART_Indicator" Background="{DynamicResource GlyphLightBrush}"
                                                                        CornerRadius="3" HorizontalAlignment="Left" />
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                            </StackPanel>
                                            <TextBlock x:Name="LevelText" Text="{Binding Level}" Style="{StaticResource GuideText}" FontSize="24"
                                                       HorizontalAlignment="Right" Margin="0,0,24,0" Visibility="Collapsed" />
                                            <!-- Audio's mute switch: a pill, filled in the accent with its knob to the right when on. -->
                                            <Grid x:Name="Switch" Width="48" Height="24" HorizontalAlignment="Right" Margin="0,0,24,0" Visibility="Collapsed">
                                                <Border x:Name="SwitchTrack" CornerRadius="12" BorderBrush="White" BorderThickness="2" />
                                                <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="6,0" />
                                            </Grid>
                                            <!-- The tiles' ring, 1 px past the entry as theirs is past their art. -->
                                            <Border x:Name="Ring" Margin="-1" BorderThickness="4" CornerRadius="6"
                                                    BorderBrush="{DynamicResource GlyphLightBrush}" Visibility="Collapsed" />
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="Steam">
                                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceSteam}" />
                                            <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="Xbox">
                                            <Setter TargetName="SourceIcon" Property="Data" Value="{StaticResource SourceXbox}" />
                                            <Setter TargetName="SourceIcon" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasDividerAbove}" Value="True">
                                            <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <!-- Segoe Fluent Icons / MDL2 Assets glyphs. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Home">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE80F;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="MyGamesAndApps">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE8F1;" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="RunningGame">
                                            <Setter TargetName="Running" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Entry" Property="Height" Value="96" />
                                            <Setter TargetName="Entry" Property="Margin" Value="9,0,9,12" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="RecentGame">
                                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Entry" Property="Height" Value="96" />
                                            <Setter TargetName="Entry" Property="Margin" Value="9,0,9,12" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Profile">
                                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Avatar" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Entry" Property="Height" Value="138" />
                                            <Setter TargetName="Text" Property="Margin" Value="96,0,16,0" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                            <Setter TargetName="Title" Property="TextWrapping" Value="NoWrap" />
                                        </DataTrigger>
                                        <!-- Settings and Power: smaller rows, the icon further left, as on the console. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Settings">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE713;" />
                                            <Setter TargetName="Entry" Property="Height" Value="75" />
                                            <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                                            <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Power">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7E8;" />
                                            <Setter TargetName="Entry" Property="Height" Value="75" />
                                            <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                                            <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                        </DataTrigger>
                                        <!-- A notification: its text, wrapping, with no icon. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Notification">
                                            <Setter TargetName="Entry" Property="Height" Value="NaN" />
                                            <Setter TargetName="Entry" Property="MinHeight" Value="75" />
                                            <Setter TargetName="Text" Property="Margin" Value="24,14,24,14" />
                                            <Setter TargetName="Title" Property="FontSize" Value="22" />
                                            <Setter TargetName="Title" Property="MaxHeight" Value="120" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Volume">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE767;" />
                                            <Setter TargetName="Entry" Property="Height" Value="96" />
                                            <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                                            <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                            <Setter TargetName="Slider" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="LevelText" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Mute">
                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE74F;" />
                                            <Setter TargetName="Entry" Property="Height" Value="75" />
                                            <Setter TargetName="Glyph" Property="FontSize" Value="26" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="18,0,0,0" />
                                            <Setter TargetName="Text" Property="Margin" Value="69,0,16,0" />
                                            <Setter TargetName="Title" Property="FontSize" Value="24" />
                                            <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource GlyphLightBrush}" />
                                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource GlyphLightBrush}" />
                                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="#26FFFFFF" />
                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
            <!-- The status area, top right, the clock large under the battery, as on the console. Only with the panel: Power on its own has none. -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,62,108,0" Opacity="{Binding Opacity, ElementName=Dim}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsPanel}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <local:StatusArea Stacked="True" DataContext="{Binding Status, RelativeSource={RelativeSource AncestorType=local:OverlayWindow}}" />
            </Grid>
            <!-- Darkens everything behind a menu or prompt, the Guide included. -->
            <Border Background="#B3000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Dialog}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <!-- A menu or prompt over the Guide (Menu on the running game, force quit, "Quit X and start Y?"), centred. It has the pad until answered. -->
            <local:MenuPanel x:Name="DialogPanel" DataContext="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- Power: the console's "What do you want to do?" band across the screen. -->
            <local:WideDialogPanel x:Name="WidePanel" DataContext="{Binding Dialog}" />
        </Grid>
    </Viewbox>
</Window>
