<UserControl x:Class="XboxSeries.Extension.ThemeSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:XboxSeries.Extension"
             Focusable="False" KeyDown="OnPaneKeyDown">
    <!--
        Settings' Theme settings category, as Personalisation: dark boxes two wide, each a line icon and its name alone,
        opening its page in the pane in their place, the header following: Personalisation, Guide and Discord. Which page
        shows is the core's (SettingsState.ThemePage). In Settings' palette and 1080p units (SettingsControl.xaml).
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SettingsBoxes />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UniformGrid Margin="0,20,0,0" Columns="2" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Button x:Name="PersonalisationBox" Style="{StaticResource Box}" Tag="&#xE771;" Click="OnBoxClick">
            <TextBlock Text="Personalisation" Style="{StaticResource Text}" />
        </Button>
        <Button x:Name="GuideBox" Style="{StaticResource Box}" Tag="&#xE7FC;" Click="OnBoxClick">
            <TextBlock Text="Guide" Style="{StaticResource Text}" />
        </Button>
        <Button x:Name="DiscordBox" Style="{StaticResource Box}" Tag="&#xE8F2;" Click="OnBoxClick">
            <TextBlock Text="Discord" Style="{StaticResource Text}" />
        </Button>
    </UniformGrid>
</UserControl>
